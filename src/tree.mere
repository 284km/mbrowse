// Tree construction: a stream of tokens becomes a document.
//
// This is the part that is a browser. The tokenizer is a state machine that can be
// read top to bottom; this is not — it is a set of *insertion modes*, and the same
// token means different things in each. `<p>` in "in body" opens a paragraph;
// `<p>` in "before html" first creates the html and head and body elements nobody
// wrote, and then opens a paragraph.
//
// That is not a quirk of the specification. It is the specification's answer to the
// fact that real pages leave things out, and the modes are how "what was left out"
// is expressed without a rule that says "look ahead and guess".
//
// What is here: the modes on the path every ordinary document takes — initial,
// before html, before head, in head, after head, in body, after body — with the
// implied start tags they insert and the end tags they ignore. What is not: the
// table modes, foreign content, the adoption agency algorithm, and the fragment
// case.
//
// The adoption agency needs something this file cannot currently give it, and the
// reason is worth knowing before starting: **it rewrites the tree**. Given
// `<b><p>X</b>Y`, the `<b>` is closed inside the paragraph and then *reopened*
// around what follows, which means taking nodes that are already placed and moving
// them under a different parent. The representation here closes an element when it
// is popped — `_close` folds a frame into an immutable `Element` — so by the time
// the algorithm would run, the nodes it has to move are no longer reachable as
// anything but a value inside their parent.
//
// So the adoption agency is not more rules on top of these. It is a change to how the
// tree is held while it is being built: nodes that stay addressable after their
// element is closed, plus the list of active formatting elements the algorithm walks.
//
// The first half of that now exists in src/nodes.mere — a flat arena where a node
// remembers its parent by id, so moving a subtree is one field. It is checked against
// this representation rather than trusted: the same document built both ways
// serializes identically.
//
// The second half is src/formatting.mere — the list of active formatting elements,
// with the marker discipline and the Noah's Ark clause, checked on the parts that
// have a defined answer without the algorithm around them.
//
// And "reconstruct the active formatting elements" is there too — the operation that
// makes the list worth keeping, reopening a still-listed but no-longer-open `<b>`
// inside the new block so that `<b><p>X` has one in the paragraph. It is a function
// over the arena, the open stack and the list, checked on that document.
//
// And src/aaa.mere is the algorithm's simple case: the exits that do not have to
// rewrite the tree, plus a furthest block *reported* rather than guessed at, so a
// caller can tell "done" from "not attempted".
//
// The builder is on the arena as of this commit: a frame stack became an arena plus a
// stack of ids, and `_close` is gone — a popped element stays where it is and stays
// addressable. 95 of 189 before and after, which is what a change of representation
// with no change of behaviour is supposed to look like.
//
// What is left:
//
// 1. ~~This builder moves onto the arena.~~ Done. A frame stack becomes an arena plus a
//    stack of ids, and `_close` disappears — a node that is popped stays where it is
//    instead of being folded into its parent. That is the whole change, and it is the
//    one piece of work here whose success looks like *nothing happening*: 95 of 189
//    before and 95 of 189 after, because it is a change of representation and not of
//    behaviour. Doing it alone is what makes that evidence; doing it together with
//    the rewrite would make both unfalsifiable at once.
//
//    The arena has what this needs for it: `Nodes.add_text` joins text to text and
//    `Nodes.last_child` is how it knows, which was the one thing the nested form did
//    on the way in and the arena has to do in place.
//
// 2. ~~The adoption agency's other half.~~ Done, in src/aaa.mere, and checked on
//    `<b>1<p>2</b>` — the clone of the `<b>` becomes the paragraph's child and the
//    text moves into it. Wired in as of the next commit: a formatting element's end
//    tag goes to the algorithm, which says whether it handled the token, and 95 of 189
//    became 102.
//
// The four pieces under both are each checked on their own, which is the point of
// having built them separately: when the rewrite is wrong, what it is standing on
// will not be.

import "mere-html/tokenizer.mere";
import "dom.mere";
import "nodes.mere";
import "aaa.mere";

module Tree {
  // Which tokenizer state an element's content is in. This is the half of the loop
  // the tree builder owns: the tokenizer cannot know, because the answer depends on
  // which element was just opened.
  //
  // It is a pure function of the tag name, and it is here rather than in the
  // tokenizer because it is a fact about elements, not about characters.
  let content_state = fn (name: str) ->
    if name == "title" || name == "textarea" then "RCDATA state"
    else if name == "style" || name == "xmp" || name == "iframe"
            || name == "noembed" || name == "noframes" then "RAWTEXT state"
    else if name == "script" then "Script data state"
    else if name == "plaintext" then "PLAINTEXT state"
    else "Data state";

  let _is_heading = fn (n: str) ->
    n == "h1" || n == "h2" || n == "h3" || n == "h4" || n == "h5" || n == "h6";

  let _same_kind = fn (open_name: str) -> fn (name: str) ->
    if _is_heading name then _is_heading open_name
    else if name == "li" then open_name == "li"
    else if name == "dd" || name == "dt" then open_name == "dd" || open_name == "dt"
    else false;

  let _is_void = fn (n: str) ->
    n == "area" || n == "base" || n == "br" || n == "col" || n == "embed"
    || n == "hr" || n == "img" || n == "input" || n == "link" || n == "meta"
    || n == "param" || n == "source" || n == "track" || n == "wbr";

  let _closes_p = fn (n: str) ->
    n == "address" || n == "article" || n == "aside" || n == "blockquote"
    || n == "div" || n == "dl" || n == "fieldset" || n == "figure"
    || n == "footer" || n == "form" || _is_heading n || n == "header"
    || n == "main" || n == "nav" || n == "ol" || n == "p" || n == "pre"
    || n == "section" || n == "table" || n == "ul" || n == "hr";

  let _is_special = fn (n: str) ->
    n == "address" || n == "applet" || n == "area" || n == "article" || n == "aside"
    || n == "base" || n == "basefont" || n == "bgsound" || n == "blockquote"
    || n == "body" || n == "br" || n == "button" || n == "caption" || n == "center"
    || n == "col" || n == "colgroup" || n == "dd" || n == "details" || n == "dir"
    || n == "div" || n == "dl" || n == "dt" || n == "embed" || n == "fieldset"
    || n == "figcaption" || n == "figure" || n == "footer" || n == "form"
    || n == "frame" || n == "frameset" || _is_heading n || n == "head"
    || n == "header" || n == "hgroup" || n == "hr" || n == "html" || n == "iframe"
    || n == "img" || n == "input" || n == "li" || n == "link" || n == "listing"
    || n == "main" || n == "marquee" || n == "menu" || n == "meta" || n == "nav"
    || n == "noembed" || n == "noframes" || n == "noscript" || n == "object"
    || n == "ol" || n == "p" || n == "param" || n == "plaintext" || n == "pre"
    || n == "script" || n == "section" || n == "select" || n == "source"
    || n == "style" || n == "summary" || n == "table" || n == "tbody" || n == "td"
    || n == "template" || n == "textarea" || n == "tfoot" || n == "th"
    || n == "thead" || n == "title" || n == "tr" || n == "track" || n == "ul"
    || n == "wbr" || n == "xmp";

  let _is_ws = fn (s: str) ->
    let rec go = fn (i: int) ->
      if i >= str_len s then true
      else
        let c = char_at s i in
        if c == " " || c == "\t" || c == "\n" || c == "\r" || c == chr 12
        then go (i + 1) else false in
    go 0;

  // --- the open elements, as ids into the arena ------------------------------
  // A popped element is not folded into anything: it stays in the arena and stays
  // addressable, which is the whole reason for the change.

  let _parent = fn (open_ids: int list) ->
    match open_ids with Cons (x, _) -> x | Nil -> 0;

  let _name_of = fn (arena: anode list) -> fn (id: int) ->
    (Nodes._nth arena id).name;

  let rec _open_has = fn (arena: anode list) -> fn (open_ids: int list) ->
                      fn (name: str) ->
    match open_ids with
    | Nil -> false
    | Cons (x, rest) ->
      if _name_of arena x == name then true else _open_has arena rest name;

  let rec _pop_through = fn (arena: anode list) -> fn (open_ids: int list) ->
                         fn (name: str) ->
    match open_ids with
    | Nil -> Nil
    | Cons (x, rest) ->
      if _name_of arena x == name then rest else _pop_through arena rest name;

  let rec _open_same_kind = fn (arena: anode list) -> fn (open_ids: int list) ->
                            fn (name: str) ->
    match open_ids with
    | Nil -> ""
    | Cons (x, rest) ->
      let n = _name_of arena x in
      if _same_kind n name then n
      else if n == "div" || n == "p" || n == "body" || n == "html" then ""
      else _open_same_kind arena rest name;

  let rec _end_tag_matches = fn (arena: anode list) -> fn (open_ids: int list) ->
                             fn (name: str) ->
    match open_ids with
    | Nil -> false
    | Cons (x, rest) ->
      let n = _name_of arena x in
      if n == name then true
      else if _is_special n then false
      else _end_tag_matches arena rest name;

  // The formatting elements: the ones the adoption agency exists for, because these
  // are what people leave open across a block boundary.
  let _is_formatting = fn (n: str) ->
    n == "a" || n == "b" || n == "big" || n == "code" || n == "em" || n == "font"
    || n == "i" || n == "nobr" || n == "s" || n == "small" || n == "strike"
    || n == "strong" || n == "tt" || n == "u";

  // Entering one of these means formatting must not escape it, so a marker goes on
  // the list and leaving clears back to it.
  let _is_marker_scope = fn (n: str) ->
    n == "applet" || n == "object" || n == "marquee" || n == "td" || n == "th"
    || n == "caption" || n == "template";

  let build = fn (tokens: token list) ->
    let push_el = fn (arena: anode list) -> fn (open_ids: int list) ->
                  fn (name: str) -> fn (attrs: attr list) ->
      let (a, id) = Nodes.element arena (_parent open_ids) name attrs in
      (a, Cons (id, open_ids)) in

    let drop1 = fn (o: int list) -> match o with Cons (_, r) -> r | Nil -> Nil in

    let rec go = fn (ts: token list) -> fn (mode: str) -> fn (arena: anode list) ->
                 fn (open_ids: int list) -> fn (afe: afe list) ->
      match ts with
      | Nil ->
        let (a, _o) = if _open_has arena open_ids "body" then (arena, open_ids)
                      else _open_body (mode == "after head" || mode == "in body"
                                       || mode == "after body") arena open_ids in
        Nodes.to_nodes a
      | Cons (t, rest) ->
        (match t with
        | TDoctype (name, pub, has_pub, sys, has_sys, ok) ->
          if mode != "initial" then go rest mode arena open_ids afe
          else
            let (a, _id) = Nodes.doctype arena (_parent open_ids) name in
            go rest "before html" a open_ids afe
        | TComment data ->
          let (a, _id) = Nodes.comment arena (_parent open_ids) data in
          go rest mode a open_ids afe
        | TChar data ->
          if _is_ws data && mode != "in body" then go rest mode arena open_ids afe
          else if mode == "in body" then
            // Anything inserted into a new block reopens the formatting elements that
            // are listed but no longer open — that is what the list is for.
            let (a0, o0, l0, p0) =
              Reconstruct.run arena open_ids afe (_parent open_ids) in
            let (a, _id) = Nodes.add_text a0 p0 data in
            go rest mode a o0 l0
          else
            let (a, o) = _open_body (mode == "after head" || mode == "after body")
                           arena open_ids in
            go ts "in body" a o afe
        | TStart (name, attrs, selfc) ->
          if mode == "initial" || mode == "before html" then
            if name == "html" then
              let (a, o) = push_el arena open_ids "html" attrs in
              go rest "before head" a o afe
            else
              let (a, o) = push_el arena open_ids "html" Nil in
              go ts "before head" a o afe
          else if mode == "before head" then
            if name == "head" then
              let (a, o) = push_el arena open_ids "head" attrs in
              go rest "in head" a o afe
            else
              let (a, o) = push_el arena open_ids "head" Nil in
              go ts "in head" a o afe
          else if mode == "in head" then
            if name == "title" || name == "style" || name == "script"
               || _is_void name then
              let (a, o) = push_el arena open_ids name attrs in
              go rest mode a (drop1 o) afe
            else go ts "after head" arena (drop1 open_ids) afe
          else if mode == "after head" then
            if name == "body" then
              let (a, o) = push_el arena open_ids "body" attrs in
              go rest "in body" a o afe
            else
              let (a, o) = _open_body true arena open_ids in
              go ts "in body" a o afe
          else
            if _is_void name || selfc then
              let (a, o) = push_el arena open_ids name attrs in
              go rest mode a (drop1 o) afe
            else if _open_same_kind arena open_ids name != "" then
              go ts mode arena
                (_pop_through arena open_ids (_open_same_kind arena open_ids name)) afe
            else if _closes_p name && _open_has arena open_ids "p" then
              go ts mode arena (_pop_through arena open_ids "p") afe
            else
              let (a, o) = push_el arena open_ids name attrs in
              let id = _parent o in
              let l = if _is_formatting name then Formatting.push afe id name attrs
                      else if _is_marker_scope name then Formatting.push_marker afe
                      else afe in
              go rest mode a o l
        | TEnd name ->
          if name == "html" || name == "body" then
            if mode == "in body" then go rest "after body" arena open_ids afe
            else go rest mode arena open_ids afe
          // A formatting element's end tag is the adoption agency's, and it says
          // whether it handled the token: `handled` false means fall through to the
          // ordinary path, which is the standard's "any other end tag".
          else if _is_formatting name then
            let (a, o, l, handled, complex) =
              Aaa.run arena open_ids afe name _is_special in
            if handled then go rest mode a o l
            else if _end_tag_matches arena open_ids name then
              go rest mode arena (_pop_through arena open_ids name) afe
            else go rest mode arena open_ids afe
          else if _end_tag_matches arena open_ids name then
            let o = _pop_through arena open_ids name in
            let l = if _is_marker_scope name then Formatting.clear_to_marker afe
                    else afe in
            go rest (if name == "head" then "after head" else mode) arena o l
          else go rest mode arena open_ids afe)

    and _open_body = fn (head_done: bool) -> fn (arena: anode list) ->
                     fn (open_ids: int list) ->
      if _open_has arena open_ids "body" then (arena, open_ids)
      else
        let (a1, o1) =
          if _open_has arena open_ids "html" then (arena, open_ids)
          else push_el arena open_ids "html" Nil in
        let (a2, o2) =
          if _open_has a1 o1 "head" then (a1, _pop_through a1 o1 "head")
          else if head_done then (a1, o1)
          else
            let (x, y) = push_el a1 o1 "head" Nil in
            (x, drop1 y) in
        push_el a2 o2 "body" Nil
    in
    go tokens "initial" Nodes.empty Nil Nil;
}
