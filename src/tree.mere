// Tree construction: a stream of tokens becomes a document.
//
// This is the part that is a browser. The tokenizer is a state machine that can be
// read top to bottom; this is not — it is a set of *insertion modes*, and the same
// token means different things in each. `<p>` in "in body" opens a paragraph;
// `<p>` in "before html" first creates the html and head and body elements nobody
// wrote, and then opens a paragraph.
//
// That is not a quirk of the specification. It is the specification's answer to the
// fact that real pages leave things out, and the modes are how "what was left out"
// is expressed without a rule that says "look ahead and guess".
//
// What is here: the modes on the path every ordinary document takes — initial,
// before html, before head, in head, after head, in body, after body — with the
// implied start tags they insert and the end tags they ignore. What is not: the
// table modes, foreign content, the adoption agency algorithm, and the fragment
// case.
//
// The adoption agency needs something this file cannot currently give it, and the
// reason is worth knowing before starting: **it rewrites the tree**. Given
// `<b><p>X</b>Y`, the `<b>` is closed inside the paragraph and then *reopened*
// around what follows, which means taking nodes that are already placed and moving
// them under a different parent. The representation here closes an element when it
// is popped — `_close` folds a frame into an immutable `Element` — so by the time
// the algorithm would run, the nodes it has to move are no longer reachable as
// anything but a value inside their parent.
//
// So the adoption agency is not more rules on top of these. It is a change to how
// the tree is held while it is being built: nodes that stay addressable after their
// element is closed, plus the list of active formatting elements the algorithm walks.
// That is the next piece of work, and it is a bigger one than it looks from the
// outside — which is why it is written down here rather than attempted in passing.

import "mere-html/tokenizer.mere";
import "dom.mere";

// The tree is built by appending to the open elements, so it is easier to hold it
// as a stack of (name, attrs, reversed children) and fold it up at the end than to
// rebuild a persistent tree at every step.
type frame = { fname: str, fattrs: attr list, fkids: node list };

module Tree {
  // Which tokenizer state an element's content is in. This is the half of the loop
  // the tree builder owns: the tokenizer cannot know, because the answer depends on
  // which element was just opened, and by the time a token list exists the choice
  // has already been made.
  //
  // It is a pure function of the tag name, and it is here rather than in the
  // tokenizer because it is a fact about elements, not about characters.
  let content_state = fn (name: str) ->
    if name == "title" || name == "textarea" then "RCDATA state"
    else if name == "style" || name == "xmp" || name == "iframe"
            || name == "noembed" || name == "noframes" then "RAWTEXT state"
    else if name == "script" then "Script data state"
    else if name == "plaintext" then "PLAINTEXT state"
    else "Data state";

  let _close = fn (f: frame) -> Element (f.fname, f.fattrs, list_rev f.fkids);

  // Add a finished node to the innermost open element, or to the document when
  // nothing is open.
  // Adjacent text is one node, not two. The tokenizer coalesces the characters it
  // emits in a run, but a run can be interrupted by something that produces no node
  // at all — an ignored end tag, a comment already placed — and the two halves have
  // to join here or the tree has a shape no document describes.
  let _merge = fn (kids: node list) -> fn (n: node) ->
    match (n, kids) with
    | (Text b, Cons (Text a, rest)) -> Cons (Text (a ++ b), rest)
    | _ -> Cons (n, kids);

  let _add = fn (stack: frame list) -> fn (roots: node list) -> fn (n: node) ->
    match stack with
    | Nil -> (stack, _merge roots n)
    | Cons (top, rest) ->
      (Cons (frame { fname = top.fname, fattrs = top.fattrs,
                     fkids = _merge top.fkids n }, rest), roots);

  let _push = fn (stack: frame list) -> fn (name: str) -> fn (attrs: attr list) ->
    Cons (frame { fname = name, fattrs = attrs, fkids = Nil }, stack);

  // Pop one element and give it to its parent.
  let _pop = fn (stack: frame list) -> fn (roots: node list) ->
    match stack with
    | Nil -> (stack, roots)
    | Cons (top, rest) -> _add rest roots (_close top);

  let rec _pop_all = fn (stack: frame list) -> fn (roots: node list) ->
    match stack with
    | Nil -> list_rev roots
    | _ -> let (s, r) = _pop stack roots in _pop_all s r;

  let rec _open_has = fn (stack: frame list) -> fn (name: str) ->
    match stack with
    | Nil -> false
    | Cons (f, rest) -> if f.fname == name then true else _open_has rest name;

  // Pop until `name` has been popped. The standard's "generate implied end tags"
  // and this are the same idea: an unclosed `<li>` is closed by whatever closes
  // around it, not by an error.
  let rec _pop_through = fn (stack: frame list) -> fn (roots: node list) ->
                         fn (name: str) ->
    match stack with
    | Nil -> (stack, roots)
    | Cons (top, _) ->
      let (s, r) = _pop stack roots in
      if top.fname == name then (s, r) else _pop_through s r name;

  // Elements that never have children and are closed by their own start tag.
  let _is_void = fn (n: str) ->
    n == "area" || n == "base" || n == "br" || n == "col" || n == "embed"
    || n == "hr" || n == "img" || n == "input" || n == "link" || n == "meta"
    || n == "param" || n == "source" || n == "track" || n == "wbr";

  let _is_heading = fn (n: str) ->
    n == "h1" || n == "h2" || n == "h3" || n == "h4" || n == "h5" || n == "h6";

  // The elements that close a same-kind open element rather than nesting inside it:
  // a second `<li>` ends the first, `<h2>` ends an open `<h1>`, `<dd>` ends a `<dt>`.
  // Documents rely on this constantly and write neither end tag.
  let _same_kind = fn (open_name: str) -> fn (name: str) ->
    if _is_heading name then _is_heading open_name
    else if name == "li" then open_name == "li"
    else if name == "dd" || name == "dt" then open_name == "dd" || open_name == "dt"
    else false;

  let rec _open_same_kind = fn (stack: frame list) -> fn (name: str) ->
    match stack with
    | Nil -> ""
    | Cons (f, rest) ->
      if _same_kind f.fname name then f.fname
      // A same-kind element only counts while nothing block-level intervenes:
      // `<li><div><li>` is two list items, `<li><div>` alone is not.
      else if f.fname == "div" || f.fname == "p" || f.fname == "body"
              || f.fname == "html" then ""
      else _open_same_kind rest name;

  // The standard's "special" elements. An end tag that does not match the innermost
  // open element walks up looking for its own, and **stops** at one of these: that is
  // why `<span><button>foo</span>bar` leaves the button open and puts bar inside it
  // rather than closing both. Popping through unconditionally is the difference
  // between recovering and guessing.
  let _is_special = fn (n: str) ->
    n == "address" || n == "applet" || n == "area" || n == "article" || n == "aside"
    || n == "base" || n == "basefont" || n == "bgsound" || n == "blockquote"
    || n == "body" || n == "br" || n == "button" || n == "caption" || n == "center"
    || n == "col" || n == "colgroup" || n == "dd" || n == "details" || n == "dir"
    || n == "div" || n == "dl" || n == "dt" || n == "embed" || n == "fieldset"
    || n == "figcaption" || n == "figure" || n == "footer" || n == "form"
    || n == "frame" || n == "frameset" || _is_heading n || n == "head"
    || n == "header" || n == "hgroup" || n == "hr" || n == "html" || n == "iframe"
    || n == "img" || n == "input" || n == "li" || n == "link" || n == "listing"
    || n == "main" || n == "marquee" || n == "menu" || n == "meta" || n == "nav"
    || n == "noembed" || n == "noframes" || n == "noscript" || n == "object"
    || n == "ol" || n == "p" || n == "param" || n == "plaintext" || n == "pre"
    || n == "script" || n == "section" || n == "select" || n == "source"
    || n == "style" || n == "summary" || n == "table" || n == "tbody" || n == "td"
    || n == "template" || n == "textarea" || n == "tfoot" || n == "th"
    || n == "thead" || n == "title" || n == "tr" || n == "track" || n == "ul"
    || n == "wbr" || n == "xmp";

  // Whether an end tag for `name` should close anything: walking up from the
  // innermost element, its own name before any special element.
  let rec _end_tag_matches = fn (stack: frame list) -> fn (name: str) ->
    match stack with
    | Nil -> false
    | Cons (f, rest) ->
      if f.fname == name then true
      else if _is_special f.fname then false
      else _end_tag_matches rest name;

  // A paragraph is closed by anything that starts a new block.
  let _closes_p = fn (n: str) ->
    n == "address" || n == "article" || n == "aside" || n == "blockquote"
    || n == "div" || n == "dl" || n == "fieldset" || n == "figure"
    || n == "footer" || n == "form" || n == "h1" || n == "h2" || n == "h3"
    || n == "h4" || n == "h5" || n == "h6" || n == "header" || n == "hr"
    || n == "main" || n == "nav" || n == "ol" || n == "p" || n == "pre"
    || n == "section" || n == "table" || n == "ul";

  let _is_ws = fn (s: str) ->
    let rec go = fn (i: int) ->
      if i >= str_len s then true
      else
        let c = char_at s i in
        if c == " " || c == "\t" || c == "\n" || c == "\r" || c == chr 12
        then go (i + 1) else false in
    go 0;

  // `mode` is the insertion mode, by the standard's name.
  let build = fn (tokens: token list) ->
    let rec go = fn (ts: token list) -> fn (mode: str) ->
                 fn (stack: frame list) -> fn (roots: node list) ->
      match ts with
      // Even a document that opened nothing has an html, a head and a body.
      | Nil ->
        let (s, r) = if _open_has stack "body" then (stack, roots)
                     else _open_body (mode == "after head" || mode == "in body"
                                      || mode == "after body") stack roots in
        _pop_all s r
      | Cons (t, rest) ->
        (match t with
        | TDoctype (name, pub, has_pub, sys, has_sys, ok) ->
          if mode != "initial" then go rest mode stack roots
          else
            let (s, r) = _add stack roots
              (Doctype (name, if has_pub then pub else "",
                              if has_sys then sys else "")) in
            go rest "before html" s r
        | TComment data ->
          let (s, r) = _add stack roots (Comment data) in go rest mode s r
        | TChar data ->
          // Whitespace before the body is dropped; anything else forces the
          // elements nobody wrote into existence.
          if _is_ws data && mode != "in body" then go rest mode stack roots
          else if mode == "in body" then
            let (s, r) = _add stack roots (Text data) in go rest mode s r
          else
            let (s, r) = _open_body (mode == "after head" || mode == "in body"
                                     || mode == "after body") stack roots in
            go ts "in body" s r
        | TStart (name, attrs, selfc) ->
          if mode == "initial" || mode == "before html" then
            if name == "html" then go rest "before head" (_push stack "html" attrs) roots
            else go ts "before head" (_push stack "html" Nil) roots
          else if mode == "before head" then
            if name == "head" then go rest "in head" (_push stack "head" attrs) roots
            else go ts "in head" (_push stack "head" Nil) roots
          else if mode == "in head" then
            if name == "title" || name == "style" || name == "script"
               || _is_void name then
              let s1 = _push stack name attrs in
              let (s2, r2) = _pop s1 roots in
              go rest mode s2 r2
            else
              let (s, r) = _pop stack roots in
              go ts "after head" s r
          else if mode == "after head" then
            if name == "body" then go rest "in body" (_push stack "body" attrs) roots
            else let (s, r) = _open_body true stack roots in go ts "in body" s r
          else
            // in body
            if _is_void name || selfc then
              let s1 = _push stack name attrs in
              let (s2, r2) = _pop s1 roots in
              go rest mode s2 r2
            else if _open_same_kind stack name != "" then
              let (s, r) = _pop_through stack roots (_open_same_kind stack name) in
              go ts mode s r
            else if _closes_p name && _open_has stack "p" then
              let (s, r) = _pop_through stack roots "p" in
              go ts mode s r
            else go rest mode (_push stack name attrs) roots
        | TEnd name ->
          if name == "html" || name == "body" then
            if mode == "in body" then go rest "after body" stack roots
            else go rest mode stack roots
          else if _end_tag_matches stack name then
            let (s, r) = _pop_through stack roots name in
            // Closing the head is what ends "in head"; without this the next start
            // tag takes the mode's fallback and pops the html element instead.
            go rest (if name == "head" then "after head" else mode) s r
          // An end tag with nothing open to match is ignored, which is what makes
          // a stray `</div>` harmless rather than fatal.
          else go rest mode stack roots)
    // Everything before the body is optional in the source and required in the
    // tree; this is the one place that fills all of it in at once.
    // `head_done` because a closed head is not on the stack: asking the stack
    // whether one exists cannot tell "never created" from "created and finished",
    // and guessing gave documents two of them. The mode knows.
    and _open_body = fn (head_done: bool) -> fn (stack: frame list) -> fn (roots: node list) ->
      if _open_has stack "body" then (stack, roots)
      else
        // The head has to be *closed*, not merely present: it was being left open,
        // so the body became its child instead of its sibling and every document in
        // the suite came out one level too deep.
        let (s1, r1) =
          if _open_has stack "html" then (stack, roots)
          else (_push stack "html" Nil, roots) in
        let (s2, r2) =
          if _open_has s1 "head" then _pop_through s1 r1 "head"
          else if head_done then (s1, r1)
          else _pop (_push s1 "head" Nil) r1 in
        (_push s2 "body" Nil, r2)
    in
    go tokens "initial" Nil Nil;
}
