// Which encoding is this page in, before it can be decoded.
//
// A chicken-and-egg problem the standard answers by cheating carefully: to read
// `<meta charset="...">` you must decode the bytes, and to decode the bytes you
// must read `<meta charset>`. The way out is that the declaration is ASCII, and
// every encoding a page can plausibly be in agrees with ASCII on the bytes that
// spell it — so the first 1024 bytes are scanned as bytes, not as text.
//
// This is a scanner and not the tokenizer, deliberately. It has to run before
// anything is decoded, it may not fail, and it stops after 1024 bytes whether or
// not it is in the middle of something. Reusing the tokenizer here would mean
// giving it a mode in which none of those things are true.

import "mere-encoding/decode.mere";

module Sniff {
  let _lower = fn (c: str) -> if c >= "A" && c <= "Z" then to_lower c else c;

  let _is_space = fn (c: str) ->
    c == " " || c == "\t" || c == "\n" || c == "\r" || c == chr 12;

  // A byte-order mark wins over everything, including a `<meta>` that disagrees:
  // it is what the bytes say about themselves.
  let bom_of = fn (b: bytes) ->
    let at = fn (i: int) -> if i >= bytes_len b then 0 - 1 else bytes_get b i in
    if at 0 == 239 && at 1 == 187 && at 2 == 191 then "UTF-8"
    else if at 0 == 254 && at 1 == 255 then "UTF-16BE"
    else if at 0 == 255 && at 1 == 254 then "UTF-16LE"
    else "";

  // The attributes of a tag, from its text. A scanner rather than the tokenizer,
  // for the reasons at the top of this file — and a small one, because a meta
  // element's attributes are all it has.
  let _attrs_of = fn (tag: str) ->
    let n = str_len tag in
    let at = fn (i: int) -> if i >= n then "" else char_at tag i in
    let rec skip_ws = fn (i: int) -> if i < n && _is_space (at i) then skip_ws (i + 1) else i in
    let rec go = fn (i: int) -> fn (out: (str * str) list) ->
      let i = skip_ws i in
      if i >= n then list_rev out
      else if at i == "/" || at i == ">" then go (i + 1) out
      else
        let rec name_end = fn (k: int) ->
          if k >= n || _is_space (at k) || at k == "=" || at k == "/" || at k == ">"
          then k else name_end (k + 1) in
        let ne = name_end i in
        if ne == i then go (i + 1) out
        else
          let nm = to_lower (substring tag i ne) in
          let e = skip_ws ne in
          if at e != "=" then go e (Cons ((nm, ""), out))
          else
            let v = skip_ws (e + 1) in
            let q = at v in
            if q == "\"" || q == "'" then
              let rec vend = fn (k: int) -> if k >= n || at k == q then k else vend (k + 1) in
              let ve = vend (v + 1) in
              go (ve + 1) (Cons ((nm, substring tag (v + 1) ve), out))
            else
              let rec vend = fn (k: int) ->
                if k >= n || _is_space (at k) || at k == ">" then k else vend (k + 1) in
              let ve = vend v in
              go ve (Cons ((nm, substring tag v ve), out)) in
    go 0 Nil;

  let rec _lookup = fn (xs: (str * str) list) -> fn (want: str) ->
    match xs with
    | Nil -> None
    | Cons ((k, v), rest) -> if k == want then Some v else _lookup rest want;

  // `charset=` inside a Content-Type value, as the standard's "extracting a
  // character encoding from a meta element" reads it.
  let _charset_in = fn (s: str) ->
    let n = str_len s in
    let low = to_lower s in
    let idx = str_index_of low "charset" in
    if idx < 0 then ""
    else
      let rec skip = fn (i: int) ->
        if i < n && _is_space (char_at s i) then skip (i + 1) else i in
      let i = skip (idx + 7) in
      if i >= n || char_at s i != "=" then ""
      else
        let j = skip (i + 1) in
        if j >= n then ""
        else
          let q = char_at s j in
          if q == "\"" || q == "'" then
            let e = str_index_of (substring s (j + 1) n) q in
            if e < 0 then "" else substring s (j + 1) (j + 1 + e)
          else
            let rec upto = fn (k: int) ->
              if k >= n || _is_space (char_at s k) || char_at s k == ";" then k
              else upto (k + 1) in
            substring s j (upto j);

  // What a meta element declares, if anything. Two forms and no third: a `charset`
  // attribute, or a `content` attribute on a meta whose `http-equiv` is
  // Content-Type. Reading `charset=` out of any attribute at all was too willing —
  // `<meta name=x content="charset=foo">` declares nothing.
  let _meta_declares = fn (tag: str) ->
    let attrs = _attrs_of tag in
    match _lookup attrs "charset" with
    | Some v -> v
    | None ->
      match _lookup attrs "http-equiv" with
      | None -> ""
      | Some he ->
        if to_lower he != "content-type" then ""
        else
          match _lookup attrs "content" with
          | None -> ""
          | Some c -> _charset_in c;

  // The prescan: the bytes available, looking only for a meta element that declares
  // an encoding. Comments and other tags are skipped rather than parsed, because at
  // this point there is no document to build.
  //
  // Not the first 1024 bytes. The standard says the prescan **may** be aborted after
  // that many, and reading "may" as "does" loses the declaration on any page whose
  // head starts with a long comment — a licence stub, a build banner, a conditional
  // comment for a browser nobody runs any more. The suite has those cases at 2048,
  // 4096 and 8192 bytes and expects the declaration to be found, which is the
  // evidence for what the number should be. The scan stops at the first declaration
  // it finds, so an ordinary page still costs a few hundred bytes.
  let prescan = fn (src: str) ->
    let n = str_len src in
    let at = fn (i: int) -> if i >= n then "" else char_at src i in
    let rec go = fn (i: int) ->
      if i >= n then ""
      else if at i != "<" then go (i + 1)
      else if at (i + 1) == "!" && at (i + 2) == "-" && at (i + 3) == "-" then
        let rec skip = fn (k: int) ->
          if k + 2 >= n then n
          else if at k == "-" && at (k + 1) == "-" && at (k + 2) == ">" then k + 3
          else skip (k + 1) in
        go (skip (i + 4))
      else
        // The tag's text up to its own ">" — its own, because a quoted attribute
        // value may contain one: `content="text/html; charset=x>"` ends the tag
        // four characters later than it looks. Stopping at the first `>` truncated
        // the tag and lost the declaration that was in it.
        let rec upto = fn (k: int) -> fn (q: str) ->
          if k >= n then k
          else
            let c = at k in
            if q != "" then upto (k + 1) (if c == q then "" else q)
            else if c == "\"" || c == "'" then upto (k + 1) c
            else if c == ">" then k
            else upto (k + 1) "" in
        let e = upto i "" in
        let tag = substring src i (if e >= n then n else e) in
        let name = to_lower (substring tag 1 (if str_len tag >= 6 then 6 else str_len tag)) in
        if name == "meta " || name == "meta\t" || name == "meta\n"
           || name == "meta\r" || name == "meta/" then
          let cs = _meta_declares tag in
          if cs != "" then cs else go (e + 1)
        else go (e + 1) in
    go 0;

  // The encoding to decode with: the mark, then the declaration, then the default.
  // Windows-1252 is the default the standard names for an unlabelled page, and it
  // is not a guess about the content — it is the answer that makes the most pages
  // that exist render as their authors saw them.
  let of_bytes = fn (b: bytes) ->
    let bom = bom_of b in
    if bom != "" then bom
    else
      // A page that declares UTF-16 in ASCII cannot be in UTF-16, so the standard
      // reads that declaration as UTF-8.
      match Encoding.label_of (prescan (str_of_bytes b)) with
      | None -> "windows-1252"
      | Some d ->
        if d == "utf-16le" || d == "utf-16be" then "utf-8" else d;
}
