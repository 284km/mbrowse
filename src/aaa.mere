// The adoption agency algorithm — the simple case.
//
// What it is for: `<b>1<p>2</b>3` has a `</b>` that closes an element opened outside
// the paragraph it is closing inside. No stack discipline can express that, which is
// why HTML has an algorithm here instead of a rule.
//
// The standard's steps split at one question: is there a *special* element open
// between the formatting element and the current node — a "furthest block". If there
// is not, the answer is ordinary: pop up to and including the formatting element and
// forget it. If there is, the tree has to be rewritten around it, with a bookmark and
// a cloned element, and that half is **not here** — `run` reports it rather than
// guessing, so a caller can tell "done" from "not attempted".
//
// The three things this stands on — the arena, the list, reconstruction — are each
// checked on their own, so when this is wrong, what it is standing on will not be.

import "formatting.mere";

module Aaa {
  let rec _in = fn (xs: int list) -> fn (id: int) ->
    match xs with
    | Nil -> false
    | Cons (x, rest) -> if x == id then true else _in rest id;

  let rec _name_of = fn (arena: anode list) -> fn (id: int) ->
    (Nodes._nth arena id).name;

  // Pop the stack until `id` has been popped.
  let rec _pop_through = fn (open_ids: int list) -> fn (id: int) ->
    match open_ids with
    | Nil -> Nil
    | Cons (x, rest) -> if x == id then rest else _pop_through rest id;

  // The furthest block: walking from the current node back toward the formatting
  // element, the special element nearest to it. Nothing before `fmt` is reached means
  // there is none, and that is the simple case.
  let furthest_block = fn (arena: anode list) -> fn (open_ids: int list) ->
                       fn (fmt: int) -> fn (is_special: str -> bool) ->
    let rec go = fn (xs: int list) -> fn (best: int) ->
      match xs with
      | Nil -> 0 - 1
      | Cons (x, rest) ->
        if x == fmt then best
        else go rest (if is_special (_name_of arena x) then x else best) in
    go open_ids (0 - 1);

  // The element immediately below another in the stack — the standard's "below" is
  // toward the bottom, which in a newest-first list is further along.
  let rec _below = fn (open_ids: int list) -> fn (id: int) ->
    match open_ids with
    | Nil -> 0
    | Cons (x, rest) ->
      if x == id then (match rest with Cons (y, _) -> y | Nil -> 0)
      else _below rest id;

  let rec _above = fn (open_ids: int list) -> fn (id: int) -> fn (prev: int) ->
    match open_ids with
    | Nil -> 0 - 1
    | Cons (x, rest) -> if x == id then prev else _above rest id x;

  let rec _remove_from = fn (open_ids: int list) -> fn (id: int) ->
    match open_ids with
    | Nil -> Nil
    | Cons (x, rest) -> if x == id then rest else Cons (x, _remove_from rest id);

  // Put `new_id` where `old_id` was, so that "replace the entry" does not also mean
  // "move it to the end" — the order of this stack is the nesting of the document.
  let rec _replace_in = fn (open_ids: int list) -> fn (old_id: int) -> fn (new_id: int) ->
    match open_ids with
    | Nil -> Nil
    | Cons (x, rest) ->
      if x == old_id then Cons (new_id, rest)
      else Cons (x, _replace_in rest old_id new_id);

  // Insert immediately below `anchor`.
  let rec _insert_below = fn (open_ids: int list) -> fn (anchor: int) -> fn (id: int) ->
    match open_ids with
    | Nil -> Cons (id, Nil)
    | Cons (x, rest) ->
      if x == anchor then Cons (x, Cons (id, rest))
      else Cons (x, _insert_below rest anchor id);

  // The rewrite. The tree is reshaped around the furthest block: everything between
  // it and the formatting element is re-parented into a chain, the block's children
  // move into a clone of the formatting element, and the clone becomes the block's
  // only child. That is why this needed an arena — every step moves a node that is
  // already placed.
  //
  // The inner loop's three rounds are the standard's: after three, an element that is
  // still listed is dropped from the list rather than cloned again, which is what
  // stops a pathological document from cloning without bound.
  let rec rewrite = fn (arena: anode list) -> fn (open_ids: int list) ->
                fn (afe: afe list) -> fn (fmt: int) -> fn (fb: int) ->
    let common = _below open_ids fmt in
    let rec inner = fn (rounds: int) -> fn (node: int) -> fn (last_node: int) ->
                    fn (a: anode list) -> fn (o: int list) -> fn (l: afe list) ->
      let nxt = _below o node in
      if rounds >= 3 || nxt == fmt || nxt == 0 then (a, o, l, last_node)
      else if not (Formatting.has l nxt) then
        inner (rounds + 1) nxt last_node a (_remove_from o nxt) l
      else
        let (a2, cl) = Nodes.clone a nxt (Nodes._nth a nxt).parent in
        let l2 = Formatting.push (Formatting.remove l nxt) cl
                   (Nodes._nth a nxt).name (Nodes._nth a nxt).attrs in
        let o2 = _replace_in o nxt cl in
        let a3 = Nodes.reparent a2 last_node cl in
        inner (rounds + 1) cl cl a3 o2 l2 in
    let (a1, o1, l1, last_node) = inner 0 fb fb arena open_ids afe in
    let a2 = Nodes.reparent a1 last_node common in
    // The formatting element's clone takes the block's children and becomes its child.
    let (a3, fclone) = Nodes.clone a2 fmt fb in
    let a4 = Nodes.move_children a3 fb fclone in
    let a5 = Nodes.reparent a4 fclone fb in
    let l2 = Formatting.push (Formatting.remove l1 fmt) fclone
               (Nodes._nth a2 fmt).name (Nodes._nth a2 fmt).attrs in
    let o2 = _insert_below (_remove_from o1 fmt) fb fclone in
    (a5, o2, l2, true, false)

  // `handled` is false only when the caller must fall through to its own "any other
  // end tag" handling, which is what the standard says to do when the subject is not
  // a formatting element that is still listed.
  and run = fn (arena: anode list) -> fn (open_ids: int list) -> fn (afe: afe list) ->
            fn (subject: str) -> fn (is_special: str -> bool) ->
    // Step 1: the current node is the subject and was never a formatting element.
    match open_ids with
    | Cons (cur, rest) ->
      if _name_of arena cur == subject && not (Formatting.has afe cur) then
        (arena, rest, afe, true, false)
      else
        let fmt = Formatting.find afe subject in
        if fmt < 0 then (arena, open_ids, afe, false, false)
        // Listed but not open: the list is stale, so correct the list and stop.
        else if not (_in open_ids fmt) then
          (arena, open_ids, Formatting.remove afe fmt, true, false)
        else
          let fb = furthest_block arena open_ids fmt is_special in
          if fb < 0 then
            // The simple case: nothing special intervenes, so this is an ordinary
            // close that happens to have been recorded.
            (arena, _pop_through open_ids fmt, Formatting.remove afe fmt, true, false)
          else rewrite arena open_ids afe fmt fb
    | Nil -> (arena, open_ids, afe, false, false);
}
