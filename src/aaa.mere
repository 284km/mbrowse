// The adoption agency algorithm — the simple case.
//
// What it is for: `<b>1<p>2</b>3` has a `</b>` that closes an element opened outside
// the paragraph it is closing inside. No stack discipline can express that, which is
// why HTML has an algorithm here instead of a rule.
//
// The standard's steps split at one question: is there a *special* element open
// between the formatting element and the current node — a "furthest block". If there
// is not, the answer is ordinary: pop up to and including the formatting element and
// forget it. If there is, the tree is rewritten around it, with a bookmark and a cloned
// element, and that half is here now.
//
// The outer loop runs up to eight times and is load-bearing. `<font><p>hello<b>cruel</font>world`
// needs exactly two passes: the first rewrites around the paragraph, the second finds the
// CLONE the first one made, finds no block inside it, and pops it along with the `<b>` above
// — which is what leaves that `<b>` to be reopened for the text after the tag. The suite's own
// error log for the case says `adoption-agency-1.3` twice, and that is the pass count.
//
// The bookmark is a POSITION, not an id: the entry it marks is the one about to be removed.
//
// Two boundaries, not one. `is_special` is where the walk that looks for a furthest block
// stops. `scope_stop` is where "is this element in scope" stops, and it is a much shorter
// list — a `<table>` bounds scope and does not stop the walk. Both are passed in, because
// collapsing them makes `<font><table></font>` rewrite the inside of the table instead of
// ignoring the token, and the same collapse has now been the bug four times in this parser.
//
// The three things this stands on — the arena, the list, reconstruction — are each
// checked on their own, so when this is wrong, what it is standing on will not be.

import "formatting.mere";

module Aaa {
  let rec _in = fn (xs: int list) -> fn (id: int) ->
    match xs with
    | Nil -> false
    | Cons (x, rest) -> if x == id then true else _in rest id;

  let rec _name_of = fn (arena: anode list) -> fn (id: int) ->
    (Nodes._nth arena id).name;

  // Pop the stack until `id` has been popped.
  let rec _pop_through = fn (open_ids: int list) -> fn (id: int) ->
    match open_ids with
    | Nil -> Nil
    | Cons (x, rest) -> if x == id then rest else _pop_through rest id;

  // Whether the formatting element is in SCOPE — a different list from the special
  // category, and the fourth time in this parser that two boundaries wanted one name. A
  // `<table>` bounds scope; it does not stop the walk that finds a furthest block. So
  // `<font><table></font></table></font>` ignores the first `</font>` outright rather than
  // rewriting anything inside the table, and the font closes at the second one, when the
  // table is gone and it is the current node.
  let rec _in_scope = fn (arena: anode list) -> fn (open_ids: int list) ->
                      fn (fmt: int) -> fn (scope_stop: str -> bool) ->
    match open_ids with
    | Nil -> false
    | Cons (x, rest) ->
      if x == fmt then true
      else if scope_stop (_name_of arena x) then false
      else _in_scope arena rest fmt scope_stop;

  // The furthest block: walking from the current node back toward the formatting
  // element, the special element nearest to it. Nothing before `fmt` is reached means
  // there is none, and that is the simple case.
  let furthest_block = fn (arena: anode list) -> fn (open_ids: int list) ->
                       fn (fmt: int) -> fn (is_special: str -> bool) ->
    let rec go = fn (xs: int list) -> fn (best: int) ->
      match xs with
      | Nil -> 0 - 1
      | Cons (x, rest) ->
        if x == fmt then best
        else go rest (if is_special (_name_of arena x) then x else best) in
    go open_ids (0 - 1);

  // The element immediately below another in the stack — the standard's "below" is
  // toward the bottom, which in a newest-first list is further along.
  let rec _below = fn (open_ids: int list) -> fn (id: int) ->
    match open_ids with
    | Nil -> 0
    | Cons (x, rest) ->
      if x == id then (match rest with Cons (y, _) -> y | Nil -> 0)
      else _below rest id;

  let rec _above = fn (open_ids: int list) -> fn (id: int) -> fn (prev: int) ->
    match open_ids with
    | Nil -> 0 - 1
    | Cons (x, rest) -> if x == id then prev else _above rest id x;

  let rec _remove_from = fn (open_ids: int list) -> fn (id: int) ->
    match open_ids with
    | Nil -> Nil
    | Cons (x, rest) -> if x == id then rest else Cons (x, _remove_from rest id);

  // Put `new_id` where `old_id` was, so that "replace the entry" does not also mean
  // "move it to the end" — the order of this stack is the nesting of the document.
  let rec _replace_in = fn (open_ids: int list) -> fn (old_id: int) -> fn (new_id: int) ->
    match open_ids with
    | Nil -> Nil
    | Cons (x, rest) ->
      if x == old_id then Cons (new_id, rest)
      else Cons (x, _replace_in rest old_id new_id);

  // Insert immediately NEWER than `anchor` — which the standard calls "immediately below",
  // because its stack grows downward: its "above" is toward the html element. In this
  // newest-first list that is immediately before the anchor. Getting the direction wrong put
  // the clone on the far side of the furthest block, so the next pass of the outer loop found
  // the same block again and rewrote for ever instead of finishing.
  let rec _insert_newer = fn (open_ids: int list) -> fn (anchor: int) -> fn (id: int) ->
    match open_ids with
    | Nil -> Cons (id, Nil)
    | Cons (x, rest) ->
      if x == anchor then Cons (id, Cons (x, rest))
      else Cons (x, _insert_newer rest anchor id);

  // The rewrite. The tree is reshaped around the furthest block: everything between
  // it and the formatting element is re-parented into a chain, the block's children
  // move into a clone of the formatting element, and the clone becomes the block's
  // only child. That is why this needed an arena — every step moves a node that is
  // already placed.
  //
  // The inner loop's three rounds are the standard's: after three, an element that is
  // still listed is dropped from the list rather than cloned again, which is what
  // stops a pathological document from cloning without bound.
  let rec rewrite = fn (arena: anode list) -> fn (open_ids: int list) ->
                fn (afe: afe list) -> fn (fmt: int) -> fn (fb: int) ->
    let common = _below open_ids fmt in
    // The bookmark is a POSITION and not an id, because the entry it marks is the one about
    // to be removed. Keeping an id would mean looking for something that is no longer there.
    let rec inner = fn (rounds: int) -> fn (node: int) -> fn (last_node: int) ->
                    fn (a: anode list) -> fn (o: int list) -> fn (l: afe list) ->
                    fn (bm: int) ->
      let nxt = _below o node in
      if nxt == fmt || nxt == 0 then (a, o, l, last_node, bm)
      else
        // After three rounds, an element that is still listed is dropped from the list
        // rather than cloned again — the standard's own bound on how much a pathological
        // document can make this grow. It is a bound on CLONING, not on the loop: the loop
        // runs until it reaches the formatting element, however far that is.
        let l0 = if rounds > 3 then Formatting.remove l nxt else l in
        if not (Formatting.has l0 nxt) then
          // Off the stack, and the walk carries on from where it already was — walking from
          // the element just removed would look for something that is no longer there, which
          // ended the loop after one step and hid every case past it.
          inner (rounds + 1) node last_node a (_remove_from o nxt) l0 bm
        else
          let nm = (Nodes._nth a nxt).name in
          let at = (Nodes._nth a nxt).attrs in
          let (a2, cl) = Nodes.clone a nxt (Nodes._nth a nxt).parent in
          let l2 = Formatting.replace l0 nxt cl nm at in
          let o2 = _replace_in o nxt cl in
          let a3 = Nodes.reparent a2 last_node cl in
          let bm2 = if last_node == fb then Formatting.index_of l2 cl else bm in
          inner (rounds + 1) cl cl a3 o2 l2 bm2 in
    let (a1, o1, l1, last_node, bm) =
      inner 0 fb fb arena open_ids afe (Formatting.index_of afe fmt) in
    let a2 = Nodes.reparent a1 last_node common in
    // The formatting element's clone takes the block's children and becomes its child.
    let (a3, fclone) = Nodes.clone a2 fmt fb in
    let a4 = Nodes.move_children a3 fb fclone in
    let a5 = Nodes.reparent a4 fclone fb in
    // At the bookmark, not at the newest end: the clone stands where the element it replaces
    // stood, or where the inner loop moved the mark to.
    let l2 = Formatting.insert_at (Formatting.remove l1 fmt) bm fclone
               (Nodes._nth a2 fmt).name (Nodes._nth a2 fmt).attrs in
    let o2 = _insert_newer (_remove_from o1 fmt) fb fclone in
    (a5, o2, l2, true, false)

  // `handled` is false only when the caller must fall through to its own "any other
  // end tag" handling, which is what the standard says to do when the subject is not
  // a formatting element that is still listed.
  and run = fn (arena: anode list) -> fn (open_ids: int list) -> fn (afe: afe list) ->
            fn (subject: str) -> fn (is_special: str -> bool) ->
            fn (scope_stop: str -> bool) ->
    // Step 1, once and outside the loop: the current node is the subject and was never a
    // formatting element, so this is an ordinary close that only looks like agency work.
    match open_ids with
    | Nil -> (arena, open_ids, afe, false, false)
    | Cons (cur, rest) ->
      if _name_of arena cur == subject && not (Formatting.has afe cur) then
        (arena, rest, afe, true, false)
      else
        // The outer loop, up to eight times, and it is not decoration.
        // `<font><p>hello<b>cruel</font>world` needs exactly two passes: the first rewrites
        // around the paragraph, and the second finds the CLONE it just made, finds no block
        // inside it, and pops it along with the `<b>` above it — which is what leaves the
        // `<b>` to be reopened for the text that follows. The suite's own error log for that
        // case says `adoption-agency-1.3` twice, and that is the count.
        //
        // `did` is what `handled` reports: after a pass has changed something the caller must
        // not also run its ordinary end-tag path, even if the next pass finds nothing left.
        let rec outer = fn (rounds: int) -> fn (a: anode list) -> fn (o: int list) ->
                        fn (l: afe list) -> fn (did: bool) ->
          if rounds >= 8 then (a, o, l, true, false)
          else
            let fmt = Formatting.find l subject in
            if fmt < 0 then (a, o, l, did, false)
            // Listed but not open: the list is stale, so correct the list and stop.
            else if not (_in o fmt) then (a, o, Formatting.remove l fmt, true, false)
            // Open but out of scope: the token is consumed and NOTHING happens. Reported as
            // handled, because handled means the caller must not fall through to the ordinary
            // end-tag path — not that the tree changed.
            else if not (_in_scope a o fmt scope_stop) then (a, o, l, true, false)
            else
              let fb = furthest_block a o fmt is_special in
              if fb < 0 then
                // Nothing special intervenes, so this is an ordinary close that happens to
                // have been recorded. The standard returns here rather than looping.
                (a, _pop_through o fmt, Formatting.remove l fmt, true, false)
              else
                let (a2, o2, l2, _h, _c) = rewrite a o l fmt fb in
                outer (rounds + 1) a2 o2 l2 true in
        outer 0 arena open_ids afe false;
}
