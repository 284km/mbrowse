// A document tree whose nodes stay addressable after their element is closed.
//
// src/dom.mere holds a tree as nested values, which is the right shape for a
// finished document and the wrong one for building it: the adoption agency algorithm
// takes nodes that are already placed and moves them under a different parent, and a
// node folded into its parent's value cannot be moved.
//
// So nodes live in a flat arena and remember their parent by id. "Move this subtree
// under that element" becomes one field, and nothing else in the tree has to change
// — which is the property the algorithm needs and the only reason this exists.
//
// The order children come out in is insertion order, which for a parser is document
// order, so no sibling links are needed.

import "dom.mere";

// `order` is what puts children in document order. It was the id — insertion order —
// until foster parenting needed a node placed *before* one that already existed, which
// id order cannot express: ids are handed out in sequence and everything already refers
// to them. A separate order can have a value put between two others.
//
// kind: 0 element, 1 text, 2 comment, 3 doctype.
type anode = { kind: int, name: str, attrs: attr list, text: str, parent: int,
               order: float };

module Nodes {
  let empty = Cons (anode { kind = 0, name = "#document", attrs = Nil, text = "",
                            parent = 0 - 1, order = 0.0 }, Nil);

  let rec _nth = fn (xs: anode list) -> fn (i: int) ->
    match xs with
    | Nil -> anode { kind = 0, name = "?", attrs = Nil, text = "",
                     parent = 0 - 1, order = 0.0 }
    | Cons (x, rest) -> if i <= 0 then x else _nth rest (i - 1);

  let count = fn (a: anode list) -> len a;

  let _mk = fn (kind: int) -> fn (name: str) -> fn (attrs: attr list) ->
            fn (txt: str) -> fn (parent: int) -> fn (order: float) ->
    anode { kind = kind, name = name, attrs = attrs, text = txt,
            parent = parent, order = order };

  // Appending puts the new node last and gives it an order to match, so a document
  // built only by appending has order and id agreeing everywhere.
  let add = fn (a: anode list) -> fn (n: anode) -> (list_append a (Cons (n, Nil)), len a);

  let element = fn (a: anode list) -> fn (parent: int) -> fn (name: str) ->
                fn (attrs: attr list) ->
    add a (_mk 0 name attrs "" parent (float_of_int (len a)));

  let text = fn (a: anode list) -> fn (parent: int) -> fn (s: str) ->
    add a (_mk 1 "" Nil s parent (float_of_int (len a)));

  let comment = fn (a: anode list) -> fn (parent: int) -> fn (s: str) ->
    add a (_mk 2 "" Nil s parent (float_of_int (len a)));

  let doctype = fn (a: anode list) -> fn (parent: int) -> fn (s: str) ->
    add a (_mk 3 s Nil "" parent (float_of_int (len a)));

  // An element in a namespace. The suite's tree format writes one as `<svg path>` and
  // `<math mi>`, so the namespace lives in the name: nothing else has to know about it
  // — not the node type, not the serializer, not the comparison.
  //
  // The consequence, and it is the reason this is a separate function rather than a
  // parameter on `element`: code that asks an element its name gets `svg path` back.
  // Anything matching on tag names has to say which namespace it means, which is what
  // the standard requires anyway — `<title>` inside SVG is not the HTML `<title>`.
  let element_ns = fn (a: anode list) -> fn (parent: int) -> fn (ns: str) ->
                   fn (name: str) -> fn (attrs: attr list) ->
    element a parent (if ns == "" then name else ns ++ " " ++ name) attrs;

  // The namespace an element is in, or "" for HTML — the name read back.
  let ns_of = fn (a: anode list) -> fn (id: int) ->
    let n = (_nth a id).name in
    let i = str_index_of n " " in
    if i < 0 then "" else substring n 0 i;

  let local_of = fn (a: anode list) -> fn (id: int) ->
    let n = (_nth a id).name in
    let i = str_index_of n " " in
    if i < 0 then n else substring n (i + 1) (str_len n);

  // The one operation the nested representation cannot do.
  let reparent = fn (a: anode list) -> fn (id: int) -> fn (new_parent: int) ->
    let rec go = fn (xs: anode list) -> fn (i: int) -> fn (out: anode list) ->
      match xs with
      | Nil -> list_rev out
      | Cons (x, rest) ->
        let y = if i == id then _mk x.kind x.name x.attrs x.text new_parent x.order
                else x in
        go rest (i + 1) (Cons (y, out)) in
    go a 0 Nil;

  // Attributes an element does not have yet, added to it. A repeated `<html>` or `<body>`
  // tag is not a second element — the standard puts its new attributes on the one that is
  // already there and drops the ones it already has, so `<body t1=1><body t2=2>` is one
  // body with two attributes.
  let merge_attrs = fn (a: anode list) -> fn (id: int) -> fn (extra: attr list) ->
    let rec has = fn (xs: attr list) -> fn (nm: str) ->
      match xs with
      | Nil -> false
      | Cons (x, rest) -> x.name == nm || has rest nm in
    let rec add_new = fn (cur: attr list) -> fn (xs: attr list) ->
      match xs with
      | Nil -> cur
      | Cons (x, rest) ->
        add_new (if has cur x.name then cur else list_append cur (Cons (x, Nil))) rest in
    let rec go = fn (xs: anode list) -> fn (i: int) -> fn (out: anode list) ->
      match xs with
      | Nil -> list_rev out
      | Cons (x, rest) ->
        let y = if i == id then _mk x.kind x.name (add_new x.attrs extra) x.text x.parent x.order
                else x in
        go rest (i + 1) (Cons (y, out)) in
    go a 0 Nil;

  // By order, not by id. The two agree for everything appended and disagree exactly
  // where something was put before something else, which is the point — and there is
  // one of these rather than two, because two answers to the same question is how a
  // node ends up in a different place depending on who asked.
  let children_of = fn (a: anode list) -> fn (parent: int) ->
    let n = len a in
    let rec ins = fn (id: int) -> fn (xs: int list) ->
      match xs with
      | Nil -> Cons (id, Nil)
      | Cons (y, rest) ->
        if (_nth a id).order < (_nth a y).order then Cons (id, Cons (y, rest))
        else Cons (y, ins id rest) in
    let rec go = fn (i: int) -> fn (out: int list) ->
      if i >= n then out
      else go (i + 1) (if (_nth a i).parent == parent then ins i out else out) in
    go 0 Nil;

  let last_child = fn (a: anode list) -> fn (parent: int) ->
    let rec go = fn (xs: int list) -> fn (best: int) ->
      match xs with Nil -> best | Cons (x, rest) -> go rest x in
    go (children_of a parent) (0 - 1);

  let is_text = fn (a: anode list) -> fn (id: int) ->
    if id < 0 then false else (_nth a id).kind == 1;

  let append_text = fn (a: anode list) -> fn (id: int) -> fn (s: str) ->
    let rec go = fn (xs: anode list) -> fn (i: int) -> fn (out: anode list) ->
      match xs with
      | Nil -> list_rev out
      | Cons (x, rest) ->
        let y = if i == id then _mk x.kind x.name x.attrs (x.text ++ s) x.parent x.order
                else x in
        go rest (i + 1) (Cons (y, out)) in
    go a 0 Nil;

  // Adjacent text is one node, so inserting text next to text extends it. The nested
  // form did this on the way in; an arena does it in place.
  let add_text = fn (a: anode list) -> fn (parent: int) -> fn (s: str) ->
    let l = last_child a parent in
    if is_text a l then (append_text a l s, l) else text a parent s;

  // A node placed immediately before an existing one, under the same parent. The order
  // taken is halfway between the target's and its predecessor's — foster parenting puts
  // content *before* the table it was found inside, and there is no id between two
  // consecutive ids.
  let insert_before = fn (a: anode list) -> fn (target: int) -> fn (kind: int) ->
                      fn (name: str) -> fn (attrs: attr list) -> fn (txt: str) ->
    let t = _nth a target in
    let rec prev_of = fn (xs: int list) -> fn (best: float) ->
      match xs with
      | Nil -> best
      | Cons (x, rest) ->
        let o = (_nth a x).order in
        if o < t.order && o > best then prev_of rest o else prev_of rest best in
    let before = prev_of (children_of a t.parent) (t.order - 2.0) in
    add a (_mk kind name attrs txt t.parent ((before + t.order) / 2.0));

  let move_children = fn (a: anode list) -> fn (from: int) -> fn (to_: int) ->
    let rec go = fn (ids: int list) -> fn (acc: anode list) ->
      match ids with
      | Nil -> acc
      | Cons (id, rest) -> go rest (reparent acc id to_) in
    go (children_of a from) a;

  // A copy of an element under a new parent: same name, same attributes, no children.
  // The algorithm clones rather than moves because the original is still in the tree and
  // still referred to by the list of active formatting elements.
  let clone = fn (a: anode list) -> fn (id: int) -> fn (parent: int) ->
    let x = _nth a id in
    element a parent x.name x.attrs;

  // Back to the nested form, which is what the conformance harness compares. Through
  // children_of, so document order is decided in one place.
  let rec _kids_of = fn (a: anode list) -> fn (parent: int) ->
    let rec go = fn (ids: int list) -> fn (out: node list) ->
      match ids with
      | Nil -> list_rev out
      | Cons (i, rest) ->
        let x = _nth a i in
        let nd =
          if x.kind == 1 then Text x.text
          else if x.kind == 2 then Comment x.text
          else if x.kind == 3 then Doctype (x.name, "", "")
          else Element (x.name, x.attrs, _kids_of a i) in
        go rest (Cons (nd, out)) in
    go (children_of a parent) Nil;

  let to_nodes = fn (a: anode list) -> _kids_of a 0;
  let serialize = fn (a: anode list) -> Dom.serialize (to_nodes a);
}
