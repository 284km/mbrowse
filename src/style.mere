// Style resolution: a DOM element and its ancestors in, the values layout needs out.
//
// Three things happen here and they are worth keeping apart, because each has its own way of
// being wrong: the UA stylesheet says what an element is when nobody said otherwise, the
// selectors say which rules reach it, and the cascade says which of the reaching rules wins.
//
// The property set is the one **block layout** needs and no more: display, width, height, and
// the four sides of margin, padding and border. That set was not chosen — it was counted. The
// 126 documents in `test/data/layout` use width 83 times, height 82, border 59, and the margins
// and paddings a few dozen times between them; `position`, `float` and `overflow` are the next
// three and each is a layout mode rather than a value, so they wait for their own slice.

import "dom.mere";
import "css_rules.mere";

// Everything layout asks about an element. Lengths are already resolved to whole pixels except
// where a length cannot be resolved without knowing the containing block, which is what `-1`
// means for width and height: auto.
type sty = {
  display: str, position: str, float_: str, spacing: int, overflow: str,
  // Where an atomic inline-level box sits on its line. Only a layout question for the boxes that
  // are ON a line at all, which is why it lives beside `display` and not beside the box model.
  valign: str,
  // Whether `width` and `height` state the CONTENT box or the BORDER box. One property that changes
  // what two others mean, which is why it is a field and not a special case at the one call site.
  bsz: str,
  // ---- the INHERITED properties, as computed values -------------------------------------------
  //
  // Inheritance is a property of the tree walk and not of an element, so these are resolved by
  // handing each element its PARENT's computed style. Every one of them used to be asked for by name
  // instead, one property at a time, by walking back up the ancestor chain and matching selectors at
  // every level of it — which answered correctly and cost the depth of the tree per question.
  //
  // `line-height` and `text-indent` each inherit in TWO forms, and which one it is has to survive the
  // inheriting. A bare number inherits as the number and is multiplied by each element's own font
  // size; a length inherits as the length it computed to in the element that declared it. Same for a
  // percentage text-indent against a length one. Collapsing either pair to a single number loses the
  // distinction exactly where a child has a different font size from its parent, which is the only
  // case where anyone would notice.
  fs: int,                             // font-size in px
  // Both -1 means `normal`. NEGATIVE is the absent marker for each, and it has to be: zero is a legal
  // line height and using it to mean "not set" made `line-height: 0` read as `normal`. A sentinel
  // inside its value's own range is not a sentinel — met twice now, once here and once in `px_of`.
  lh_px: int, lh_num: float,
  dir: str,
  ws: str,
  ti_px: int, ti_pct: int,             // ti_pct is -1 unless the value was a percentage
  left: int, top: int,                 // -1 when the property said nothing
  w: int, h: int,                      // -1 for auto
  w_pct: int, h_pct: int,              // -1 when not a percentage
  mt: int, mr: int, mb: int, ml: int,
  pt: int, pr: int, pb: int, pl: int,
  bt: int, br: int, bb: int, bl: int
};

// A tag, an id and a class — and ONE type serves both a selector's compound and an element,
// because they are the same three fields asked in two directions. A selector's empty field means
// "anything"; an element's empty field means "none". Two record types with the same fields is
// also something this language will not resolve, which is how the shared shape got noticed.
//
// Three fields rather than a list of classes because no selector in the corpus has two classes,
// and a list would be a general answer to a question nobody has asked yet.
// `sty_attr` is the element's own `style=` text, and it is here so that an ANCESTOR can be resolved.
// Inheritance is walked up this chain rather than threaded down as a computed value, and a chain whose
// links do not carry their inline styles cannot answer what `direction` an ancestor set.
// A selector's compound leaves it empty: a selector never has one.
// `pres` is the element's PRESENTATIONAL ATTRIBUTES already written as CSS — `<table border="">`
// becomes `border: 1px solid`. HTML says what each of them means in terms of properties, and saying it
// once here is the whole of that layer: the cascade below never has to know an attribute from a
// declaration. A selector's `pres` is empty, because a selector is not an element.
type elem = { tag: str, id: str, cls: str, sty_attr: str, pres: str };

// A selector is a chain of compounds with combinators between them, newest last. `child` says
// whether the step before it must be the direct parent.
type step = { s: elem, child: bool };


// A declaration that reached an element, with what it took to reach it.
type hit = { prop: str, value: str, spec: int, order: int };

// A stylesheet, flattened to (selector chain, specificity, declarations). Done once per
// document rather than per element: the UA sheet is parsed on every call otherwise, and note
// 166's lesson is that a per-element cost is the one that turns into a square.
type prepared = { steps: step list, spec: int, decls: rule list };

module Style {
  // The part of the standard's suggested rendering that block geometry can see. Written as CSS
  // and parsed by the same parser everything else goes through, rather than as a table of
  // constants: a table would be a second place where "what a `<p>` is" is written down, and the
  // two would drift. The numbers here are in the expectations of all 126 documents — the 8px on
  // body and the 1em on a paragraph are why every box in them starts where it does.
  // Every `{` here is escaped as `\{`: a brace opens a string interpolation in this language, so
  // an unescaped stylesheet is a program that tries to evaluate `display: block`.
  let ua_sheet =
    "html, body, div, p, blockquote, figure, figcaption, ol, ul, li, dl, dd, dt,"
    ++ " h1, h2, h3, h4, h5, h6, pre, address, article, aside, footer, header,"
    ++ " hgroup, main, nav, section, form, fieldset, legend, hr, center,"
    ++ " dir, menu, details, summary, listing, plaintext, xmp, marquee, optgroup,"
    ++ " option, frameset, frame, noframes \{ display: block }\n"
    ++ "head, style, script, meta, link, title, base \{ display: none }\n"
    ++ "body \{ margin: 8px }\n"
    ++ "p, blockquote, figure, dl, dd, ol, ul, dir, menu \{ margin-top: 1em; margin-bottom: 1em }\n"
    ++ "pre, xmp, plaintext, listing \{ margin-top: 1em; margin-bottom: 1em }\n"
    ++ "h1 \{ margin-top: 0.67em; margin-bottom: 0.67em }\n"
    ++ "h2 \{ margin-top: 0.83em; margin-bottom: 0.83em }\n"
    ++ "h3 \{ margin-top: 1em; margin-bottom: 1em }\n"
    ++ "h4 \{ margin-top: 1.33em; margin-bottom: 1.33em }\n"
    ++ "h5 \{ margin-top: 1.67em; margin-bottom: 1.67em }\n"
    ++ "h6 \{ margin-top: 2.33em; margin-bottom: 2.33em }\n"
    ++ "ol, ul, dir, menu \{ padding-left: 40px }\n"
    ++ "blockquote, figure \{ margin-left: 40px; margin-right: 40px }\n"
    // The table families. `display` is what tells layout to run a different algorithm, and the two
    // lengths here are in every table in the corpus: the browser insets each cell by the spacing and
    // gives it a pixel of padding, which is why a cell is two pixels wider and two taller than its text.
    ++ "table \{ display: table; border-spacing: 2px }\n"
    ++ "tbody, thead, tfoot \{ display: table-row-group }\n"
    ++ "tr \{ display: table-row }\n"
    ++ "td, th \{ display: table-cell; padding: 1px }\n"
    ++ "caption \{ display: table-caption }\n"
    ++ "colgroup \{ display: table-column-group }\n"
    ++ "col \{ display: table-column }\n";

  // The font size everything `em` is relative to. One number, because `font-size` is not
  // resolved yet: an em here is always the initial size. When font-size lands this becomes the
  // computed value of the parent and this constant goes away.
  let root_em = 16;

  // ---- lengths ------------------------------------------------------------------

  let _is_digit = fn (c: str) -> c != "" && c >= "0" && c <= "9";

  // A CSS length in whole pixels, rounded the way the oracle rounds: to nearest. `em` uses the
  // one font size there is. A percentage is NOT resolved here — it needs the containing block,
  // which style resolution does not have, so it comes back as `-2` and layout asks again.
  // The `em` size is a THUNK and not a number. Resolving it means walking the element's ancestor chain
  // and matching selectors at every level, and almost no value in a stylesheet is written in `em` — so
  // the walk happens only where the unit actually appears, which is the difference between paying for
  // it once per document and paying for it on every property of every element.
  let px_at = fn (emf: (int -> int)) -> fn (s0: str) ->
    let s = to_lower s0 in
    let n = str_len s in
    if s == "auto" then 0 - 1
    else if str_index_of s "%" >= 0 then 0 - 2
    else
      // The number, then the unit. Written by hand rather than with the tokenizer because a
      // declaration's value is already a component value list by the time it gets here and this
      // is the last mile of one token.
      let rec num_end = fn (i: int) ->
        if i < n && (_is_digit (char_at s i) || char_at s i == "."
                     || char_at s i == "-" || char_at s i == "+")
        then num_end (i + 1) else i in
      let e = num_end 0 in
      if e == 0 then 0
      else
        let mag = float_of_str (substring s 0 e) in
        let unit = substring s e n in
        let scale =
          if unit == "em" then float_of_int (emf 0)
          else if unit == "rem" then float_of_int root_em
          else if unit == "px" || unit == "" then 1.0
          // The absolute units, in the ratios the standard fixes them at.
          else if unit == "pt" then 4.0 / 3.0
          else if unit == "pc" then 16.0
          else if unit == "in" then 96.0
          else if unit == "cm" then 96.0 / 2.54
          else if unit == "mm" then 9.6 / 2.54
          else 1.0 in
        let v = mag * scale in
        int_of_float (if v < 0.0 then v - 0.5 else v + 0.5);

  // The root size, for the callers that have no element to ask about.
  let px_of = fn (s: str) -> px_at (fn (_z: int) -> root_em) s;

  // The `font` shorthand's size and line-height, as `size/line-height`. Both of the properties below
  // can be written only there — `font: 2em/2 sans-serif` names neither of them — so the shorthand is
  // picked apart at the two places that ask. Expanding it properly means a shorthand table, which is
  // the right shape and is not what one declaration is worth yet.
  let _font_parts = fn (v: str) ->
    let rec go = fn (ps: str list) ->
      match ps with
      | Nil -> ("", "")
      | Cons (t, rest) ->
        let i = str_index_of t "/" in
        if i >= 0 then (substring t 0 i, substring t (i + 1) (str_len t))
        else if str_len t > 0 && (_is_digit (char_at t 0) || char_at t 0 == ".")
        then (t, "")
        else go rest in
    go (str_split v " ");

  // The percentage in a value, or -1. Layout resolves these against the containing block.
  let pct_of = fn (s: str) ->
    if str_index_of s "%" < 0 then 0 - 1
    else
      let i = str_index_of s "%" in
      int_of_float (float_of_str (substring s 0 i) + 0.5);

  // ---- selectors ----------------------------------------------------------------



  let _empty_simple = elem { tag = "", id = "", cls = "" , sty_attr = "", pres = "" };

  // Component values to steps. The hash carries its type flag joined by U+0001 — the CSS
  // tokenizer puts it there — so the id is what comes before that.
  let parse_sel = fn (vs: cval list) ->
    let rec go = fn (vs: cval list) -> fn (cur: elem) -> fn (child: bool) ->
                 fn (acc: step list) ->
      match vs with
      | Nil ->
        if cur.tag == "" && cur.id == "" && cur.cls == "" then list_rev acc
        else list_rev (Cons (step { s = cur, child = child }, acc))
      | Cons (v, rest) ->
        match v with
        | Named (k, val) ->
          if k == "ident" then go rest (elem { tag = to_lower val, id = cur.id, pres = "",
                                                 cls = cur.cls, sty_attr = "" }) child acc
          else if k == "hash" then
            let i = str_index_of val (chr 1) in
            let id = if i < 0 then val else substring val 0 i in
            go rest (elem { tag = cur.tag, id = id, cls = cur.cls , sty_attr = "", pres = "" }) child acc
          // A selector with a kind this does not understand does not match ANYTHING. Skipping the
          // token instead reads `body &gt; span` — which is what a `<style>` element contains, because
          // its text is raw and character references are not decoded in it — as `body span`, and
          // applies a rule the browser drops. Ignoring what you cannot parse turns an invalid selector
          // into a matching one.
          else Nil
        | Bare s ->
          if s == "." then
            match rest with
            | Cons (Named (_k2, cname), r2) ->
              go r2 (elem { tag = cur.tag, id = cur.id, cls = to_lower cname , sty_attr = "",
                            pres = "" }) child acc
            | _ -> go rest cur child acc
          else if s == ">" then
            // A combinator ends the compound before it. The `>` sets the flag on the NEXT one,
            // because "must be the direct parent" is a statement about the step that follows.
            let acc2 = if cur.tag == "" && cur.id == "" && cur.cls == "" then acc
                       else Cons (step { s = cur, child = child }, acc) in
            go rest _empty_simple true acc2
          else if s == " " then
            // Whitespace next to a `>` is padding, not a combinator. With nothing accumulated
            // there is no compound to close and no descendant relationship to state, so the flag
            // is left exactly as it is — clearing it here turned `div > span` back into
            // `div span`, and the `>` had already been read.
            if cur.tag == "" && cur.id == "" && cur.cls == "" then
              go rest _empty_simple child acc
            else
              let acc2 = Cons (step { s = cur, child = child }, acc) in
              (match rest with
               | Cons (Bare ">", _r) -> go rest _empty_simple child acc2
               | _ -> go rest _empty_simple false acc2)
          else Nil
        | Block (_b, _k) -> Nil
        | Func (_f, _k) -> Nil in
    go vs _empty_simple false Nil;

  // Specificity, as the one number the cascade compares. Ids count 100, classes 10, tags 1 —
  // the standard's three-column tuple flattened, which is exact as long as no selector has a
  // hundred of anything, and none in the corpus has two.
  let specificity = fn (steps: step list) ->
    let rec go = fn (xs: step list) -> fn (acc: int) ->
      match xs with
      | Nil -> acc
      | Cons (st, rest) ->
        go rest (acc + (if st.s.id == "" then 0 else 100)
                     + (if st.s.cls == "" then 0 else 10)
                     + (if st.s.tag == "" then 0 else 1)) in
    go steps 0;


  // The class attribute is a space-separated list, and a substring test would match `foobar` for
  // `foo`. Compared token by token.
  let _has_class = fn (list: str) -> fn (want: str) ->
    let n = str_len list in
    let rec go = fn (i: int) -> fn (cur: str) ->
      if i >= n then cur == want
      else
        let c = char_at list i in
        if c == " " || c == "\t" || c == "\n" then
          (if cur == want then true else go (i + 1) "")
        else go (i + 1) (cur ++ to_lower c) in
    go 0 "";

  let _matches_simple = fn (e: elem) -> fn (s: elem) ->
    (s.tag == "" || s.tag == e.tag)
    && (s.id == "" || s.id == e.id)
    && (s.cls == "" || _has_class e.cls s.cls);

  // Does the chain match, given the element and its ancestors nearest first? Walked from the
  // last step backwards: the last step is about the element itself, and everything before it is
  // about somewhere above.
  let matches = fn (steps: step list) -> fn (e: elem) -> fn (ancestors: elem list) ->
    let rev = list_rev steps in
    match rev with
    | Nil -> false
    | Cons (last, up) ->
      if not (_matches_simple e last.s) then false
      else
        // Each remaining step consumes ancestors: a child step must match the very next one, a
        // descendant step may skip any number. Backtracking is not needed for the shapes in the
        // corpus and its absence is a real limitation, written here rather than discovered:
        // `div p span` where the outer div also matches `p` would need it.
        // `want_child` belongs to the step BELOW the one being matched, not to this one. `>` sets
        // the flag on the compound after it — "my parent must be that" — and this walk runs the
        // other way, so the flag has to be carried down from the step already matched. Reading it
        // off the current step made `div > span` match a span two levels under a div.
        let rec go = fn (xs: step list) -> fn (anc: elem list) -> fn (want_child: bool) ->
          match xs with
          | Nil -> true
          | Cons (st, rest) ->
            let rec find = fn (a: elem list) -> fn (first: bool) ->
              match a with
              | Nil -> false
              | Cons (x, more) ->
                if _matches_simple x st.s then go rest more st.child
                else if want_child && first then false
                else find more false in
            find anc true in
        go up ancestors last.child;

  // ---- the cascade --------------------------------------------------------------


  // The value of a component value list, flattened back to text. Declarations arrive as
  // component values and the properties here want a word or a length, so this is the last mile.
  //
  // The care is all in the numbers. The CSS tokenizer packs a number's extra fields after a
  // U+0001 — representation, integer-or-number, and for a dimension its unit — so a consumer that
  // takes the text before the separator gets `1` out of `1em` and never knows. That is exactly
  // what happened: every `em` in the UA stylesheet resolved to one pixel, a paragraph's margin
  // came out as 1 instead of 16, and the only visible symptom was a document eight pixels too
  // short. A packed field is a field somebody has to unpack.
  let value_text = fn (vs: cval list) ->
    let field = fn (s: str) -> fn (i: int) ->
      let rec go = fn (at: int) -> fn (n: int) -> fn (acc: str) ->
        if at >= str_len s then (if n == i then acc else "")
        else if char_at s at == chr 1 then
          (if n == i then acc else go (at + 1) (n + 1) "")
        else go (at + 1) n (acc ++ char_at s at) in
      go 0 0 "" in
    let one = fn (v: cval) ->
      match v with
      | Bare s -> s
      | Named (k, s) ->
        if k == "dimension" then field s 0 ++ field s 2
        else if k == "percentage" then field s 0 ++ "%"
        else if k == "number" then field s 0
        else if k == "hash" then "#" ++ field s 0
        else s
      | Block (_b, _k) -> ""
      | Func (_f, _k) -> "" in
    let rec go = fn (xs: cval list) -> fn (acc: str) ->
      match xs with
      | Nil -> acc
      | Cons (v, rest) -> go rest (acc ++ one v) in
    str_trim (go vs "");

  // ---- the cascade ---------------------------------------------------------------

  // A selector list split on its top-level commas: `p, div { ... }` is two rules that happen to
  // share a block, and the cascade compares them one at a time.
  let _split_commas = fn (vs: cval list) ->
    let rec go = fn (xs: cval list) -> fn (cur: cval list) -> fn (acc: cval list list) ->
      match xs with
      | Nil -> list_rev (Cons (list_rev cur, acc))
      | Cons (v, rest) ->
        match v with
        | Bare c -> if c == "," then go rest Nil (Cons (list_rev cur, acc))
                    else go rest (Cons (v, cur)) acc
        | Named (_k, _x) -> go rest (Cons (v, cur)) acc
        | Block (_b, _k) -> go rest (Cons (v, cur)) acc
        | Func (_f, _k) -> go rest (Cons (v, cur)) acc in
    go vs Nil Nil;

  // A stylesheet, flattened to (selector chain, specificity, declarations) once per document
  // rather than once per element. Note 166's lesson is that the per-element cost is the one that
  // turns into a square.
  let prepare = fn (src: str) ->
    let rec go = fn (rs: rule list) -> fn (acc: prepared list) ->
      match rs with
      | Nil -> list_rev acc
      | Cons (r, rest) ->
        match r with
        | QualRule (pre, body) ->
          let rec each = fn (groups: cval list list) -> fn (a: prepared list) ->
            match groups with
            | Nil -> a
            | Cons (g, more) ->
              let st = parse_sel g in
              match st with
              | Nil -> each more a
              | Cons (_x, _y) ->
                each more (Cons (prepared { steps = st, spec = specificity st,
                                            decls = Rules.declarations body }, a)) in
          go rest (each (_split_commas pre) acc)
        | AtRule (_n, _p, _b) -> go rest acc
        | Decl (_n, _v, _i) -> go rest acc
        | RuleErr _w -> go rest acc in
    go (Rules.stylesheet src) Nil;

  // Every declaration that reaches this element, with what it took to reach it. `origin` separates
  // the UA sheet from the author's and is folded into the specificity, so the author always wins
  // whatever the selectors say — a plain specificity comparison across origins would let a UA
  // `body { margin: 8px }` beat an author's `#x { margin: 0 }`, and it must not.
  let hits_for = fn (sheets: prepared list) -> fn (origin: int) -> fn (e: elem) ->
                 fn (ancestors: elem list) -> fn (start: int) ->
    let rec go = fn (ps: prepared list) -> fn (i: int) -> fn (acc: hit list) ->
      match ps with
      | Nil -> acc
      | Cons (pr, rest) ->
        if not (matches pr.steps e ancestors) then go rest (i + 1) acc
        else
          let rec each = fn (ds: rule list) -> fn (a: hit list) ->
            match ds with
            | Nil -> a
            | Cons (d, more) ->
              match d with
              | Decl (name, value, _imp) ->
                each more (Cons (hit { prop = to_lower name, value = value_text value,
                                       spec = origin * 100000 + pr.spec,
                                       order = start + i }, a))
              | AtRule (_n, _p, _b) -> each more a
              | QualRule (_p, _b) -> each more a
              | RuleErr _w -> each more a in
          go rest (i + 1) (each pr.decls acc) in
    go sheets 0 Nil;

  // The winning value for a property, or "" when nothing said anything. Specificity first, then
  // document order — the cascade in the only two terms this needs, since nothing here has
  // `!important` or a layer.
  // The winning declaration AND what it won with, because two properties sometimes have to be compared
  // against each other and a value alone cannot say which came from the stronger rule.
  let winner_at = fn (hs: hit list) -> fn (prop: str) ->
    let rec go = fn (xs: hit list) -> fn (best: str) -> fn (bs: int) -> fn (bo: int) ->
      match xs with
      | Nil -> (best, bs, bo)
      | Cons (h, rest) ->
        if h.prop != prop then go rest best bs bo
        else if h.spec > bs || (h.spec == bs && h.order >= bo) then
          go rest h.value h.spec h.order
        else go rest best bs bo in
    go hs "" (0 - 1) (0 - 1);

  let winner = fn (hs: hit list) -> fn (prop: str) ->
    let (v, _s, _o) = winner_at hs prop in v;

  // The four sides of a shorthand, in the standard's order: one value is all four, two are
  // vertical then horizontal, three add the bottom, four go clockwise from the top.
  let _sides = fn (v: str) ->
    let parts = list_filter (str_split v " ") (fn (x: str) -> x != "") in
    match parts with
    | Nil -> ("", "", "", "")
    | Cons (a, r1) ->
      match r1 with
      | Nil -> (a, a, a, a)
      | Cons (b, r2) ->
        match r2 with
        | Nil -> (a, b, a, b)
        | Cons (c, r3) ->
          match r3 with
          | Nil -> (a, b, c, b)
          | Cons (d, _r4) -> (a, b, c, d);

  // The width in a `border` shorthand. It is three values in any order and only one is a length;
  // the other two are a style and a colour. `border: none` is a ZERO width whatever else is
  // there, which is why the style word is read rather than skipped over.
  let _border_width = fn (v: str) ->
    let parts = list_filter (str_split (to_lower v) " ") (fn (x: str) -> x != "") in
    let is_style = fn (x: str) ->
      x == "none" || x == "hidden" || x == "dotted" || x == "dashed" || x == "solid"
      || x == "double" || x == "groove" || x == "ridge" || x == "inset" || x == "outset" in
    let rec go = fn (xs: str list) -> fn (w: int) -> fn (drawn: bool) ->
      match xs with
      | Nil -> if drawn then w else 0
      | Cons (x, rest) ->
        if is_style x then go rest w (x != "none" && x != "hidden")
        else if x == "thin" then go rest 1 drawn
        else if x == "medium" then go rest 3 drawn
        else if x == "thick" then go rest 5 drawn
        else if x != "" && (_is_digit (char_at x 0) || char_at x 0 == ".") then
          go rest (px_of x) drawn
        else go rest w drawn in
    // A border with no STYLE draws nothing, whatever width it names — the initial `border-style` is
    // `none`, and a shorthand that does not say otherwise leaves it there. `border: 6px sold green` is a
    // misspelling of `solid` in one of the corpus's own documents, and the browser gives that element no
    // border at all: reading the 6px and ignoring the word that failed made the box twelve pixels taller
    // than it should be. A width without a style is a width nobody asked to see.
    go parts 3 false;

  // ---- what layout asks ----------------------------------------------------------

  // The declarations an inline `style=` contributes, above every selector. Shared with the walk below so
  // that an ancestor's inline style counts the same way its stylesheet rules do.
  let inline_hits = fn (text: str) ->
    let rec go = fn (rs: rule list) -> fn (acc: hit list) ->
      match rs with
      | Nil -> acc
      | Cons (r, rest) ->
        match r with
        | Decl (name, value, _i) ->
          go rest (Cons (hit { prop = to_lower name, value = value_text value,
                               spec = 2 * 100000, order = 0 }, acc))
        | _ -> go rest acc in
    if text == "" then Nil else go (Rules.declaration_list text) Nil;

  // The presentational attributes, as declarations. They sit between the UA sheet and the author's:
  // above every UA rule, because that is what "the page said so" means, and below every author
  // selector, because a stylesheet is allowed to override an attribute. 99999 encodes exactly that —
  // an origin's specificities are its own 100000 band, and no selector's specificity reaches the top of
  // one.
  let pres_hits = fn (text: str) ->
    let rec go = fn (rs: rule list) -> fn (acc: hit list) ->
      match rs with
      | Nil -> acc
      | Cons (r, rest) ->
        match r with
        | Decl (name, value, _i) ->
          go rest (Cons (hit { prop = to_lower name, value = value_text value,
                               spec = 99999, order = 0 }, acc))
        | _ -> go rest acc in
    if text == "" then Nil else go (Rules.declaration_list text) Nil;

  // The computed value of an INHERITED property. Walked up the ancestor chain rather than threaded down
  // as a computed value, because every call site already has the chain and none has the parent's style —
  // the chain is by far the smaller change, and its cost is the depth of the tree rather than its size.
  // **Inheritance is here now, and it is the tree walk.** It used to be a hole with a note in it: a
  // declaration reached an element only through a selector that matched it, and a property whose value
  // comes from an ancestor because the property INHERITS was not modelled at all. What stood in for it
  // was `inherited`, one property at a time, asked for by name and answered by walking back up the
  // ancestor chain and matching every selector at every level of it. That answered correctly and cost
  // the depth of the tree per question, and it could not express the two-form properties at all —
  // a unitless `line-height` has to inherit as the NUMBER and a length as the length, and a function
  // returning one string cannot say which it had.
  //
  // Now `resolve` takes the parent's computed style. Every caller in layout is already standing at a
  // parent-child edge, so handing it over costs nothing. The inherited set is `font-size`,
  // `line-height`, `direction`, `white-space` and `text-indent` — the ones geometry reads. Colour and
  // the rest of the painting properties will join them when there is something to paint.
  //
  // What is still missing: the `inherit` keyword, and `initial` / `unset`. No document in the corpus
  // writes one.

  // The style an element with no parent inherits from: the initial value of every inherited property.
  // The other fields are never read of it — it is not an element and does not generate a box — and are
  // filled with the values that make it harmless if one ever is.
  let root_style =
    sty { display = "block", position = "static", float_ = "none", spacing = 0,
          overflow = "visible", valign = "baseline", bsz = "content-box",
          fs = root_em, lh_px = 0 - 1, lh_num = 0.0 - 1.0, dir = "ltr", ws = "normal",
          ti_px = 0, ti_pct = 0 - 1,
          left = 0 - 1, top = 0 - 1, w = 0 - 1, h = 0 - 1, w_pct = 0 - 1, h_pct = 0 - 1,
          mt = 0, mr = 0, mb = 0, ml = 0, pt = 0, pr = 0, pb = 0, pl = 0,
          bt = 0, br = 0, bb = 0, bl = 0 };

  // `pst` is the PARENT's computed style, and it is what makes this inheritance rather than a lookup.
  let resolve = fn (hs: hit list) -> fn (tag: str) -> fn (pst: sty) ->
    let get = fn (p: str) -> winner hs p in
    // The font size comes first because every other length may be written in `em` — and it is itself
    // measured in the PARENT's em, since a font size cannot be measured in itself. The absolute-size
    // keywords are a table in the standard and there is nothing to derive: `xx-large` is 32 because
    // that is what it is.
    let fs =
      let v0 = get "font-size" in
      let v = to_lower (if v0 != "" then v0 else let (sz, _l) = _font_parts (get "font") in sz) in
      if v == "" then pst.fs
      else if v == "xx-small" then 9
      else if v == "x-small" then 10
      else if v == "small" then 13
      else if v == "medium" then root_em
      else if v == "large" then 18
      else if v == "x-large" then 24
      else if v == "xx-large" then 32
      else if v == "smaller" then (pst.fs * 5) / 6
      else if v == "larger" then (pst.fs * 6) / 5
      else if str_index_of v "%" >= 0 then
        (let q = pct_of v in if q < 0 then pst.fs else (pst.fs * q) / 100)
      else
        let n = str_len v in
        let rec num_end = fn (i: int) ->
          if i < n && (_is_digit (char_at v i) || char_at v i == "."
                       || char_at v i == "-" || char_at v i == "+")
          then num_end (i + 1) else i in
        let ne = num_end 0 in
        if ne == 0 then pst.fs
        else
          let mag = float_of_str (substring v 0 ne) in
          let unit = substring v ne n in
          if unit == "em" then int_of_float (mag * float_of_int pst.fs + 0.5)
          else if unit == "ex" then int_of_float (mag * float_of_int pst.fs * 0.5 + 0.5)
          else let q = px_at (fn (_z: int) -> pst.fs) v in if q <= 0 then pst.fs else q in
    // Every length below is measured in this element's OWN em, which is what `em` means everywhere
    // except in the declaration that set it.
    let px_of = px_at (fn (_z: int) -> fs) in
    // `line-height`, which inherits in two forms. A bare NUMBER inherits as the number and is
    // multiplied by each element's own font size; a length inherits as the length it computed to.
    let (lh_px, lh_num) =
      let v1 = get "line-height" in
      let v = to_lower (if v1 != "" then v1 else let (_s, l) = _font_parts (get "font") in l) in
      if v == "" then (pst.lh_px, pst.lh_num)
      else if v == "normal" then (0 - 1, 0.0 - 1.0)
      else if str_index_of v "%" >= 0 then
        (let q = pct_of v in
         if q < 0 then (0 - 1, 0.0 - 1.0) else ((fs * q) / 100, 0.0 - 1.0))
      else
        let n2 = str_len v in
        let rec bare = fn (i: int) ->
          if i >= n2 then n2 > 0
          else if _is_digit (char_at v i) || char_at v i == "." then bare (i + 1)
          else false in
        if bare 0 then (0 - 1, float_of_str v)
        else (let q = px_of v in if q < 0 then (0 - 1, 0.0 - 1.0) else (q, 0.0 - 1.0)) in
    let (ti_px, ti_pct) =
      let v = get "text-indent" in
      if v == "" then (pst.ti_px, pst.ti_pct)
      else if str_index_of v "%" >= 0 then
        (let q = pct_of v in if q < 0 then (0, 0 - 1) else (0, q))
      else (let q = px_of v in if q == 0 - 1 || q == 0 - 2 then (0, 0 - 1) else (q, 0 - 1)) in
    // A longhand beats the shorthand it belongs to when both are present, which is only right
    // because `winner` already picked the winning shorthand and the winning longhand separately.
    // Which of the two DECLARATIONS wins, decided by the cascade's own rule rather than by "a longhand
    // always beats the shorthand it belongs to". That shortcut is right only when they come from rules
    // of equal weight, and the two commonest sources are not: the UA sheet writes `p { margin-top: 1em }`
    // as a LONGHAND, so an author's `p { margin: 0 }` lost to it and every paragraph in a document that
    // zeroed its margins kept them. One name, two questions — "is there a longhand" is not "does the
    // longhand win" — and the first answers yes far more often than the second.
    let side = fn (short: str) -> fn (long: str) -> fn (which: int) ->
      let (lv, ls, lo) = winner_at hs long in
      let (sv, ss, so) = winner_at hs short in
      if lv != "" && (sv == "" || ls > ss || (ls == ss && lo >= so)) then lv
      else if sv == "" then ""
      else
        let (t, r, b, ll) = _sides sv in
        if which == 0 then t else if which == 1 then r
        else if which == 2 then b else ll in
    // One name, two questions, met again. A negative PADDING is not a value the property accepts: the
    // declaration is invalid and the initial value stands, which is what clamping at zero gives. A
    // negative MARGIN is ordinary — it pulls the next box up over this one — and clamping it dropped
    // every one of them silently. Twelve documents in the corpus set one.
    //
    // `px_of` answers -2 for "not a length at all", which is not a negative margin and has to be told
    // apart from one before the sign can be believed. `margin: auto` arrives that way.
    let plen = fn (v: str) -> if v == "" then 0 else let q = px_of v in if q < 0 then 0 else q in
    //
    // And the test has to be on the STRING, not on what `px_of` answered. Its two sentinels, -1 for
    // `auto` and -2 for a percentage, live inside the range of a value that may now be negative: a
    // sentinel stops being a sentinel the moment the range it hid in widens. Reading -1 back as a
    // number moved four documents a pixel to the left, which is `margin-left: auto` arriving as a
    // one-pixel negative margin.
    let mlen = fn (v: str) ->
      if v == "" then 0
      else
        let lv = to_lower v in
        if lv == "auto" || str_index_of lv "%" >= 0 then 0 else px_of v in
    let bw = fn (which: int) ->
      let one = get ("border-" ++ (if which == 0 then "top" else if which == 1 then "right"
                                   else if which == 2 then "bottom" else "left")) in
      let all = get "border" in
      let stw = to_lower (get "border-style") in
      if one != "" then _border_width one
      else if all != "" then _border_width all
      else if stw != "" && stw != "none" && stw != "hidden" then 3
      else 0 in
    // Not named in either sheet means `inline`, which is the initial value and the right answer
    // for every tag the UA sheet does not mention.
    // Being taken out of flow BLOCKIFIES a box: an absolutely positioned or floated `display: inline`
    // computes to `block`. It has to — an inline box is a run on a line, and a box that is not in the
    // flow has no line to be a run on, so `width` and `height` would have nothing to apply to.
    let pos0 = let v = to_lower (get "position") in if v == "" then "static" else v in
    let flo0 = let v = to_lower (get "float") in if v == "" then "none" else v in
    let disp0 = let d = get "display" in if d != "" then to_lower d else "inline" in
    let disp = if disp0 == "none" then "none"
               else if pos0 == "absolute" || pos0 == "fixed" || flo0 != "none" then
                 (if disp0 == "inline" || disp0 == "inline-block" then "block" else disp0)
               else disp0 in
    let wv = get "width" in
    let hv = get "height" in
    sty {
      display = disp,
      // Two properties that are layout MODES rather than values: an out-of-flow box does not advance
      // its parent's cursor and does not add to its height, whatever its own numbers say.
      position = let v = to_lower (get "position") in if v == "" then "static" else v,
      float_ = let v = to_lower (get "float") in if v == "" then "none" else v,
      spacing = let v = get "border-spacing" in if v == "" then 0 else px_of v,
      // Anything but `visible` makes a box establish a formatting context, which is why it is here:
      // this is a layout question wearing a painting property's name.
      overflow = let v = to_lower (get "overflow") in if v == "" then "visible" else v,
      // The CSS property only. `valign="bottom"` on a table cell is the presentational form of the
      // same thing and is NOT read here — presentational attributes are not mapped to style at all
      // yet, which is a separate gap the corpus also names.
      valign = let v = to_lower (get "vertical-align") in if v == "" then "baseline" else v,
      bsz = let v = to_lower (get "box-sizing") in if v == "" then "content-box" else v,
      // The rest of the inherited set: keywords, so they inherit as themselves.
      fs = fs, lh_px = lh_px, lh_num = lh_num,
      dir = let v = to_lower (get "direction") in if v == "" then pst.dir else v,
      ws = let v = to_lower (get "white-space") in if v == "" then pst.ws else v,
      ti_px = ti_px, ti_pct = ti_pct,
      // `auto` and absent are the same answer here — both mean "the box goes where it would have gone",
      // which is the static position, and only a length says otherwise.
      left = let v = get "left" in if v == "" || to_lower v == "auto" then 0 - 1 else px_of v,
      top = let v = get "top" in if v == "" || to_lower v == "auto" then 0 - 1 else px_of v,
      w = if wv == "" || to_lower wv == "auto" then 0 - 1
          else let q = px_of wv in if q == 0 - 2 then 0 - 1 else q,
      h = if hv == "" || to_lower hv == "auto" then 0 - 1
          else let q = px_of hv in if q == 0 - 2 then 0 - 1 else q,
      w_pct = if wv == "" then 0 - 1 else pct_of wv,
      h_pct = if hv == "" then 0 - 1 else pct_of hv,
      mt = mlen (side "margin" "margin-top" 0),
      mr = mlen (side "margin" "margin-right" 1),
      mb = mlen (side "margin" "margin-bottom" 2),
      ml = mlen (side "margin" "margin-left" 3),
      pt = plen (side "padding" "padding-top" 0),
      pr = plen (side "padding" "padding-right" 1),
      pb = plen (side "padding" "padding-bottom" 2),
      pl = plen (side "padding" "padding-left" 3),
      bt = bw 0, br = bw 1, bb = bw 2, bl = bw 3
    };
}
