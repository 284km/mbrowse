// Boxes and glyphs to pixels.
//
// Everything below this point has been checked against something that is not this program: the boxes
// against a browser's own rects, the characters against its `Range`, the outlines against fontTools.
// This is where those answers become a picture, and it is the first thing here with no external
// oracle at all — because the question it answers is not "is this right" but "do these two pages
// look the same", and both sides of that are ours.
//
// That is what a REFTEST is, and it is why reftests could not come first. An engine that draws
// nothing passes every one of them. They can come now, after the geometry is independently known,
// and they check the three things geometry cannot: colour, what is painted over what, and whether
// the ink lands inside the box that was measured for it.
//
// **Painting order is document order.** Later boxes cover earlier ones, which is what a tree walk
// gives and is right for everything without `z-index` — the corpus has a handful of documents that
// need more and they will say so.

import "layout.mere";
import "jpeg.mere";
import "font.mere";

module Paint {
  let white = 16777215;

  // The canvas is a mutable vector because a painter overwrites: the whole point of drawing a box on
  // top of another is that the pixel underneath stops existing. Building it functionally would mean
  // rebuilding a row per box, which is the same work with an allocation for every stroke.
  let _blank = fn (n: int) ->
    let v = vec_new () in
    let rec go = fn (i: int) -> if i >= n then v else let _ = vec_push v white in go (i + 1) in
    go 0;

  let _fill = fn (v: int Vec) -> fn (w: int) -> fn (h: int) ->
              fn (bx: int) -> fn (by: int) -> fn (bw: int) -> fn (bh: int) -> fn (col: int) ->
    let x0 = if bx < 0 then 0 else bx in
    let y0 = if by < 0 then 0 else by in
    let x1 = if bx + bw > w then w else bx + bw in
    let y1 = if by + bh > h then h else by + bh in
    let rec row = fn (y: int) ->
      if y >= y1 then 0
      else
        let rec col_ = fn (x: int) ->
          if x >= x1 then 0
          else let _ = vec_set v (y * w + x) col in col_ (x + 1) in
        let _ = col_ x0 in row (y + 1) in
    row y0;

  // **Where the time goes, measured rather than assumed.** Caching each distinct glyph's outline for
  // the page — so a paragraph parses forty shapes once instead of five hundred times — was written and
  // timed and changed nothing: 29 seconds either way on the same document, with identical output. The
  // cost is not reading the curves, it is asking them about every pixel.
  //
  // So the way to make this quick is a scanline: solve each row's crossings once, sort them, and fill
  // the spans between, instead of a point-in-path test per pixel. That is roughly the width of a glyph
  // fewer winding computations. It is not written, because nothing yet needs the gate to be quick and
  // the version that is here is the one the raster gate already checks exactly.
  //
  // One glyph, drawn where layout put it. The box's `y` is the top of the character's content area
  // and its baseline is one ascent below that — the same ascent the box's height was built from, so
  // the two cannot drift apart.
  //
  // Only the pixels inside the glyph's own box are asked about. A glyph that overflows its box would
  // be clipped, which is a real difference from a browser and is not one this corpus can show: the
  // box is the font's content area and an outline that leaves it is a font with overshoot beyond its
  // own ascender.
  let _glyph = fn (v: int Vec) -> fn (w: int) -> fn (h: int) -> fn (f: font) -> fn (b: box) ->
    let gid = Font.glyph f b.cp in
    let qs = Font.glyph_quads f gid in
    match qs with
    | Nil -> 0
    | Cons (_q, _r) ->
      let asc = Font.line_height f b.fs - Font.scale f (0 - f.descender) b.fs in
      let base = b.y + asc in
      let upem = float_of_int f.upem in
      let sz = float_of_int b.fs in
      let x0 = if b.x < 0 then 0 else b.x in
      let y0 = if b.y < 0 then 0 else b.y in
      let x1 = if b.x + b.w > w then w else b.x + b.w in
      let y1 = if b.y + b.h > h then h else b.y + b.h in
      let rec row = fn (y: int) ->
        if y >= y1 then 0
        else
          // The page's y grows downward and the font's grows up from the baseline, so this is the one
          // place the two coordinate systems meet and the subtraction is the meeting.
          let gy = (float_of_int base - (float_of_int y + 0.5)) * upem / sz in
          let rec col_ = fn (x: int) ->
            if x >= x1 then 0
            else
              let gx = (float_of_int x + 0.5 - float_of_int b.x) * upem / sz in
              let _ = if Font.quads_cover qs gx gy then (let _ = vec_set v (y * w + x) b.fg in 0)
                      else 0 in
              col_ (x + 1) in
          let _ = col_ x0 in row (y + 1) in
      row y0;

  // The whole page. Backgrounds first in document order, then the ink — not because the standard says
  // so in those words, but because every glyph in this list belongs to a box that is already in it,
  // and painting them interleaved would let a later box's background cover text that is inside it.
  // The border, as a ring: the border box minus the padding box.
  //
  // Drawn as four bands rather than as "fill the border box then fill the padding box over it",
  // because the second version paints over whatever is already inside — and what is already inside is
  // this box's own background, which was put down first and is not the same colour.
  //
  // One colour for all four sides; CSS allows four and no document here uses more than one. Written as
  // four bands anyway, because the widths ARE four and a single inset would be wrong the moment they
  // differ, which `border-bottom` alone already does.
  let _border = fn (v: int Vec) -> fn (pw: int) -> fn (ph: int) -> fn (b: box) ->
    if b.bc < 0 || (b.bt <= 0 && b.br <= 0 && b.bb <= 0 && b.bl <= 0) then 0
    else
      let band = fn (x0: int) -> fn (y0: int) -> fn (x1: int) -> fn (y1: int) ->
        let rec go = fn (y: int) -> fn (x: int) ->
          if y >= y1 then 0
          else if x >= x1 then go (y + 1) x0
          else
            let _ = if x >= 0 && x < pw && y >= 0 && y < ph
                    then (let _ = vec_set v (y * pw + x) b.bc in 0) else 0 in
            go y (x + 1) in
        go y0 x0 in
      let x0 = b.x in let y0 = b.y in
      let x1 = b.x + b.w in let y1 = b.y + b.h in
      let _ = band x0 y0 x1 (y0 + b.bt) in
      let _ = band x0 (y1 - b.bb) x1 y1 in
      let _ = band x0 (y0 + b.bt) (x0 + b.bl) (y1 - b.bb) in
      let _ = band (x1 - b.br) (y0 + b.bt) x1 (y1 - b.bb) in
      0;

  // An image's own pixels, into its content box.
  //
  // The box the painter is given is the BORDER box; the picture goes inside the padding and the
  // border, which is where the layout put it and not where the box begins. Getting that wrong is
  // invisible until something has padding.
  //
  // Scaling is nearest-neighbour, and that is a placeholder rather than a decision. A browser
  // resamples, every browser resamples differently, and there is no exact answer to compare against —
  // so an image drawn at anything other than its natural size cannot be gated the way this is gated.
  // The corpus draws at natural size and says so; see OPEN_QUESTIONS Q-12.
  let _image = fn (v: int Vec) -> fn (pw: int) -> fn (ph: int) -> fn (b: box) ->
    if b.src == "" || not (file_exists b.src) then 0
    else
      let d = Jpeg.load_bytes b.src in
      if bytes_len d < 4 || bytes_get d 0 != 255 || bytes_get d 1 != 216 then 0
      else
        let jh = Jpeg.header d in
        let (px, _nz) = Jpeg.pixels jh d in
        if jh.w <= 0 || jh.h <= 0 then 0
        else
          let rec go = fn (y: int) -> fn (x: int) ->
            if y >= b.h then 0
            else if x >= b.w then go (y + 1) 0
            else
              let dx = b.x + x in
              let dy = b.y + y in
              let sx = if b.w == jh.w then x else x * jh.w / b.w in
              let sy = if b.h == jh.h then y else y * jh.h / b.h in
              let _ = if dx >= 0 && dx < pw && dy >= 0 && dy < ph
                         && sx >= 0 && sx < jh.w && sy >= 0 && sy < jh.h
                      then (let _ = vec_set v (dy * pw + dx) (vec_get px (sy * jh.w + sx)) in 0)
                      else 0 in
              go y (x + 1) in
          go 0 0;

  let paint = fn (f: font) -> fn (bs: box list) -> fn (w: int) -> fn (h: int) ->
    let v = _blank (w * h) in
    // One box's background and then its border, which have to stay together: a background belongs
    // behind its own border and in front of nothing else.
    let _fill_one = fn (b: box) ->
      let _ = if b.cp == 0 && b.bg >= 0 then _fill v w h b.x b.y b.w b.h b.bg else 0 in
      _border v w h b in

    let rec backs = fn (l: box list) ->
      match l with
      | Nil -> 0
      | Cons (b, r) ->
        let _ = if b.cp == 0 && b.bg >= 0 then _fill v w h b.x b.y b.w b.h b.bg else 0 in
        backs r in
    let rec inks = fn (l: box list) ->
      match l with
      | Nil -> 0
      | Cons (b, r) ->
        // An image is ink, not background: it goes down after every background and before the text,
        // so a caption over a picture is on top of it and the picture is on top of whatever fills the
        // box behind it. Three layers, in the order a browser paints them.
        let _ = if b.cp != 0 then _glyph v w h f b
                else if b.src != "" then _image v w h b
                else 0 in
        inks r in
    // Borders go down after every background and before any ink, which is the order a browser paints
    // them: a background is behind its own border, and text and pictures are in front of both.
    let rec borders = fn (l: box list) ->
      match l with
      | Nil -> 0
      | Cons (b, r) -> let _ = _border v w h b in borders r in
    // CSS 2.1 Appendix E, which is a LIST and not document order.
    //
    // Steps 3 and 4 first: every block-level background and border, then every float's. Then steps
    // 5 to 7 in ONE pass over the document — each inline-level box's background and border, and every
    // box's ink, interleaved in tree order.
    //
    // The interleaving is the part that had to be measured rather than reasoned. Doing all inline-level
    // backgrounds and then all the ink is a different picture: an inline-block's red text lands on top
    // of the green background of an inline that comes after it, where the browser has the green
    // covering both. Appendix E's step 7 is per box — its background, its border, its text — and not
    // per kind of thing.
    //
    // Positioned boxes are NOT separated out. Appendix E puts them after all of this and this does not,
    // because nothing has measured what that costs or gains, and moving something on a guess is how the
    // last set of failures got misattributed.
    let rec blocks = fn (l: box list) -> fn (n: int) ->
      match l with
      | Nil -> 0
      | Cons (b, r) ->
        let _ = if b.layer == n && b.cp == 0 then (let _ = _fill_one b in 0) else 0 in
        blocks r n in
    let rec inline_and_ink = fn (l: box list) ->
      match l with
      | Nil -> 0
      | Cons (b, r) ->
        let _ = if b.cp == 0 && b.layer == 5 then (let _ = _fill_one b in 0) else 0 in
        let _ = if b.cp != 0 then _glyph v w h f b
                else if b.src != "" then _image v w h b
                else 0 in
        inline_and_ink r in
    let _ = blocks bs 3 in
    let _ = blocks bs 4 in
    let _ = inline_and_ink bs in
    v;

  // Run-length rows: `count×rrggbb`, space separated, one line per row.
  //
  // Not a PPM, and the reason is what this is compared against. A reftest diffs two renderings, so
  // the format has to be exact and diffable and does not have to be an image — and an image is 2MB of
  // decimal triples per page while a page is mostly one colour per row. A failing line names the row
  // and the run, which is where to look.
  let hex6 = fn (c: int) ->
    let d = "0123456789abcdef" in
    let nib = fn (sh: int) -> char_at d ((c / sh) - (c / (sh * 16)) * 16) in
    nib 1048576 ++ nib 65536 ++ nib 4096 ++ nib 256 ++ nib 16 ++ nib 1;

  // --- the viewport ----------------------------------------------------------------
  //
  // `paint` draws the whole document, and until now the whole document was what went on the screen:
  // a page 1202 pixels tall opened a window 1202 pixels tall, on a viewport that is 513. The viewport
  // height was read by three unit conversions in `style.mere` and by no layout or paint decision
  // anywhere, which is Q-19 -- and a viewport height nothing reads cannot be told from one that is
  // wrong.
  //
  // **This is a slice and NOT a parameter on `paint`.** Threading a `scroll_y` through the painter
  // would put it on the one function whose output every pixel gate compares, so the reftests, the
  // image-ink gate, the north-star gate and the window gate would all move at once and the honest
  // version of that change starts by pinning what they say today. Slicing the finished raster
  // instead leaves every one of those outputs byte-identical, and it is not a lesser answer: with no
  // incremental paint here, "draw the document and show a window onto it" IS the model.
  //
  // The cost is that a tall document is rastered in full before any of it is shown, which is exactly
  // what already happened, so nothing regresses. When that stops being acceptable the parameter is
  // the answer and this comment is the record of why it was not needed first.
  //
  // `scroll_y` is CLAMPED rather than trusted: a caller asking to scroll past the end gets the last
  // window, and one asking for a negative offset gets the first. A viewport taller than the document
  // is the document -- the caller decides the window's height, and `main` gives it
  // `min (doc_h, viewport_h)`, so this never has to invent rows that were never painted.
  let clamp_scroll = fn (doc_h: int) -> fn (view_h: int) -> fn (scroll_y: int) ->
    let most = doc_h - view_h in
    let most = if most < 0 then 0 else most in
    if scroll_y < 0 then 0 else if scroll_y > most then most else scroll_y;

  let viewport = fn (v: int Vec) -> fn (w: int) -> fn (doc_h: int) -> fn (view_h: int) -> fn (scroll_y: int) ->
    let top = clamp_scroll doc_h view_h scroll_y in
    let rows = if view_h > doc_h then doc_h else view_h in
    let out = vec_new () in
    let n = w * rows in
    let rec go = fn (i: int) ->
      if i >= n then out
      else
        let _ = vec_push out (vec_get v (top * w + i)) in
        go (i + 1)
    in go 0;

  let render = fn (v: int Vec) -> fn (w: int) -> fn (h: int) ->
    let rec row = fn (y: int) -> fn (out: str list) ->
      if y >= h then str_join "\n" (list_rev out)
      else
        let rec run = fn (x: int) -> fn (cur: int) -> fn (n: int) -> fn (acc: str list) ->
          if x >= w then list_rev (Cons (str_of_int n ++ "x" ++ hex6 cur, acc))
          else
            let c = vec_get v (y * w + x) in
            if c == cur then run (x + 1) cur (n + 1) acc
            else run (x + 1) c 1 (Cons (str_of_int n ++ "x" ++ hex6 cur, acc)) in
        let line = str_join " " (run 1 (vec_get v (y * w)) 1 Nil) in
        row (y + 1) (Cons (line, out)) in
    row 0 Nil;
}
