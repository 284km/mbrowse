// CSS component values: the level css-parsing-tests calls a component value list.
//
// Comments are removed before anything else, which is why `red/* CDC */-->` has a CDC
// in it and `red-->` does not: in the second the dashes are still part of the
// identifier when the tokenizer reaches them, and what is left over is a lone `>`.
//
// What is here: whitespace, identifiers, functions, at-keywords, hashes, strings,
// numbers with their dimensions and percentages, the CDO and CDC, and everything else
// as a delimiter. What is not: `url()`, escapes, and the nested block structures
// (`{}`, `[]`, `()`), which the higher levels of the suite need and this level mostly
// does not.

type cval =
  | Bare of str                  // a token that is only itself: a delim, whitespace, a CDC
  | Named of (str * str)         // a kind and its value: ident, number, string, ...
  | Block of (str * cval list)   // `()`, `[]` or `{}` and what is inside it
  | Func of (str * cval list);   // a name and its arguments

module Css {
  let _is_ws = fn (c: str) ->
    c == " " || c == "\t" || c == "\n" || c == "\r" || c == chr 12;

  let _is_digit = fn (c: str) -> c != "" && c >= "0" && c <= "9";

  // Identifiers may start with a letter, an underscore, a dash, or anything non-ASCII —
  // the last because CSS decided that a name is what is not punctuation.
  // The empty string is what `at` returns past the end of the input, and it is not a
  // name start — asking `ord` about it is an error rather than an answer, which is how
  // this showed up: cases died mid-run and the harness counted their missing output as
  // a wrong answer instead of as a crash.
  let _is_name_start = fn (c: str) ->
    if c == "" then false
    else (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_" || ord c > 127;

  let _is_name = fn (c: str) -> _is_name_start c || _is_digit c || c == "-";

  // Kept because the higher levels of the suite have a case for it, but NOT used by
  // the tokenizer: see the note in `go`.
  let strip_comments = fn (s: str) ->
    let n = str_len s in
    let at = fn (i: int) -> if i >= n then "" else char_at s i in
    let rec go = fn (i: int) -> fn (out: str) ->
      if i >= n then out
      else if at i == "/" && at (i + 1) == "*" then
        let rec skip = fn (k: int) ->
          if k + 1 >= n then n
          else if at k == "*" && at (k + 1) == "/" then k + 2
          else skip (k + 1) in
        go (skip (i + 2)) out
      else go (i + 1) (out ++ at i) in
    go 0 "";

  let _is_hex = fn (c: str) ->
    (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F");

  let _hexval = fn (c: str) ->
    if c >= "0" && c <= "9" then ord c - 48
    else if c >= "a" && c <= "f" then ord c - 87
    else ord c - 55;

  // The input stream is preprocessed before the tokenizer sees it: CRLF, a lone CR and a
  // form feed all become LF, and U+0000 becomes U+FFFD. Doing it here rather than in
  // every state is the same reasoning the HTML standard gives for its own preprocessing
  // — otherwise every rule that mentions a newline has to mention three of them.
  let preprocess = fn (s: str) ->
    let n = str_len s in
    let at = fn (i: int) -> if i >= n then "" else char_at s i in
    let repl = chr 239 ++ chr 191 ++ chr 189 in
    let rec go = fn (i: int) -> fn (out: str) ->
      if i >= n then out
      else
        let c = at i in
        if c == "\r" && at (i + 1) == "\n" then go (i + 2) (out ++ "\n")
        else if c == "\r" || c == chr 12 then go (i + 1) (out ++ "\n")
        else if ord c == 0 then go (i + 1) (out ++ repl)
        else go (i + 1) (out ++ c) in
    go 0 "";

  let tokenize = fn (src0: str) ->
    let src = preprocess src0 in
    let n = str_len src in
    let at = fn (i: int) -> if i >= n then "" else char_at src i in

    // An escape: a backslash and up to six hex digits, then one optional whitespace
    // that belongs to the escape and not to the document — which is why `\30 red` is
    // the single identifier `0red` and not `0` followed by `red`. A backslash before
    // anything else is that character literally; at the end of input it is U+FFFD.
    // A backslash before a newline is not an escape — it is a delimiter and then a
    // line break, which is why `\<newline>red` is three component values and not one
    // identifier.
    let esc_ok = fn (i: int) -> at (i + 1) != "\n" && at (i + 1) != "\r" in
    let esc_at = fn (i: int) ->
      if at (i + 1) == "" then (chr 239 ++ chr 191 ++ chr 189, i + 1)
      else if not (_is_hex (at (i + 1))) then (at (i + 1), i + 2)
      else
        let rec hx = fn (k: int) -> fn (v: int) -> fn (cnt: int) ->
          if cnt >= 6 || not (_is_hex (at k)) then (k, v)
          else hx (k + 1) (v * 16 + _hexval (at k)) (cnt + 1) in
        let (k, v) = hx (i + 1) 0 0 in
        // One whitespace is consumed after an escape, and CRLF is one whitespace — not
        // two. Consuming only the CR left the LF behind as its own token, which split
        // `\30<CRLF>red` into an identifier, a space and another identifier instead of
        // the one identifier `0red`.
        let k2 =
          if at k == "\r" && at (k + 1) == "\n" then k + 2
          else if _is_ws (at k) then k + 1 else k in
        (str_of_codepoint (if v == 0 || v > 1114111 then 65533 else v), k2) in

    // Whether an identifier could start at `i`: a name start, an escape, or a dash
    // before one of those or another dash. Three rules in the standard say this — the
    // ident rule, the at-keyword rule and the hash flag — and they are the same rule, so
    // saying it three times is three places for it to drift.
    let _starts_ident = fn (i: int) ->
      _is_name_start (at i) || (at i == "\\" && esc_ok i)
      || (at i == "-" && (_is_name_start (at (i + 1)) || at (i + 1) == "-"
                          || (at (i + 1) == "\\" && esc_ok (i + 1)))) in

    // A name, built as it is scanned because an escape inside it stands for something
    // other than its own characters. This was a substring until the corpus asked for
    // `\30 red`.
    let name_from = fn (i: int) ->
      let rec go = fn (k: int) -> fn (acc: str) ->
        if k >= n then (acc, k)
        else if at k == "\\" && esc_ok k then
          let (t, k2) = esc_at k in go k2 (acc ++ t)
        else if _is_name (at k) then go (k + 1) (acc ++ at k)
        else (acc, k) in
      go i "" in

    let rec name_end = fn (i: int) -> if i < n && _is_name (at i) then name_end (i + 1) else i in

    let rec go = fn (i: int) -> fn (out: cval list) ->
      if i >= n then list_rev out
      else
        let c = at i in
        // A comment is skipped between tokens, not deleted from the text. Those are
        // different: `red/* */-->` is an ident and a CDC, because the comment ends the
        // identifier, while deleting it first gives `red-->` — an ident `red--` and a
        // lone `>`. The suite has both spellings next to each other, which is how this
        // was caught, and it was the wrong way round in this file's own notes first.
        if c == "/" && at (i + 1) == "*" then
          let rec skip = fn (k: int) ->
            if k + 1 >= n then n
            else if at k == "*" && at (k + 1) == "/" then k + 2
            else skip (k + 1) in
          go (skip (i + 2)) out
        else if _is_ws c then
          // Any run of whitespace is one token, and the suite writes it as a space.
          let rec ws = fn (k: int) -> if k < n && _is_ws (at k) then ws (k + 1) else k in
          go (ws i) (Cons (Bare " ", out))
        else if c == "\"" || c == "'" then
          // Three ways a string can end, and the suite distinguishes all three: the
          // matching quote, a raw newline, and the end of the input. A newline inside a
          // string is not a string at all — the standard calls it a bad-string and the
          // newline is not consumed, so what follows it is tokenized afresh. Running to
          // the end of the input *is* a string, plus an error saying so.
          let rec str_end = fn (k: int) -> fn (acc: str) -> fn (how: str) ->
            if k >= n then (k, acc, "eof")
            else if at k == c then (k + 1, acc, "ok")
            else if at k == "\n" || at k == "\r" then (k, acc, "bad")
            else if at k == "\\" && at (k + 1) == "" then
              // A backslash as the last thing in the input is dropped, not turned into
              // U+FFFD: inside a string there is nothing for it to escape and the string
              // simply ends. Outside one it is a delimiter. The replacement character is
              // for an escape that names no code point, which this is not.
              str_end (k + 1) acc how
            else if at k == "\\" && (at (k + 1) == "\n" || at (k + 1) == "\r") then
              str_end (k + 2) acc how
            else if at k == "\\" then
              let (t, k2) = esc_at k in str_end k2 (acc ++ t) how
            else str_end (k + 1) (acc ++ at k) how in
          let (e, v, how) = str_end (i + 1) "" "ok" in
          if how == "bad" then go e (Cons (Named ("error", "bad-string"), out))
          else if how == "eof" then
            go e (Cons (Named ("error", "eof-in-string"), Cons (Named ("string", v), out)))
          else go e (Cons (Named ("string", v), out))
        // `@-0media` is not an at-keyword: what follows the at sign has to be able to
        // start an identifier, and a dash can only do that before a name start, another
        // dash, or an escape — the same rule as an identifier, because it is one.
        else if c == "@" && _starts_ident (i + 1) then
          let (v, e) = name_from (i + 1) in
          go e (Cons (Named ("at-keyword", v), out))
        // A hash carries a flag saying whether what follows the sign could have been an
        // identifier on its own: `#red` could, `#0red` could not, and a selector engine
        // needs to know because only the first is an id. It is the same "starts an
        // identifier" question asked of `-` and `@` above, asked a third time — so it is
        // written once here and the three call it.
        else if c == "#" && (_is_name (at (i + 1))
                            || (at (i + 1) == "\\" && esc_ok (i + 1))) then
          let (v, e) = name_from (i + 1) in
          let flag = if _starts_ident (i + 1) then "id" else "unrestricted" in
          go e (Cons (Named ("hash", v ++ chr 1 ++ flag), out))
        else if _is_digit c
                || ((c == "+" || c == "-") && _is_digit (at (i + 1)))
                || (c == "." && _is_digit (at (i + 1)))
                || ((c == "+" || c == "-") && at (i + 1) == "." && _is_digit (at (i + 2))) then
          let rec digits = fn (k: int) -> if _is_digit (at k) then digits (k + 1) else k in
          let k1 = if c == "+" || c == "-" then digits (i + 1) else digits i in
          let k2 = if at k1 == "." && _is_digit (at (k1 + 1)) then digits (k1 + 1) else k1 in
          let k3 =
            if (at k2 == "e" || at k2 == "E")
               && (_is_digit (at (k2 + 1))
                   || ((at (k2 + 1) == "+" || at (k2 + 1) == "-") && _is_digit (at (k2 + 2))))
            then digits (if _is_digit (at (k2 + 1)) then k2 + 1 else k2 + 2)
            else k2 in
          let num = substring src i k3 in
          // The suite asks for the representation *and* whether it is an integer, and
          // they are different questions: `+45.0` is a number whose value is 45, and the
          // representation is what was written. A dimension also carries its unit.
          let ntype =
            if str_index_of num "." >= 0 || str_index_of num "e" >= 0
               || str_index_of num "E" >= 0 then "number" else "integer" in
          if at k3 == "%" then
            go (k3 + 1) (Cons (Named ("percentage", num ++ chr 1 ++ ntype), out))
          // A unit is an identifier, so it may begin with a dash the same way one may:
          // `12.0-red` is twelve of the unit `-red`, not a number and an identifier.
          else if _starts_ident k3 then
            let (u, e) = name_from k3 in
            go e (Cons (Named ("dimension", num ++ chr 1 ++ ntype ++ chr 1 ++ u), out))
          else go k3 (Cons (Named ("number", num ++ chr 1 ++ ntype), out))
        // Before the identifier rules, not after: `-->` has to win over the `-` that
        // starts a name, or `--` is taken as an identifier and the CDC never happens.
        // The standard checks it first for exactly that reason.
        else if c == "<" && at (i + 1) == "!" && at (i + 2) == "-" && at (i + 3) == "-" then
          go (i + 4) (Cons (Bare "<!--", out))
        else if c == "-" && at (i + 1) == "-" && at (i + 2) == ">" then
          go (i + 3) (Cons (Bare "-->", out))
        // A unicode range, and it competes with the identifier `u` — so it is asked
        // first, the way the standard asks about `-->` before `--`.
        //
        // Two things the corpus says outright and are worth not repairing: the range is
        // not validated and not clamped. `U+100000-2` is a range from 1048576 to 2, and
        // `u+??????` ends at 0xFFFFFF, past the last code point there is. Whether a range
        // is usable is a question for whoever reads it; the tokenizer's job is to say
        // what was written.
        else if (c == "u" || c == "U") && at (i + 1) == "+"
                && (_is_hex (at (i + 2)) || at (i + 2) == "?") then
          let rec hexs = fn (k: int) -> fn (v: int) -> fn (cnt: int) ->
            if cnt >= 6 || not (_is_hex (at k)) then (k, v, cnt)
            else hexs (k + 1) (v * 16 + _hexval (at k)) (cnt + 1) in
          let (k1, v1, d) = hexs (i + 2) 0 0 in
          // Six characters between the digits and the question marks together, which is
          // why `U+1??????` is a range with five of them and a leftover `?`.
          let rec qs = fn (k: int) -> fn (cnt: int) ->
            if d + cnt >= 6 || at k != "?" then (k, cnt)
            else qs (k + 1) (cnt + 1) in
          let (k2, q) = qs k1 0 in
          let emit = fn (lo: int) -> fn (hi: int) -> fn (e: int) ->
            go e (Cons (Named ("unicode-range",
                               str_of_int lo ++ chr 1 ++ str_of_int hi), out)) in
          // A question mark is the wildcard, so it fills with zeros for the start and
          // with fs for the end: `u+1?` is 0x10 through 0x1F. Getting that fill backwards
          // or off by a digit is the only bug this token has.
          if q > 0 then
            let rec fill = fn (v: int) -> fn (m: int) -> fn (cnt: int) ->
              if cnt <= 0 then v else fill (v * 16 + m) m (cnt - 1) in
            emit (fill v1 0 q) (fill v1 15 q) k2
          // A wildcard and an explicit end are exclusive: after `u+1?` a dash is not part
          // of the range, which is why `U+1?-50` is a range and then the number -50.
          else if at k2 == "-" && _is_hex (at (k2 + 1)) then
            let (k3, v2, _d2) = hexs (k2 + 1) 0 0 in
            emit v1 v2 k3
          else emit v1 v1 k2
        else if _starts_ident i then
          let (v, e) = name_from i in
          // A name followed by `(` is a function, and the parenthesis belongs to it —
          // except `url(`, which is its own token unless what follows is a quote. That
          // exception exists because a URL is not a CSS value: it may contain
          // parentheses, slashes and colons that no other component value would
          // survive, so the tokenizer stops interpreting until the closing bracket.
          // With a quote it *is* a string, and then `url` is an ordinary function.
          if at e != "(" then go e (Cons (Named ("ident", v), out))
          else if to_lower v != "url" then go (e + 1) (Cons (Named ("function", v), out))
          else
            let rec skip_ws = fn (k: int) -> if _is_ws (at k) then skip_ws (k + 1) else k in
            let b0 = skip_ws (e + 1) in
            if at b0 == "\"" || at b0 == "'" then
              go (e + 1) (Cons (Named ("function", v), out))
            else
              // Built as it is scanned, like a name, because an escape inside a url
              // still stands for something other than its own characters. It is the one
              // thing a url has to interpret — everything else it copies, which is the
              // point of it being its own token.
              // Whitespace inside a url may only be trailing: once it has appeared,
              // the only things allowed are the closing bracket and the end of the
              // input. Anything else is a bad-url, and the remnants are consumed to the
              // bracket — a url with a space in the middle was never a url, and
              // guessing which half was meant is worse than saying so.
              let rec upto = fn (k: int) -> fn (acc: str) -> fn (ws: bool) ->
                if k >= n || at k == ")" then (k, acc, false)
                else if at k == "\\" && esc_ok k then
                  if ws then (k, acc, true)
                  else let (t, k2) = esc_at k in upto k2 (acc ++ t) ws
                else if _is_ws (at k) then upto (k + 1) acc true
                else if ws then (k, acc, true)
                // A url is copied rather than parsed, but not everything may appear in
                // one: a quote or an opening bracket means the author wrote something
                // else and meant it, so it is a bad-url rather than a url containing a
                // quote.
                else if at k == "(" || at k == "\"" || at k == "'" then (k, acc, true)
                // A non-printable character is not something a URL contains either. The
                // list is the standard's: the C0 controls that are not whitespace, and
                // DEL.
                else if ord (at k) < 32 || ord (at k) == 127 then (k, acc, true)
                else upto (k + 1) (acc ++ at k) ws in
              let (ue0, v, bad) = upto b0 "" false in
              if bad then
                let rec rest = fn (k: int) -> if k >= n || at k == ")" then k else rest (k + 1) in
                let re = rest ue0 in
                go (if re >= n then re else re + 1)
                   (Cons (Named ("error", "bad-url"), out))
              else
              let ue = ue0 in
              let u = Named ("url", v) in
              // A url that runs off the end of the input is still a url, plus an error
              // saying it never closed — the same shape as an unterminated string, and
              // for the same reason: a stylesheet missing one bracket should not lose
              // everything after it.
              if ue >= n then go ue (Cons (Named ("error", "eof-in-url"), Cons (u, out)))
              else go (ue + 1) (Cons (u, out))
        // The two-character tokens. Each is one delimiter and not two, because each
        // means something as a pair that neither half means alone — the attribute
        // selectors and the column combinator. Writing them as pairs of delims would
        // hand the selector parser two tokens to put back together.
        else if (c == "~" || c == "|" || c == "^" || c == "$" || c == "*")
                && at (i + 1) == "=" then
          go (i + 2) (Cons (Bare (c ++ "="), out))
        else if c == "|" && at (i + 1) == "|" then go (i + 2) (Cons (Bare "||", out))
        else go (i + 1) (Cons (Bare c, out)) in
    go 0 Nil;

  let _mirror = fn (c: str) ->
    // A brace has to be escaped in a Mere string: `{` opens an interpolation.
    if c == "(" then ")" else if c == "[" then "]" else if c == "\{" then "}" else "";

  // The second half of the standard's parsing, and a separate pass on purpose: the
  // standard draws the line in the same place. A tokenizer answers "what is this token";
  // only a parser can answer "what is this token inside of", and the answer needs a stack
  // that a scanner producing one token at a time does not have.
  let parse = fn (ts0: cval list) ->
    // `close` is what ends this level — "" at the top, where only the input's end does.
    let rec upto = fn (close: str) -> fn (ts: cval list) ->
      match ts with
      // A block still open at the end of the input simply closes, with no error token.
      // The corpus says so outright: `@media print { (foo]{bar) }baz` ends with two blocks
      // open and errors only for the mismatched closers inside them.
      | Nil -> (Nil, Nil)
      | Cons (t, rest) ->
        let more = fn (v: cval) -> fn (r: cval list) ->
          let (ks, r2) = upto close r in (Cons (v, ks), r2) in
        match t with
        | Bare s ->
          if s == close then (Nil, rest)
          else if s == "(" || s == "[" || s == "\{" then
            let (kids, r) = upto (_mirror s) rest in
            more (Block (s ++ _mirror s, kids)) r
          // A closer that is not this level's is an error even when it matches a level
          // further out. In `(foo]{bar)` the `)` sits inside a `{}` and is an error there;
          // the `{}` is closed by the `}` after it and the `()` by nothing at all. A
          // parser that let a closer reach past its own block would shut two brackets with
          // one and move everything after it into the wrong place.
          else if s == ")" || s == "]" || s == "}" then more (Named ("error", s)) rest
          else more t rest
        | Named (k, v) ->
          // The tokenizer already decided this was a function rather than an ident and a
          // bracket, because that decision needs to see there is no space between them.
          // What is left for here is finding where it ends.
          if k == "function" then
            let (kids, r) = upto ")" rest in more (Func (v, kids)) r
          else more t rest
        // Neither can appear in a token list. Parsing a parsed list leaves them alone,
        // which makes `parse` idempotent rather than wrong on its own output.
        | Block (_b, _k) -> more t rest
        | Func (_f, _k) -> more t rest in
    let (vs, _r) = upto "" ts0 in vs;

  // Bytes to component values, which is what a caller wants and what the suite's level
  // is named after.
  let values = fn (src: str) -> parse (tokenize src);

  // One line per component value, in the shape the harness compares. `pad` is the
  // indentation this level sits at, which the rule levels above need: a declaration's value
  // is component values printed two levels in, and they should print the same way there as
  // at the top or the form is two forms.
  let render_at = fn (pad0: str) -> fn (vs: cval list) ->
    let esc = fn (s: str) ->
      let rec e = fn (i: int) -> fn (o: str) ->
        if i >= str_len s then o
        else
          let c = char_at s i in
          e (i + 1) (o ++ (if c == "\\" then "\\\\" else if c == "\t" then "\\t"
                           else if c == "\n" then "\\n" else if c == "\r" then "\\r"
                           else c)) in
      e 0 "" in
    // A tree is its root line and then its children, two spaces deeper. The same shape
    // the DOM serializer uses, for the same reason: a diff of it can be read.
    let rec block = fn (pad: str) -> fn (vs: cval list) ->
      let rec go = fn (vs: cval list) -> fn (acc: str list) ->
        match vs with
        | Nil -> list_rev acc
        | Cons (v, rest) ->
          let row =
            match v with
            | Bare s -> pad ++ "B\t" ++ esc s
            // The extra fields of a number, a hash or a range come through joined by
            // U+0001 rather than by a tab, because `esc` turns a tab into two characters
            // and a field separator the escaping eats is not a separator. Translated
            // here, after escaping.
            | Named (k, s) -> pad ++ "N\t" ++ k ++ "\t" ++ str_replace (esc s) (chr 1) "\t"
            | Block (b, kids) ->
              (match kids with
               | Nil -> pad ++ "K\t" ++ b
               | Cons (_x, _xs) -> pad ++ "K\t" ++ b ++ "\n" ++ block (pad ++ "  ") kids)
            | Func (f, kids) ->
              (match kids with
               | Nil -> pad ++ "F\t" ++ esc f
               | Cons (_x, _xs) -> pad ++ "F\t" ++ esc f ++ "\n" ++ block (pad ++ "  ") kids) in
          go rest (Cons (row, acc)) in
      str_join "\n" (go vs Nil) in
    block pad0 vs;

  let render = fn (vs: cval list) -> render_at "" vs;
}
