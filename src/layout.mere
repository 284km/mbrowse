// Layout: a DOM in, a box per element out.
//
// **Normal flow for block boxes, with the box model and collapsing margins.** No floats, no
// positioning, no text measurement. Those are the next three slices and the gate says what each
// is worth before it is written, which is why the gate was built first.
//
// The recursion is bottom-up and then shifted. A box cannot be placed until its own top margin
// is known, and its top margin may have collapsed with its first child's, which is not known
// until the child is laid out — so children are laid out at coordinates relative to their
// parent's border box and the whole fragment is moved once its position is settled. Trying to
// place absolutely on the way down means guessing the margin and correcting later, and a
// correction pass is a second place where the answer is decided.

import "dom.mere";
import "style.mere";

// A laid-out box. `x` and `y` are document coordinates by the time `boxes` returns — the gate
// compares against `getBoundingClientRect`, which is absolute — and they are the BORDER box,
// which is what that call reports.
type box = { tag: str, x: int, y: int, w: int, h: int };

// A subtree becomes four things: its boxes relative to its own border-box top-left, the border
// box's height, and the two margins that ESCAPE it — a margin that collapsed through this box
// belongs to whoever places it, and that is the whole reason this is not just a box list.
//
// Returned as a tuple rather than a record because `_stack` and `_block` are mutually recursive
// and this language will not infer a record type across that boundary. A tuple destructures
// without needing one.

module Layout {
  // The viewport the gate's expectations were taken in. A constant rather than a parameter
  // because it is part of what the expected values MEAN: change it and every number in
  // `test/data/layout/*.expected` is wrong, so both have to change together and a default hides
  // that.
  let viewport_w = 800;

  let _shift = fn (bs: box list) -> fn (dx: int) -> fn (dy: int) ->
    list_map bs (fn (b: box) ->
      box { tag = b.tag, x = b.x + dx, y = b.y + dy, w = b.w, h = b.h });

  // Two adjoining margins collapse to one. Positive against positive is the larger; a negative
  // is added to the largest positive rather than compared with it, which is the standard's rule
  // and not the obvious one.
  let _collapse = fn (a: int) -> fn (b: int) ->
    let pos = if a > b then a else b in
    let mx = if pos < 0 then 0 else pos in
    let na = if a < 0 then a else 0 in
    let nb = if b < 0 then b else 0 in
    let mn = if na < nb then na else nb in
    mx + mn;

  let _attr = fn (attrs: attr list) -> fn (name: str) ->
    let rec go = fn (xs: attr list) ->
      match xs with
      | Nil -> ""
      | Cons (a, rest) -> if to_lower a.name == name then a.value else go rest in
    go attrs;

  // The document's own stylesheets, which for these documents means the text inside every
  // `<style>` element. Collected in one walk before layout starts rather than looked for during
  // it: a stylesheet is a property of the document, and finding it while placing boxes would
  // mean finding it once per box.
  let rec author_css = fn (ns: node list) -> fn (acc: str) ->
    match ns with
    | Nil -> acc
    | Cons (n, rest) ->
      match n with
      | Element (tag, _a, kids) ->
        if to_lower tag == "style" then
          let rec text_of = fn (xs: node list) -> fn (s: str) ->
            match xs with
            | Nil -> s
            | Cons (k, more) ->
              match k with
              | Text t -> text_of more (s ++ t)
              | _ -> text_of more s in
          author_css rest (acc ++ "\n" ++ text_of kids "")
        else author_css rest (author_css kids acc)
      | _ -> author_css rest acc;

  // One element's resolved style. The three origins in the order the cascade wants them: the UA
  // sheet loses to the author's sheet whatever the selectors say, and an inline `style=` beats
  // both. Encoded in the specificity, so `winner` needs to know nothing about origins.
  let style_of = fn (ua: prepared list) -> fn (author: prepared list) ->
                 fn (e: elem) -> fn (ancestors: elem list) -> fn (inline: str) ->
    let h1 = Style.hits_for ua 0 e ancestors 0 in
    let h2 = Style.hits_for author 1 e ancestors 0 in
    let h3 =
      // An inline `style=` is a declaration list with no selector, so it is given a specificity
      // above every selector rather than a place in the cascade of its own.
      list_map (list_filter (Rules.declaration_list inline)
                            (fn (r: rule) -> match r with Decl (_n, _v, _i) -> true | _ -> false))
               (fn (r: rule) ->
                  match r with
                  | Decl (name, value, _i) ->
                    hit { prop = to_lower name, value = Style.value_text value,
                          spec = 2 * 100000, order = 0 }
                  | _ -> hit { prop = "", value = "", spec = 0, order = 0 }) in
    Style.resolve (list_append h1 (list_append h2 h3)) e.tag;

  let _elem_of = fn (tag: str) -> fn (attrs: attr list) ->
    elem { tag = to_lower tag, id = _attr attrs "id", cls = to_lower (_attr attrs "class") };

  // A list of siblings, stacked. `cbw` is the containing block's content width; `open_mb` is the
  // bottom margin left hanging by whatever came before. `swallow_first` says that the first
  // child's top margin belongs to the PARENT and must not become a gap here — the parent asks
  // for that when nothing separates its content edge from its border edge.
  //
  // Four things come back, and the fourth is the reason this is not a fold: the first child's
  // escaped top margin, which the parent needs to know its own.
  let rec _stack = fn (ua: prepared list) -> fn (author: prepared list) ->
                   fn (ancestors: elem list) -> fn (ns: node list) -> fn (cbw: int) ->
                   fn (y: int) -> fn (open_mb: int) -> fn (swallow_first: bool) ->
                   fn (first_mt: int) -> fn (seen: bool) -> fn (acc: box list) ->
    match ns with
    | Nil -> (list_rev acc, y, open_mb, first_mt)
    | Cons (n, rest) ->
      match n with
      | Element (tag, attrs, kids) ->
        let e = _elem_of tag attrs in
        let st = style_of ua author e ancestors (_attr attrs "style") in
        if st.display == "none" then
          _stack ua author ancestors rest cbw y open_mb swallow_first first_mt seen acc
        else
          let (fbs, fh, fmt, fmb) = _block ua author ancestors tag attrs kids cbw st in
          let is_first = not seen in
          // The gap above this box is the two margins collapsed into one, not their sum. When the
          // parent has claimed the first child's margin there is no gap at all here.
          let gap = if is_first && swallow_first then 0 else _collapse open_mb fmt in
          let top = y + gap in
          let bs = _shift fbs 0 top in
          _stack ua author ancestors rest cbw (top + fh) fmb swallow_first
                 (if is_first then fmt else first_mt) true
                 (list_append (list_rev bs) acc)
      // Text and comments generate no box yet. A line of text needs a font metric to have a
      // height, and there is none — zero here is the absence of a measurement, not a guess at one.
      | _ -> _stack ua author ancestors rest cbw y open_mb swallow_first first_mt seen acc

  // One block box and everything under it, at coordinates relative to its own border box.
  and _block = fn (ua: prepared list) -> fn (author: prepared list) ->
               fn (ancestors: elem list) -> fn (tag: str) -> fn (attrs: attr list) ->
               fn (kids: node list) -> fn (cbw: int) -> fn (st: sty) ->
    // A block box fills its containing block unless it says otherwise. `width` is the CONTENT
    // width, so the border box is wider by its own borders and padding — that difference is what
    // `getBoundingClientRect` reports and the place a box model is usually wrong.
    let pct = if st.w_pct >= 0 then (cbw * st.w_pct) / 100 else 0 - 1 in
    let content_w =
      if pct >= 0 then pct
      else if st.w >= 0 then st.w
      else cbw - st.ml - st.mr - st.bl - st.br - st.pl - st.pr in
    let cw = if content_w < 0 then 0 else content_w in
    let e = _elem_of tag attrs in
    let inner_ancestors = Cons (e, ancestors) in
    // A parent's margin collapses with its first or last child's when nothing separates them —
    // no border and no padding on that side, and for the bottom, no stated height either. When
    // something does separate them the child's margin stays inside.
    // The root element is the third reason a margin does not collapse, and it is not a property
    // of the box: the standard says the root's margins simply do not collapse with anything. With
    // it missing, the body's margin escaped out of `<html>` and pushed the document itself down.
    let is_root = match ancestors with Nil -> true | Cons (_x, _y) -> false in
    let sep_top = is_root || st.bt > 0 || st.pt > 0 in
    let sep_bot = is_root || st.bb > 0 || st.pb > 0 || st.h >= 0 in
    let (bs, used, open_mb, first_mt) =
      _stack ua author inner_ancestors kids cw 0 0 (not sep_top) 0 false Nil in
    // The fragment's origin is (the containing block's content left, this border box's top): x is
    // measured from outside the margin because a horizontal margin is an offset, y from the border
    // box because a vertical one collapsed into the gap above. So a child clears this box's own
    // left margin as well as its border and padding — leaving `st.ml` out put every nested box at
    // the wrong x and only the outermost one right.
    let inner = _shift bs (st.ml + st.bl + st.pl) (st.bt + st.pt) in
    // The margin still hanging at the end is inside this box only if something separates it from
    // the bottom edge; otherwise it escapes and is the parent's to place.
    let content_h = if st.h >= 0 then st.h
                    else if sep_bot then used + (if open_mb > 0 then open_mb else 0)
                    else used in
    let h = st.bt + st.pt + content_h + st.pb + st.bb in
    let me = box { tag = to_lower tag, x = st.ml, y = 0,
                   w = st.bl + st.pl + cw + st.pr + st.br, h = h } in
    (Cons (me, inner), h,
     (if sep_top then st.mt else _collapse st.mt first_mt),
     (if sep_bot then st.mb else _collapse st.mb open_mb));

  let boxes = fn (roots: node list) ->
    let ua = Style.prepare Style.ua_sheet in
    let author = Style.prepare (author_css roots "") in
    // The initial containing block is the viewport. Its own margin does not collapse out of the
    // document, so the root's top margin starts the stack rather than escaping it.
    let (bs, _y, _mb, _fm) = _stack ua author Nil roots viewport_w 0 0 false 0 false Nil in
    bs;

  // The canonical form the gate compares, one line per box in document order.
  let render = fn (bs: box list) ->
    let one = fn (b: box) ->
      b.tag ++ "\t" ++ str_of_int b.x ++ "\t" ++ str_of_int b.y
      ++ "\t" ++ str_of_int b.w ++ "\t" ++ str_of_int b.h in
    str_join "\n" (list_map bs one);
}
