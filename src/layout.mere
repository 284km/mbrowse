// Layout: a DOM in, a box per element out.
//
// **Normal flow for block boxes, with the box model and collapsing margins.** No floats, no
// positioning, no text measurement. Those are the next three slices and the gate says what each
// is worth before it is written, which is why the gate was built first.
//
// The recursion is bottom-up and then shifted. A box cannot be placed until its own top margin
// is known, and its top margin may have collapsed with its first child's, which is not known
// until the child is laid out — so children are laid out at coordinates relative to their
// parent's border box and the whole fragment is moved once its position is settled. Trying to
// place absolutely on the way down means guessing the margin and correcting later, and a
// correction pass is a second place where the answer is decided.

import "dom.mere";
import "style.mere";
import "font.mere";
import "./jpeg.mere";
import "./img.mere";

// A laid-out box. `x` and `y` are document coordinates by the time `boxes` returns — the gate
// compares against `getBoundingClientRect`, which is absolute — and they are the BORDER box,
// which is what that call reports.
// `pinned` means the box's Y is already the page's and no ancestor may move it. Exactly one thing needs
// it: an absolutely positioned box whose ancestors are all static is placed against the INITIAL
// containing block, and this file lays everything out relative and shifts once — so the only way to say
// "82 from the page" in a system with no absolute origin is to opt out of the shifting.
//
// Two pins and not one, because the two axes are answered by two different properties. `top` says
// where the Y is and `left` says where the X is, and a box may state one and leave the other `auto` —
// so a single flag either dragged the static X to the page origin or let an absolute `left` be shifted
// by every container above it. A `left: 7.5em` box in a body indented by 2em came out at 152 where the
// page says 120.
// `cp` is a CODE POINT when this box is one character's own area, and 0 when it is an element's.
// Text is not a special kind of thing to lay out — a glyph occupies a rectangle exactly as an element
// does — so it is the same record, and the two are told apart by asking rather than by keeping two
// lists that could disagree about where a line was.
type box = { tag: str, x: int, y: int, w: int, h: int, pinned: bool, pinx: bool, cp: int,
             // What to paint it with. `fg` is the ink a glyph is drawn in; `bg` is what an element
             // fills its border box with, or -1 for nothing. A box carries them so that painting is a
             // walk over one list and not a second walk over the tree asking the cascade again.
             fg: int, bg: int,
             // The size a glyph's text was set in. A painter needs it to scale the outline, and it
             // cannot be recovered from the box: the height is the font's line height at that size,
             // and rounding makes that a many-to-one map.
             fs: int,
             // Which pass of the painter this box belongs to. CSS 2.1 Appendix E is a LIST, and the
             // list is not document order: every block-level background is painted before any
             // inline-level content, so an inline-block cannot be covered by a block that comes after
             // it. 3 is block-level in flow, 4 is a float, 5 is inline-level in flow. The numbers are
             // Appendix E's own step numbers so that the list can be read beside it.
             layer: int,
             // The border: one colour and the four widths, because a painter cannot get them from the
             // geometry — the box it is given is the border box, and where the border ENDS is inside
             // it by an amount only the style knows.
             bc: int, bt: int, br: int, bb: int, bl: int,
             // The image to draw in it, already resolved against the document's directory, or "" for
             // a box that is not a replaced element. Resolved HERE and not in the painter because
             // resolving it needs to know where the document was, and the painter is given a list of
             // boxes and no document.
             src: str };

// A subtree becomes four things: its boxes relative to its own border-box top-left, the border
// box's height, and the two margins that ESCAPE it — a margin that collapsed through this box
// belongs to whoever places it, and that is the whole reason this is not just a box list.
//
// Returned as a tuple rather than a record because `_stack` and `_block` are mutually recursive
// and this language will not infer a record type across that boundary. A tuple destructures
// without needing one.

module Layout {
  // The viewport the gate's expectations were taken in. A constant rather than a parameter
  // because it is part of what the expected values MEAN: change it and every number in
  // `test/data/layout/*.expected` is wrong, so both have to change together and a default hides
  // that.
  let viewport_w = 800;

  // The one font size there is, because `font-size` is not resolved yet. It is the initial value and the
  // size the gate's expectations were taken at; when font-size lands this becomes a computed value and
  // this constant goes.
  let font_size = 16;

  // The displays that make a box block-level in its parent's flow. The table families are here because
  // an anonymous table is generated around them wherever one is missing, and an anonymous table is a
  // block.
  let _is_block_level = fn (d: str) ->
    // NOT `inline-block`, which is inline-LEVEL: it takes a place on a line rather than a line of
    // its own. It was here, and being here is what gave it one.
    d == "block" || d == "table" || d == "table-cell" || d == "table-row"
    || d == "table-row-group" || d == "table-caption";

  // The same style with its HORIZONTAL edges removed, and only those. The vertical ones do not belong
  // to the block piece either, and taking them out makes the block land at the right y while making the
  // inline's own box shorter — and the inline is already short of the 49 the split produces. Neither
  // choice moves the gate; this one leaves each box individually closer to the browser, which is the
  // tie-break when the count cannot decide.
  //
  // The same style with its horizontal edges removed. Written out because a record here is replaced
  // whole, and the alternative — a flag threaded into `_block` — would put the special case in the
  // general path instead of at the one call site that needs it.
  // The same style with an explicit width. A float and an inline-block are sized by their contents, not
  // by their container, and the sizing code takes its answer from the style — so the shrink-to-fit width
  // is put there rather than threaded in as a special case.
  let _with_width = fn (st: sty) -> fn (w: int) ->
    sty { display = st.display, position = st.position, float_ = st.float_, spacing = st.spacing, spacing_v = st.spacing_v,
          overflow = st.overflow, valign = st.valign, left = st.left, top = st.top,
          // A shrink-to-fit width is a CONTENT width by construction — it was measured from the
          // contents — so the box it is put into has to be told to read it as one.
          bsz = "content-box", fs = st.fs, lh_px = st.lh_px, lh_num = st.lh_num, dir = st.dir,
          ws = st.ws, ti_px = st.ti_px, ti_pct = st.ti_pct, color = st.color, bg = st.bg,
          w = w, h = st.h, w_pct = st.w_pct, h_pct = st.h_pct,
          mt = st.mt, mr = st.mr, mb = st.mb, ml = st.ml,
          pt = st.pt, pr = st.pr, pb = st.pb, pl = st.pl,
          bt = st.bt, br = st.br, bb = st.bb, bl = st.bl, bc = st.bc, layer = st.layer };

  // The same box list with an ANONYMOUS box added for the picture itself.
  //
  // Not the element's own box, and that distinction is the whole of it. `getBoundingClientRect` — and
  // so every expectation in `test/data/img` — reports the BORDER box, but the picture goes in the
  // CONTENT box, inside the padding and the border. Painting it at the element's own rectangle put it
  // over its own padding, which is invisible until something has padding and then is forty rows wrong.
  //
  // An anonymous box is what CSS calls a box with no element behind it, and the box sequence gate
  // filters on exactly that: a box with no tag is not an element and is not in the sequence.
  let _img_box = fn (bs: box list) -> fn (st: sty) -> fn (src: str) ->
    match bs with
    | Nil -> Nil
    | Cons (b, rest) ->
      Cons (b, Cons (box { tag = "", x = b.x + st.bl + st.pl, y = b.y + st.bt + st.pt,
                           w = b.w - st.bl - st.br - st.pl - st.pr,
                           h = b.h - st.bt - st.bb - st.pt - st.pb,
                           pinned = b.pinned, pinx = b.pinx, cp = 0, fg = 0, bg = 0 - 1, fs = 0,
                           layer = b.layer, bc = 0, bt = 0, br = 0, bb = 0, bl = 0, src = src }, rest));

  // A replaced element's style with the size it actually took.
  //
  // Which box that size names is the whole subtlety. A size that came from the FILE is a content size
  // and has to be read as one, or a padding of four would eat eight pixels of picture instead of
  // sitting outside it. A size the PAGE stated is whatever `box-sizing` says it is, and overriding
  // that to content-box turned a `box-sizing: border-box` image of 60 by 40 into 72 by 52 — the
  // padding and border added on the outside of a number that already included them.
  let _with_size = fn (st: sty) -> fn (bsz: str) -> fn (w: int) -> fn (h: int) ->
    sty { display = st.display, position = st.position, float_ = st.float_, spacing = st.spacing, spacing_v = st.spacing_v,
          overflow = st.overflow, valign = st.valign, left = st.left, top = st.top,
          bsz = bsz, fs = st.fs, lh_px = st.lh_px, lh_num = st.lh_num, dir = st.dir,
          ws = st.ws, ti_px = st.ti_px, ti_pct = st.ti_pct, color = st.color, bg = st.bg,
          w = w, h = h, w_pct = st.w_pct, h_pct = st.h_pct,
          mt = st.mt, mr = st.mr, mb = st.mb, ml = st.ml,
          pt = st.pt, pr = st.pr, pb = st.pb, pl = st.pl,
          bt = st.bt, br = st.br, bb = st.bb, bl = st.bl, bc = st.bc, layer = st.layer };

  // The same style with a border on every side, for a cell in a table that carries `border`. HTML says
  // the attribute puts a border on the table AND one pixel on every cell in it, which is a statement
  // about DESCENDANTS that an attribute on one element cannot make on its own — so it is made here,
  // where the table is laying its cells out and knows both.
  let _with_border = fn (st: sty) -> fn (w: int) ->
    sty { display = st.display, position = st.position, float_ = st.float_, spacing = st.spacing, spacing_v = st.spacing_v,
          overflow = st.overflow, valign = st.valign, left = st.left, top = st.top,
          bsz = st.bsz, fs = st.fs, lh_px = st.lh_px, lh_num = st.lh_num, dir = st.dir,
          ws = st.ws, ti_px = st.ti_px, ti_pct = st.ti_pct, color = st.color, bg = st.bg,
          w = st.w, h = st.h, w_pct = st.w_pct, h_pct = st.h_pct,
          mt = st.mt, mr = st.mr, mb = st.mb, ml = st.ml,
          pt = st.pt, pr = st.pr, pb = st.pb, pl = st.pl,
          bt = w, br = w, bb = w, bl = w, bc = 0, layer = st.layer };

  let _no_h_edges = fn (st: sty) ->
    sty { display = st.display, position = st.position, float_ = st.float_, spacing = st.spacing, spacing_v = st.spacing_v,
          overflow = st.overflow, valign = st.valign, left = st.left, top = st.top,
          bsz = st.bsz, fs = st.fs, lh_px = st.lh_px, lh_num = st.lh_num, dir = st.dir,
          ws = st.ws, ti_px = st.ti_px, ti_pct = st.ti_pct, color = st.color, bg = st.bg,
          w = st.w, h = st.h, w_pct = st.w_pct, h_pct = st.h_pct,
          mt = st.mt, mr = st.mr, mb = st.mb, ml = st.ml,
          pt = st.pt, pr = 0, pb = st.pb, pl = 0,
          bt = st.bt, br = 0, bb = st.bb, bl = 0, bc = 0, layer = st.layer };

  // The line height a box's own style asks for, in pixels: a bare number times its own font size, a
  // length as it computed, and the font's own when it said `normal`. The number and the length are
  // kept apart all the way from the cascade to here because only the number is re-multiplied.
  let nth_str = fn (l: str list) -> fn (i: int) ->
    let rec go = fn (r: str list) -> fn (k: int) ->
      match r with Nil -> "" | Cons (v, rest) -> if k == 0 then v else go rest (k - 1) in
    go l i;

  let _lh_of = fn (f: font) -> fn (st: sty) ->
    if st.lh_px >= 0 then st.lh_px
    else if st.lh_num >= 0.0 then int_of_float (st.lh_num * float_of_int st.fs + 0.5)
    else Font.line_height f st.fs;

  let _shift = fn (bs: box list) -> fn (dx: int) -> fn (dy: int) ->
    list_map bs (fn (b: box) ->
      box { tag = b.tag, x = if b.pinx then b.x else b.x + dx,
            y = if b.pinned then b.y else b.y + dy,
            w = b.w, h = b.h, pinned = b.pinned, pinx = b.pinx, cp = b.cp,
            fg = b.fg, bg = b.bg, fs = b.fs, layer = b.layer, bc = b.bc, bt = b.bt, br = b.br, bb = b.bb, bl = b.bl, src = b.src });

  // Two adjoining margins collapse to one. Positive against positive is the larger; a negative
  // is added to the largest positive rather than compared with it, which is the standard's rule
  // and not the obvious one.
  let _collapse = fn (a: int) -> fn (b: int) ->
    let pos = if a > b then a else b in
    let mx = if pos < 0 then 0 else pos in
    let na = if a < 0 then a else 0 in
    let nb = if b < 0 then b else 0 in
    let mn = if na < nb then na else nb in
    mx + mn;

  let _attr = fn (attrs: attr list) -> fn (name: str) ->
    let rec go = fn (xs: attr list) ->
      match xs with
      | Nil -> ""
      | Cons (a, rest) -> if to_lower a.name == name then a.value else go rest in
    go attrs;

  // Whether the attribute is PRESENT, which is not the same question as what its value is: `border=""`
  // and no `border` at all both read as the empty string, and HTML gives them opposite meanings.
  let _has_attr = fn (attrs: attr list) -> fn (name: str) ->
    let rec go = fn (xs: attr list) ->
      match xs with
      | Nil -> false
      | Cons (a, rest) -> if to_lower a.name == name then true else go rest in
    go attrs;

  // The document's own stylesheets, which for these documents means the text inside every
  // `<style>` element. Collected in one walk before layout starts rather than looked for during
  // it: a stylesheet is a property of the document, and finding it while placing boxes would
  // mean finding it once per box.
  let rec author_css = fn (ns: node list) -> fn (acc: str) ->
    match ns with
    | Nil -> acc
    | Cons (n, rest) ->
      match n with
      | Element (tag, _a, kids) ->
        if to_lower tag == "style" then
          let rec text_of = fn (xs: node list) -> fn (s: str) ->
            match xs with
            | Nil -> s
            | Cons (k, more) ->
              match k with
              | Text t -> text_of more (s ++ t)
              | _ -> text_of more s in
          author_css rest (acc ++ "\n" ++ text_of kids "")
        else author_css rest (author_css kids acc)
      | _ -> author_css rest acc;

  // One element's resolved style. The three origins in the order the cascade wants them: the UA
  // sheet loses to the author's sheet whatever the selectors say, and an inline `style=` beats
  // both. Encoded in the specificity, so `winner` needs to know nothing about origins.
  // `pst` is the PARENT's computed style. Inheritance is a property of the tree WALK — a value travels
  // from a parent to a child once — and every caller here is already standing at that edge, so handing
  // it over costs nothing and asking for it costs the depth of the tree per property.
  let style_of = fn (ua: prepared list) -> fn (author: prepared list) ->
                 fn (e: elem) -> fn (ancestors: elem list) -> fn (inline_css: str) -> fn (pst: sty) ->
    // `inline_css`, because `inline` is a C keyword and this parameter becomes a struct field
    // in the generated C. See Q-18.
    let h1 = Style.hits_for ua 0 e ancestors 0 in
    let h2 = Style.hits_for author 1 e ancestors 0 in
    let h3 =
      // An inline `style=` is a declaration list with no selector, so it is given a specificity
      // above every selector rather than a place in the cascade of its own.
      list_map (list_filter (Rules.declaration_list inline_css)
                            (fn (r: rule) -> match r with Decl (_n, _v, _i) -> true | _ -> false))
               (fn (r: rule) ->
                  match r with
                  | Decl (name, value, _i) ->
                    hit { prop = to_lower name, value = Style.value_text value,
                          spec = 2 * 100000, order = 0 }
                  | _ -> hit { prop = "", value = "", spec = 0, order = 0 }) in
    let hp = Style.pres_hits e.pres in
    Style.resolve (list_append h1 (list_append hp (list_append h2 h3))) e.tag pst;

  // The presentational attributes, written as the CSS that HTML says they mean. This is a LAYER that
  // was missing rather than a bug: the cascade never saw `height="200"` or `valign="bottom"` at all,
  // because nothing turned them into declarations, and six documents in the corpus are laid out from
  // attributes alone.
  //
  // Only what the corpus asks for, and it is worth saying which: `width` and `height` on the elements
  // that take them, `valign` on a cell, `border` and `cellspacing` on a table. `align`, `bgcolor`,
  // `cellpadding` and the rest are not here — `cellpadding` in particular cannot be, because it says
  // something about DESCENDANTS and an attribute on one element cannot reach them.
  let _pres_of = fn (tag: str) -> fn (attrs: attr list) ->
    let t = to_lower tag in
    // A number alone means pixels; a percentage stays one. Anything else is not a value and is dropped,
    // which is what "the attribute must be a valid non-negative integer" comes to.
    let dim = fn (v: str) ->
      if v == "" then ""
      else
        let n = str_len v in
        let rec digits = fn (i: int) ->
          if i >= n then i
          else if char_at v i >= "0" && char_at v i <= "9" then digits (i + 1) else i in
        let e = digits 0 in
        if e == 0 then ""
        else if e == n then substring v 0 e ++ "px"
        else if substring v e n == "%" then v
        else "" in
    let one = fn (prop: str) -> fn (v: str) -> if v == "" then "" else prop ++ ": " ++ v ++ ";" in
    let sized = t == "table" || t == "td" || t == "th" || t == "tr" || t == "col"
                || t == "img" || t == "hr" in
    let cell = t == "td" || t == "th" || t == "tr" || t == "tbody" || t == "thead" || t == "tfoot" in
    (if sized then one "width" (dim (_attr attrs "width")) else "")
    ++ (if sized then one "height" (dim (_attr attrs "height")) else "")
    ++ (if cell then one "vertical-align" (to_lower (_attr attrs "valign")) else "")
    ++ (if t == "table" then one "border-spacing" (dim (_attr attrs "cellspacing")) else "")
    // `<table border>` with no value is a border of one pixel, and `border="0"` is none. The style is
    // part of it: a border with no style draws nothing and is zero wide, which this file already knows.
    ++ (if t == "table" && _has_attr attrs "border" then
          (let v = _attr attrs "border" in
           let w = if v == "" then "1px" else dim v in
           if w == "" || w == "0px" then "" else "border: " ++ w ++ " solid;")
        else "");

  // What an `<img>` is, as far as every other part of layout needs to know: a box with a width and a
  // height and no content. Working it out here and putting it in the style means the block path and
  // the line path both get it without either of them learning what an image is.
  // `cbw` is the containing block's width, because a percentage is against that and cannot have been
  // resolved in the cascade. It feeds the RATIO as well as the width — an image at `width: 25%` of a
  // 200-pixel box is 50 wide and then 33 tall, and the 33 comes from the 50 and not from the file.
  let _img_style = fn (docdir: str) -> fn (attrs: attr list) -> fn (cbw: int) -> fn (st: sty) ->
    let (iw, ih) = Img.size docdir (_attr attrs "src") in
    let pw = if st.w_pct >= 0 && cbw >= 0 then (cbw * st.w_pct) / 100 else st.w in
    let ph = if st.h_pct >= 0 then st.h else st.h in
    let (uw, uh) = Img.used iw ih pw ph in
    // Stated by the page, in either axis: then the number is in `box-sizing`'s terms. Stated in
    // neither: it came from the file and is a content size no matter what `box-sizing` says, because
    // `box-sizing` has no effect on a width of `auto` in the first place.
    //
    // One axis stated and the other derived from the ratio is the case the corpus does not have under
    // `border-box`, and CSS derives a ratio against the CONTENT box — so the derived axis would be in
    // the wrong terms here. Written down rather than guessed at.
    let stated = st.w >= 0 || st.w_pct >= 0 || st.h >= 0 || st.h_pct >= 0 in
    _with_size st (if stated then st.bsz else "content-box") uw uh;

  let _elem_of = fn (tag: str) -> fn (attrs: attr list) ->
    elem { tag = to_lower tag, id = _attr attrs "id", cls = to_lower (_attr attrs "class"),
           sty_attr = _attr attrs "style", pres = _pres_of tag attrs };

  // ---- inline content ------------------------------------------------------------

  // The text of an inline run, with white space collapsed the way CSS collapses it: every run of
  // spaces, tabs and newlines becomes one space. Source indentation is white space, so without this a
  // paragraph written over three lines of a file is three times wider than it looks.
  let rec _inline_text = fn (ns: node list) -> fn (acc: str) ->
    match ns with
    | Nil -> acc
    | Cons (n, rest) ->
      match n with
      | Text t -> _inline_text rest (acc ++ t)
      // An inline element contributes its own text to the same run. It is transparent to line
      // breaking, which is what makes `a <b>bold</b> word` break between `bold` and `word`.
      | Element (_tag, _a, kids) -> _inline_text rest (_inline_text kids acc)
      | Comment _c -> _inline_text rest acc
      | Doctype (_x, _y, _z) -> _inline_text rest acc;

  let _is_space = fn (c: str) ->
    c == " " || c == "\t" || c == "\n" || c == "\r" || c == chr 12;

  // Runs of white space to one space, and the two ends removed. The ends go because a line box drops
  // the white space at its edges, and for a single-line paragraph that is the whole rule.
  let _collapse_ws = fn (s0: str) ->
    let n = str_len s0 in
    let rec go = fn (i: int) -> fn (out: str) -> fn (was_space: bool) ->
      if i >= n then out
      else
        let c = char_at s0 i in
        if _is_space c then
          go (i + 1) (if was_space || out == "" then out else out ++ " ") true
        else go (i + 1) (out ++ c) false in
    let t = go 0 "" false in
    if str_len t > 0 && char_at t (str_len t - 1) == " " then substring t 0 (str_len t - 1)
    else t;

  // White space collapsed to single spaces, with the ends KEPT: a space at the edge of a text node is
  // not at the edge of a line when another node follows it.
  let _collapse_runs = fn (s0: str) ->
    let n = str_len s0 in
    let rec go = fn (i: int) -> fn (out: str) -> fn (was: bool) ->
      if i >= n then out
      else
        let c = char_at s0 i in
        if _is_space c then go (i + 1) (if was then out else out ++ " ") true
        else go (i + 1) (out ++ c) false in
    go 0 "" false;



  // How many lines this text takes at this width. Greedy, breaking at spaces, which is what the
  // standard's line breaking reduces to for text with no hyphens and no CJK — and this corpus has
  // neither. A word wider than the line gets its own line and overflows rather than being cut, which
  // is also what a browser does.
  let _line_count = fn (f: font) -> fn (text: str) -> fn (avail: int) -> fn (size: int) ->
    if text == "" then 0
    else if avail <= 0 then 1
    else
      let words = str_split text " " in
      let space = Font.text_units f " " in
      let cap = (avail * f.upem) / size in
      let rec go = fn (ws: str list) -> fn (cur: int) -> fn (lines: int) ->
        match ws with
        | Nil -> if cur > 0 then lines + 1 else (if lines == 0 then 1 else lines)
        | Cons (w, rest) ->
          let wu = Font.text_units f w in
          if cur == 0 then go rest wu lines
          else if cur + space + wu <= cap then go rest (cur + space + wu) lines
          // Measured in font units against a capacity in font units, so the comparison never rounds.
          // Comparing scaled pixels would break a line one word early or late depending on where the
          // rounding fell.
          else go rest wu (lines + 1) in
      go words 0 0;

  // How many lines a text takes in a capacity given in FONT UNITS. The pixel version rounds the
  // capacity first, which is wrong wherever the capacity was derived from the same text.
  let _lines_in_units = fn (f: font) -> fn (text: str) -> fn (cap: int) ->
    if text == "" then 0
    else if cap <= 0 then 1
    else
      let space = Font.text_units f " " in
      let rec go = fn (ws: str list) -> fn (cur: int) -> fn (lines: int) ->
        match ws with
        | Nil -> if cur > 0 then lines + 1 else (if lines == 0 then 1 else lines)
        | Cons (w, rest) ->
          let wu = Font.text_units f w in
          if cur == 0 then go rest wu lines
          else if cur + space + wu <= cap then go rest (cur + space + wu) lines
          else go rest wu (lines + 1) in
      go (str_split text " ") 0 0;

  // What `b` has that `a` does not, when `b` was built by appending to `a`.
  let rec _drop = fn (a: box list) -> fn (b: box list) ->
    match a with
    | Nil -> b
    | Cons (_x, ra) -> match b with Nil -> Nil | Cons (_y, rb) -> _drop ra rb;

  // The longest run of inline children at the head of a list, and what is left after it. One anonymous
  // block is made per run, which is what the standard says and also why the runs have to be maximal:
  // two anonymous blocks where there should be one puts a line break in the middle of a sentence.
  let rec _inline_run = fn (f: font) -> fn (docdir: str) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                        fn (pst: sty) ->
                        fn (anc: elem list) -> fn (ns: node list) ->
    let rec go = fn (xs: node list) -> fn (acc: node list) ->
      match xs with
      | Nil -> (list_rev acc, Nil)
      | Cons (n, rest) ->
        match n with
        | Element (tag, attrs, _k) ->
          let st = style_of ua author (_elem_of tag attrs) anc (_attr attrs "style") pst in
          if st.display == "none" then go rest acc
          else if _is_block_level st.display || st.position == "absolute"
                  || st.position == "fixed" then (list_rev acc, xs)
          else go rest (Cons (n, acc))
        | Text _t -> go rest (Cons (n, acc))
        | Comment _c -> go rest acc
        | Doctype (_x, _y, _z) -> go rest acc in
    go ns Nil;

  // The children of an element split at its first block-level box: what came before, that box, and what
  // came after. The block is returned as a one-element list because this language's option needs an
  // annotation the surrounding inference will not supply here, and a list of one says the same thing.
  let _split_at_block = fn (ua: prepared list) -> fn (author: prepared list) -> fn (pst: sty) ->
                        fn (anc: elem list) -> fn (ns: node list) ->
    let rec go = fn (xs: node list) -> fn (before: node list) ->
      match xs with
      | Nil -> (list_rev before, Nil, Nil)
      | Cons (n, rest) ->
        match n with
        | Element (tag, attrs, _k) ->
          let st = style_of ua author (_elem_of tag attrs) anc (_attr attrs "style") pst in
          // Out of flow is not a split point. A float's display is blockified — it has to be, or its
          // width and height would have nothing to apply to — and that made the splitter cut at it and
          // lay it out as a block in the sequence, which is a line taller than a float ever is.
          if st.float_ != "none" || st.position == "absolute" || st.position == "fixed" then
            go rest (Cons (n, before))
          else if _is_block_level st.display then (list_rev before, Cons (n, Nil), rest)
          else go rest (Cons (n, before))
        | _ -> go rest (Cons (n, before)) in
    go ns Nil;

  // The widest a box's contents want to be. A shrink-to-fit box — an inline-block, a float, a table — is
  // as wide as this and no wider, where an ordinary block is as wide as it is given. Text contributes its
  // whole length on one line, because "max content" means the width at which nothing wraps.
  // The accumulator is `sum of (font units x that piece's font size)`, and it is divided by the units
  // per em ONCE at the end of a run. That is what lets a run hold pieces at DIFFERENT sizes and still
  // be rounded once: font units are only comparable at one size, pixels round per piece, and this
  // product is comparable across sizes and exact until the division.
  //
  // Measuring each piece separately in pixels was tried and cost three documents a pixel each — the
  // fifth time in this file that rounding where the answer is computed rather than where it is read has
  // been the whole bug.
  let rec _mc_acc = fn (f: font) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                    fn (pst: sty) -> fn (anc: elem list) -> fn (ns: node list) ->
                    fn (best: int) -> fn (run: int) -> fn (trail: int) ->
    let mfs = pst.fs in
    // A run drops the white space at its ENDS, the same way a line box does — so the width is the
    // accumulator less whatever a trailing space contributed. `trail` carries that amount rather than a
    // flag, because the space at the end of a run may have been typed at a different size from the one
    // this level is measuring in.
    let flush = fn (r: int) -> fn (t: int) -> (r - t + f.upem / 2) / f.upem in
    match ns with
    | Nil -> (best, run, trail)
    | Cons (n, rest) ->
      match n with
      | Element (tag, attrs, kids) ->
        let e = _elem_of tag attrs in
        let st = style_of ua author e anc (_attr attrs "style") pst in
        let edges = st.ml + st.mr + st.pl + st.pr + st.bl + st.br in
        if st.display == "none" then _mc_acc f ua author pst anc rest best run trail
        // `<br>` ends the run here too. Max content is the width at which nothing WRAPS, and a break
        // that the source asked for is not wrapping — a box holding three lines of art separated by
        // `<br>` wanted 370 pixels, which is all three laid end to end, where the browser asks for the
        // longest of the three.
        else if to_lower tag == "br" then
          let fl = flush run trail in
          _mc_acc f ua author pst anc rest (if fl > best then fl else best) 0 0
        // An ATOMIC inline-level box does not break the run and its contents are not part of it: it
        // contributes its own shrink-to-fit width, the way a word contributes its own. Recursing into
        // it as if its text were the run's put a `display: inline-table` on the wrong side of the
        // arithmetic — the cell around it asked for 58 pixels where the browser asks for 45, which is
        // `a` plus the table plus `e`.
        else if st.display == "inline-block" || st.display == "inline-table" then
          let (b5, r5, t5) = _mc_acc f ua author st (Cons (e, anc)) kids 0 0 0 in
          let w5 = flush r5 t5 in
          let iw = if st.w >= 0 then st.w else (if w5 > b5 then w5 else b5) in
          // Its own contents were one unbroken run and no width was stated, so its accumulator can be
          // added straight to the outer one and the whole line still rounds once. Only when a BLOCK
          // inside it, or a stated width, has already forced a pixel figure does that figure have to be
          // used — and then the rounding is the box's own and not this arithmetic's.
          let add = if b5 > 0 || st.w >= 0 then iw * f.upem else r5 - t5 in
          _mc_acc f ua author pst anc rest best (run + add + edges * f.upem) 0
        else if _is_block_level st.display then
          // A block child ends the run of inline content beside it and contributes its own outer width.
          let inner = if st.w >= 0 then st.w
                      else
                        let (b3, r3, t3) = _mc_acc f ua author st (Cons (e, anc)) kids 0 0 0 in
                        let w3 = flush r3 t3 in
                        if w3 > b3 then w3 else b3 in
          let outer = inner + edges in
          let fl = flush run trail in
          let b2 = if fl > best then fl else best in
          _mc_acc f ua author pst anc rest (if outer > b2 then outer else b2) 0 0
        else
          // An inline element's contents are measured in ITS style — a `font-size: 0.2em` span inside a
          // paragraph is a fifth of the size the paragraph is measured at — and its own horizontal
          // edges take room on the same line beside them. An edge after the text also means the run no
          // longer ENDS in a space, whatever the text did.
          let (b4, r4, t4) = _mc_acc f ua author st (Cons (e, anc)) kids best run trail in
          _mc_acc f ua author pst anc rest b4 (r4 + edges * f.upem)
                  (if edges > 0 then 0 else t4)
      | Text t ->
        let c0 = _collapse_runs t in
        // White space at the START of a run is dropped as well, and "the start" is where nothing has
        // been measured yet.
        let c = if run == 0 && str_len c0 > 0 && char_at c0 0 == " "
                then substring c0 1 (str_len c0) else c0 in
        if c == "" then _mc_acc f ua author pst anc rest best run trail
        else
          let u = Font.text_units f c * mfs in
          let t2 = if char_at c (str_len c - 1) == " " then Font.text_units f " " * mfs else 0 in
          _mc_acc f ua author pst anc rest best (run + u) t2
      | _ -> _mc_acc f ua author pst anc rest best run trail;

  // The widest a box's contents want to be. A shrink-to-fit box — an inline-block, a float, a table — is
  // as wide as this and no wider, where an ordinary block is as wide as it is given. Text contributes its
  // whole length on one line, because "max content" means the width at which nothing wraps.
  let _max_content = fn (f: font) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                     fn (pst: sty) -> fn (anc: elem list) -> fn (ns: node list) ->
    let (b, r, t) = _mc_acc f ua author pst anc ns 0 0 0 in
    let w = (r - t + f.upem / 2) / f.upem in
    if w > b then w else b;

  // A list of siblings, stacked. `cbw` is the containing block's content width; `open_mb` is the
  // bottom margin left hanging by whatever came before. `swallow_first` says that the first
  // child's top margin belongs to the PARENT and must not become a gap here — the parent asks
  // for that when nothing separates its content edge from its border edge.
  //
  // Four things come back, and the fourth is the reason this is not a fold: the first child's
  // escaped top margin, which the parent needs to know its own.
  let rec _stack = fn (f: font) -> fn (docdir: str) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                   fn (pst: sty) ->
                   fn (ancestors: elem list) -> fn (ns: node list) -> fn (cbw: int) ->
                   // The containing block's CONTENT height, or -1 when it has none that is definite. A
                   // percentage height resolves against it, and against nothing when it is indefinite —
                   // which is why this is a number that can be absent rather than a zero.
                   fn (cbh: int) ->
                   fn (y: int) -> fn (open_mb: int) -> fn (swallow_first: bool) ->
                   fn (first_mt: int) -> fn (seen: bool) -> fn (bottom: int) ->
                   // The lowest edge any float in this list reached. A float is out of flow, so it does
                   // not move the cursor — but a box that establishes a formatting context has to be
                   // tall enough to hold it, and only this number knows how tall that is.
                   // The float that is still in the way: its right edge and its bottom. A float is out
                   // of flow, so neither can be derived from the cursor — the point of a float is that
                   // the cursor did not follow it.
                   fn (fs: (int * int)) -> fn (acc: box list) ->
    match ns with
    // Five things, and `bottom` is the one that is not `y`. The cursor `y` includes the margin still
    // hanging after the last child, because that is where the next child goes. The content height is
    // measured to the last child's BORDER box, which is a different number — using one for both made a
    // parent as tall as the margin below its last child, in eighty-three documents at once.
    | Nil -> let (_fr, fbot) = fs in (list_rev acc, y, open_mb, first_mt, bottom, fbot)
    | Cons (n, rest) ->
      match n with
      | Element (tag, attrs, kids) ->
        let e = _elem_of tag attrs in
        let st0 = style_of ua author e ancestors (_attr attrs "style") pst in
        // A block-level image is still a replaced element: its size comes from the file, not from
        // content it does not have. Without this it took the full width of its container and no
        // height at all, which is what a block box with nothing in it is.
        let st = if to_lower tag == "img" then _img_style docdir attrs cbw st0 else st0 in
        if not (_is_block_level st.display) && st.position != "absolute"
           && st.position != "fixed" then
          // An inline child of a block container: it and everything inline after it are one ANONYMOUS
          // block, laid out as a single inline formatting context. Without it the inline content
          // between two block-level children is dropped, and with it the two spans in
          // `<div><span style="display:table-cell">…</span><span>…</span></div>` land on two lines,
          // which is what the browser does.
          let (run, after) = _inline_run f docdir ua author pst ancestors ns in
          let (ibs, ilines, ih, saw) = _inline f docdir ua author pst ancestors run cbw in
          // An inline element with a block inside it is SPLIT by the standard. This does not split it;
          // it lays that element out as a block instead, which puts the boxes in the right order at the
          // right width and is the closer of the two wrong answers.
          //
          // The RETRY is what makes it affordable. Asking "does this contain a block" before laying
          // anything out means walking every descendant of every element and resolving its style each
          // time — a square, and here worse than one: it did not finish in ten minutes. The
          // walk that was happening anyway reports what it met, and only the head is redone.
          // The split itself, for the shape the corpus has: the pieces on either side of the block are
          // white space, so neither generates a box of its own and only their EDGES survive. The union
          // is then `before + block + a line + the bottom border` — the after piece's top border
          // overlaps the block, which is why it is not a plain sum. Anything with real content on
          // either side falls through to laying the element out as a block, below.
          let (spl_before, spl_blk, spl_after) = _split_at_block ua author pst ancestors kids in
          // The pieces no longer have to be empty. A piece with content is a line box like any other;
          // a piece with none is still a fragment when the element has an edge on that side, and is
          // nothing at all when it does not. `max(its lines, one if there is an edge)` says both.
          //
          // What they still may not contain is ANOTHER block. This splits at the first one, and an
          // element with several — `<span>…<div>Four</div><div>Five</div>…</span>` — would have its
          // remaining blocks laid out as inline content by the piece that holds them. The pieces are
          // laid out here rather than inside the branch precisely so that they can be asked: `_inline`
          // already reports whether it met a block, which is the same question in the same words.
          let piece_rtl = st.dir == "rtl" in
          let (pbs, plines, _pih, ps_blk) = _inline f docdir ua author st (Cons (e, ancestors)) spl_before cbw in
          let (abs_, alines, _aih, as_blk) = _inline f docdir ua author st (Cons (e, ancestors)) spl_after cbw in
          // The general split. An inline element with block-level boxes in it becomes a sequence of
          // pieces and blocks: fragment, block, fragment, block, ..., fragment. Each fragment is a line
          // box carrying the element's edge on the side it is on — the FIRST fragment has the start edge
          // and the LAST has the end edge, and the ones between are continuations with neither. Each
          // block is laid out at the containing block's full width with its own style, because it is a
          // sibling of the fragments and not a child of the inline.
          //
          // Three numbers come out and they are all different: where the union starts, where it ends, and
          // where the FLOW gets to. The union is the box the browser reports; the flow is what the next
          // sibling is placed after; and an inline's border hangs below its line without making its
          // parent taller, which is why the last two are not the same.
          let has_any_block = saw && (match spl_blk with Cons (_b, _r) -> true | Nil -> false) in
          if has_any_block then
            let start_edge = if piece_rtl then st.br + st.pr else st.bl + st.pl in
            let end_edge = if piece_rtl then st.bl + st.pl else st.br + st.pr in
            let lh = _lh_of f st in
            let top = y + _collapse open_mb 0 in
            let rec pieces = fn (ns2: node list) -> fn (yy: int) -> fn (isfirst: bool) ->
                             fn (acc2: box list) -> fn (uy0: int) -> fn (lastb: int) ->
              let (bef, blk, aft) = _split_at_block ua author st (Cons (e, ancestors)) ns2 in
              // A piece can itself contain a block, inside an inline element further down. When it does
              // it is not inline content at all — it is a block container's content — so it goes through
              // the stack, which already knows how to split what is inside it. The inline pass reports
              // that as it goes, so the question costs nothing to ask.
              let (pbs2a, plines2a, _pih2, pblk) =
                _inline f docdir ua author st (Cons (e, ancestors)) bef cbw in
              let (pbs2, plines2) =
                if not pblk then (pbs2a, plines2a)
                else
                  let (sbs, _sy, _smb, _sfm, sbot, _sfb) =
                    _stack f docdir ua author st (Cons (e, ancestors)) bef cbw cbh 0 0 false 0 false 0 (0, 0)
                           Nil in
                  // Its height is already in pixels, so it is turned back into a count of lines for the
                  // arithmetic below to divide out again. Not elegant; the alternative is threading a
                  // height where every other piece has a line count.
                  (sbs, (sbot + lh - 1) / lh) in
              let has_blk = match blk with Cons (_b2, _r2) -> true | Nil -> false in
              // A middle fragment carries no edge: the element's two edges are at its two ends.
              let edge = if isfirst then start_edge else (if has_blk then 0 else end_edge) in
              let pn = if plines2 > 0 then plines2 else (if edge > 0 then 1 else 0) in
              let ph = pn * lh in
              let uy1 = if isfirst then (if ph > 0 then yy - st.bt else yy) else uy0 in
              // The FRAGMENT's own box, anonymous, carrying the part of the border that belongs to it.
              //
              // An inline box broken by a block child is several fragments and the border is divided
              // among them: the start edge on the first, the end edge on the last, and neither in
              // between. The element's own box is the UNION of the fragments and deliberately carries
              // no border, so there is nothing here to draw twice.
              //
              // Its border box top is `yy - st.bt`, which is the same number the union's top is taken
              // from two lines above, and its height is the line plus both horizontal edges — a
              // browser reports 32 for a 22-pixel line inside a 5-pixel border.
              let fx1 =
                let rec widest = fn (l: box list) -> fn (m: int) ->
                  match l with
                  | Nil -> m
                  | Cons (fb, fr) -> widest fr (if fb.x + fb.w > m then fb.x + fb.w else m) in
                let cw2 = widest pbs2 0 in
                // PLUS the edge, not "or" the edge. The inline pass is given the piece's children and
                // not the element, so it lays the content out from zero — the element's own border and
                // padding are not in those numbers and have to be added. Choosing between them instead
                // made the fragment two pixels narrower than the border the browser draws, which was
                // the whole of the remaining disagreement in one pair: 31 where a browser says 33.
                cw2 + edge in
              let frag =
                if ph <= 0 && edge <= 0 then Nil
                // At the right in a right-to-left context, which is where the line starts there. The
                // edges already swap; the fragment's own position does too, and putting it at zero put
                // a right-to-left fragment at the left margin with the reference at the right.
                else Cons (box { tag = "", x = if piece_rtl then cbw - fx1 else 0,
                                 y = yy - st.bt, w = fx1, h = ph + st.bt + st.bb,
                                 pinned = false, pinx = false, cp = 0, fg = 0, bg = st.bg, fs = 0,
                                 layer = st.layer, bc = st.bc,
                                 bt = st.bt, bb = st.bb,
                                 // The start edge on the first fragment and the end edge on the last,
                                 // which side that is depending on the direction.
                                 bl = if piece_rtl then (if has_blk || isfirst then 0 else st.bl)
                                      else (if isfirst then st.bl else 0),
                                 br = if piece_rtl then (if isfirst then st.br else 0)
                                      else (if has_blk || isfirst then 0 else st.br),
                                 src = "" }, Nil) in
              // The content of the FIRST fragment starts AFTER the start edge, and this is the second
              // consequence of the same fact as the width above: the inline pass is handed the piece's
              // children and not the element, so it lays them out from zero. The width was corrected
              // and the position was not — the browser puts the first glyph at 10 where this put it at
              // 8, which is the element's own two pixels of border. One fact, two places.
              //
              // Left-to-right only. In a right-to-left context the content is right-aligned and the
              // fragment box is placed from the right instead, which already agrees with the reference.
              let cdx = if isfirst && not piece_rtl then start_edge else 0 in
              let acc3 = list_append (list_append acc2 frag) (_shift pbs2 cdx yy) in
              let y1 = yy + ph in
              let lastb1 = if ph > 0 then y1 else lastb in
              match blk with
              | Nil ->
                // The union ends at the last fragment's border, or at the last block's border when the
                // element ended with no fragment at all — a margin below a block is space around it and
                // not part of the element.
                (acc3, y1, (if ph > 0 then y1 + st.bb else lastb1), uy1)
              | Cons (bn, _r3) ->
                match bn with
                | Element (btag, battrs, bkids) ->
                  let bst = style_of ua author (_elem_of btag battrs) (Cons (e, ancestors))
                              (_attr battrs "style") st in
                  let (bbs2, bh2, bmt2, bmb2, _be2) =
                    _block f docdir ua author pst ancestors btag battrs bkids cbw cbh bst in
                  let bt3 = if bmt2 > 0 then bmt2 else 0 in
                  let bb3 = if bmb2 > 0 then bmb2 else 0 in
                  let uy2 = if isfirst && ph == 0 then yy + bt3 else uy1 in
                  pieces aft (y1 + bt3 + bh2 + bb3) false
                         (list_append acc3 (_shift bbs2 0 (y1 + bt3))) uy2 (y1 + bt3 + bh2)
                | _ -> (acc3, y1, lastb1, uy1) in
            let (allbs, yend, ubot, uy) = pieces kids top true Nil top top in
            let sdx = if st.position == "relative" && st.left >= 0 then st.left else 0 in
            let sdy = if st.position == "relative" && st.top >= 0 then st.top else 0 in
            let me = box { tag = to_lower tag, x = sdx, y = uy + sdy, w = cbw, h = ubot - uy, pinned = false, pinx = false, cp = 0, fg = 0, bg = 0 - 1, fs = 0, layer = 3, bc = 0, bt = 0, br = 0, bb = 0, bl = 0, src = "" } in
            _stack f docdir ua author pst ancestors rest cbw cbh yend 0 swallow_first
                   (if not seen then 0 else first_mt) true yend fs
                   (list_append (list_rev (_shift allbs sdx sdy)) (Cons (me, acc)))
          else if saw then
            // The split this replaces, measured rather than guessed. `getClientRects` shows the
            // FRAGMENTS where `getBoundingClientRect` only shows their union, and for
            // `<span border 5px, padding-right 10px><span display:block>x</span></span>` the browser
            // answers three of them:
            //
            //   8,8   0x0      the piece before — whitespace only, so it collapses to nothing
            //   8,8   784x22   THE BLOCK ITSELF, reported as a fragment of the inline
            //   8,25  10x32    the piece after — the padding-right wide, a line plus both borders tall
            //
            // The union is 8..57, which is the 784x49 the expectation records. So the shape to build is:
            // split the children into runs, lay each inline run as a line box carrying the element's
            // edges and each block at the containing block's full width, stack them, and report the
            // union as the element's box. The third fragment is exactly the box the inline path already
            // produces for an empty element with edges — that part is written and in the right place.
            //
            // The block piece of a split is a SIBLING of the inline pieces, not a child of the inline —
            // so the inline's horizontal padding and borders do not narrow it. Laying the whole element
            // out as a block keeps those edges and takes ten pixels off the block inside it, which is
            // the one part of the substitution that can be corrected without doing the split.
            let (fbs, fh, fmt2, fmb2, _fesc) =
              _block f docdir ua author pst ancestors tag attrs kids cbw cbh (_no_h_edges st) in
            let top = y + _collapse open_mb fmt2 in
            // Relative positioning applies here as it does everywhere else. This branch is the one an
            // inline with SEVERAL blocks in it takes, and it had been missed while the split beside it
            // was given the offset — the same property, two branches, one of them updated.
            let sdx2 = if st.position == "relative" && st.left >= 0 then st.left else 0 in
            let sdy2 = if st.position == "relative" && st.top >= 0 then st.top else 0 in
            _stack f docdir ua author pst ancestors rest cbw cbh (top + fh) fmb2 swallow_first
                   (if not seen then fmt2 else first_mt) true (top + fh) fs
                   (list_append (list_rev (_shift fbs sdx2 (top + sdy2))) acc)
          else
            let top = y + _collapse open_mb 0 in
            let h = ih in
            _stack f docdir ua author pst ancestors after cbw cbh (top + h) 0 swallow_first first_mt true (top + h)
                   fs (list_append (list_rev (_shift ibs 0 top)) acc)
        else if st.display == "none" then
          _stack f docdir ua author pst ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom fs acc
        // Out of flow: the box is laid out where it would have been — its static position, which is
        // what `top` and `left` of `auto` mean — and then the cursor does not move and the height does
        // not grow. `<div style="position:absolute">` inside a page made the page as tall as if it were
        // in flow, and 94 of the 116 layout failures were that one thing.
        else if st.position == "absolute" || st.position == "fixed" then
          // An out-of-flow box with no stated width SHRINKS TO FIT, like a float and an inline-block
          // and for the same reason: there is nothing for it to fill. It was filling its containing
          // block, so an absolutely positioned sentence came out 800 wide where the browser says 699.
          // Bounded by what is available, because shrink-to-fit is the smaller of what the contents
          // want and what there is room for.
          let ast =
            if st.w >= 0 || st.w_pct >= 0 then st
            else
              let avail = cbw - st.ml - st.mr - st.bl - st.br - st.pl - st.pr in
              let mc = _max_content f ua author pst (Cons (_elem_of tag attrs, ancestors)) kids in
              _with_width st (if mc > avail then (if avail < 0 then 0 else avail) else mc) in
          let (fbs, _fh, _fmt, _fmb, _fesc2) = _block f docdir ua author pst ancestors tag attrs kids cbw cbh ast in
          // `left` and `top` are measured from the containing block, which for an absolutely positioned
          // box is the nearest POSITIONED ancestor. Here that is taken to be the parent, whose content
          // origin is where these coordinates already start from — true whenever the parent is the
          // positioned one, which is what `position: relative` on a wrapper is written for. Where they
          // say nothing the box keeps its static position, which is what `auto` means.
          // Whose coordinates `left` and `top` are in: the nearest POSITIONED ancestor's, or the page's
          // when there is none. The second is what `pinned` is for — the box is placed at the page
          // coordinates it asked for and opts out of every shift above it, which is the only way to
          // express an absolute origin in a file that has none.
          // The parent's style is in hand now — it is what this box inherited from — so asking whether
          // the parent is positioned is a field access and not a second resolution of it.
          let anc_positioned =
            match ancestors with
            | Nil -> false
            | Cons (_par, _up) -> pst.position != "static" in
          let pin = st.top >= 0 && not anc_positioned in
          let pinx = st.left >= 0 && not anc_positioned in
          let bs0 = _shift fbs (if st.left >= 0 then st.left else 0)
                      (if st.top >= 0 then st.top else y + _collapse open_mb 0) in
          let bs = if not pin && not pinx then bs0
                   else list_map bs0 (fn (b: box) ->
                          box { tag = b.tag, x = b.x, y = b.y, w = b.w, h = b.h,
                                pinned = pin || b.pinned, pinx = pinx || b.pinx, cp = b.cp,
                                fg = b.fg, bg = b.bg, fs = b.fs, layer = b.layer, bc = b.bc, bt = b.bt, br = b.br, bb = b.bb, bl = b.bl, src = b.src }) in
          _stack f docdir ua author pst ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom fs
                 (list_append (list_rev bs) acc)
        // A float is out of flow too, but not in the same way: it is placed at the containing block's
        // left edge below whatever floats came before it, the cursor does not move past it, and the
        // parent's height ignores it unless the parent establishes a formatting context.
        //
        // Placing floats beside EACH OTHER was written once and never fired: the document it was
        // written for has one float in it. What that case wanted was the rule below — a formatting
        // context is placed beside a float rather than under it — and the guess cost a commit.
        else if st.float_ == "left" || st.float_ == "right" then
          // A float SHRINKS TO FIT: its width is what its contents want, never what its container
          // offers. Given the block width it filled the line, and a float that fills the line is not a
          // float at all — `<div style="float:left;border-left:5px">` with nothing in it is five pixels
          // wide, which is its border and no more.
          // Shrink-to-fit is the width the CONTENTS want, and a float holding a `<div style="width:
          // 5em">` and no words wants eighty pixels however little text is in it. Measuring the text
          // gave zero, so the float was its own border and nothing else — the same defect as the table
          // column above, in the second of the three places that size a box by what is inside it.
          let fst = if st.w >= 0 || st.w_pct >= 0 then st
                    else _with_width st (_max_content f ua author pst (Cons (e, ancestors)) kids) in
          let (fbs, fh, fmt2, fmb2, _fesc) =
            _block f docdir ua author pst ancestors tag attrs kids cbw cbh fst in
          let (_fr0, fbot) = fs in
          let top = if fbot > y then fbot else y + _collapse 0 fmt2 in
          let fw = match fbs with Nil -> 0 | Cons (b0, _r) -> b0.w + st.ml + st.mr in
          _stack f docdir ua author pst ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom
                 // A formatting context contains a float's MARGIN box, not its border box: the 48px
                 // below a float is inside the box that holds it.
                 (fw, top + fh + (if fmb2 > 0 then fmb2 else 0))
                 (list_append (list_rev (_shift fbs 0 top)) acc)
        else
          // A box that establishes a formatting context does not OVERLAP a float — it is placed
          // beside it, and the width it has to work in is what is left. An ordinary block ignores the
          // float entirely and only its line boxes are shortened, which is the difference between the
          // two and the reason this asks about the child rather than about the float.
          let (fright, fbot) = fs in
          let bfc = st.position == "absolute" || st.position == "fixed"
                    || st.display == "table-cell" || st.display == "table"
                    || st.overflow != "visible" in
          let dodge = if bfc && fright > 0 && y < fbot then fright else 0 in
          // An inline-block is sized by its contents like a float and a table, not by its container.
          //
          // What is NOT right about it here: an inline-block is inline-LEVEL, so it sits on a line beside
          // whatever else is there and the line grows to hold it. This treats it as block-level, which
          // gives it a line of its own. The one document in the corpus that uses it is blocked on the
          // initial containing block as well, so the gate cannot tell the two apart yet — the width is
          // right and matches the browser, the placement is a box on its own line where it should share
          // one.
          let ist = if st.display != "inline-block" || st.w >= 0 || st.w_pct >= 0 then st
                    else _with_width st (_max_content f ua author pst (Cons (e, ancestors)) kids) in
          let (fbs0, fh, fmt, fmb, fesc) =
            _block f docdir ua author pst ancestors tag attrs kids (cbw - dodge) cbh ist in
          let fbs = if to_lower tag == "img" then _img_box fbs0 st (Img.resolve docdir (_attr attrs "src"))
                    else fbs0 in
          let is_first = not seen in
          // The gap above this box is the two margins collapsed into one, not their sum. When the
          // parent has claimed the first child's margin there is no gap at all here.
          let gap = if is_first && swallow_first then 0 else _collapse open_mb fmt in
          let top = y + gap in
          // `position: relative` moves the box and everything in it AFTER it has been placed, and
          // changes nothing about the flow: the cursor, the height and the next sibling are all as if
          // the offset were not there. That is the whole of what relative positioning is, and it is why
          // it can be applied here rather than anywhere in the sizing.
          let rel = st.position == "relative" in
          let bs = _shift fbs (dodge + (if rel && st.left >= 0 then st.left else 0))
                     (top + (if rel && st.top >= 0 then st.top else 0)) in
          // A box with nothing in it and no border or padding lets margins COLLAPSE THROUGH: its own
          // two margins join the run rather than ending it, so the cursor does not move past it and it
          // adds nothing to the parent's height. The box is still placed, and after the gap — which is
          // why an empty `<div>` after a paragraph sits below its parent's own bottom edge.
          //
          // ...and only when the height is AUTO. A box whose height is stated does not collapse
          // through even when the number stated is zero: `div { height: 0 }` around content that
          // overflows it is still a box that the flow reached, and its parent's height reaches it.
          // Asking "is it zero tall" instead of "did it say how tall" made a document's body sixteen
          // pixels short while every box inside it was exactly right — which is what a total being the
          // only wrong number looks like.
          let through = fh == 0 && st.h < 0 && st.h_pct < 0 in
          // A float that escaped this child is still in this box's flow, so its reach is remembered here
          // and keeps escaping until a box contains it.
          let (fr0, fb0) = fs in
          let fs2 = if fesc > 0 && top + fesc > fb0 then (fr0, top + fesc) else fs in
          _stack f docdir ua author pst ancestors rest cbw cbh
                 (if through then y else top + fh)
                 (if through then _collapse open_mb (_collapse fmt fmb) else fmb)
                 swallow_first (if is_first then fmt else first_mt) true
                 (if through then bottom else top + fh) fs2
                 (list_append (list_rev bs) acc)
      | Text t ->
        // Whitespace between two block-level children is discarded; anything else starts an anonymous
        // block, exactly as an inline element does.
        if _collapse_ws t == "" then
          _stack f docdir ua author pst ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom fs acc
        else
          let (run, after) = _inline_run f docdir ua author pst ancestors ns in
          // A run that begins with text can hold a block too, inside an inline element two levels down —
          // `<span>First <span>line <span display:block>` is one of the corpus's. This branch does NOT
          // retry the way the element branch does, and the reason is worth recording rather than
          // rediscovering: shortening the run to the text in front of the first element was tried, and it
          // splits a line that should not be split. The browser keeps `First` and `line` on ONE line and
          // puts the block below it, so the anonymous block has to contain the text AND the leading
          // fragment of the inline beside it. That is the recursive split, and nothing short of it gets
          // those two words onto the same line.
          let (ibs, _ilines, ih2, _saw2) =
            _inline f docdir ua author pst ancestors run cbw in
          let top = y + _collapse open_mb 0 in
          let h = ih2 in
          _stack f docdir ua author pst ancestors after cbw cbh (top + h) 0 swallow_first first_mt true (top + h)
                 fs (list_append (list_rev (_shift ibs 0 top)) acc)
      | _ -> _stack f docdir ua author pst ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom fs acc

  // The element children of a node, with their resolved styles. Tables ask this three times — for row
  // groups, rows and cells — and the white space between them is not a row.
  and _kids_of = fn (f: font) -> fn (docdir: str) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                 fn (pst: sty) ->
                 fn (anc: elem list) -> fn (ns: node list) ->
    let rec go = fn (xs: node list) -> fn (acc: (str * attr list * node list * sty) list) ->
      match xs with
      | Nil -> list_rev acc
      | Cons (n, rest) ->
        match n with
        | Element (tag, attrs, kids) ->
          let e = _elem_of tag attrs in
          let st = style_of ua author e anc (_attr attrs "style") pst in
          if st.display == "none" then go rest acc
          else go rest (Cons ((tag, attrs, kids, st), acc))
        | Text _t -> go rest acc
        | Comment _c -> go rest acc
        | Doctype (_x, _y, _z) -> go rest acc in
    go ns Nil

  // A table, which is its own algorithm and not a stack of blocks. Rows share their columns' widths, a
  // table shrinks to fit its content rather than filling its container, and `border-spacing` insets
  // every cell — including at the edges, which is why a table is wider than the sum of its columns.
  //
  // What is NOT here: colspan and rowspan, column groups, captions, and collapsed borders. Each would
  // change which cell owns which width, and the corpus will say when one is needed.
  // The inline content of a box, laid out into lines, with a box for every inline element in it.
  //
  // The second half of that is why this exists rather than a line count: an inline element has a box
  // and the gate compares it. Returning only a height dropped every `<span>` and `<strong>` in the
  // corpus and the box-sequence number fell from 126 to 57 in one commit — which is what that second
  // number is for.
  //
  // Everything is carried in font units until the end. `x` is how far along the current line the
  // cursor is, `line` counts from zero, and `gap` says a space is owed before the next word — a space
  // between two text nodes belongs to neither of them, so it cannot be part of either string.
  // `bst` is the style of the box whose content this is — the element at the head of `anc`. Its font
  // size, line height, direction, white space and text indent all come from it, and they used to be
  // five separate walks back up the chain asking for one property each.
  and _inline = fn (f: font) -> fn (docdir: str) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                fn (bst: sty) -> fn (anc: elem list) -> fn (kids: node list) -> fn (cw: int) ->
    let size = bst.fs in
    let rtl = bst.dir == "rtl" in
    // Half a pixel wider than the box, and that is not a fudge. `cw` is a width that was ROUNDED to a
    // whole pixel, so the box it names is somewhere within half a pixel of it — and the commonest way
    // for a width to be produced is by measuring the very text that has to fit in it. A table column is
    // exactly that: as wide as its widest cell's content, reported as 45 when it is 45.4, and asking
    // whether 45.4 of text fits in 45 answers no about a column that was built from that text.
    //
    // This replaces rounding the column width UP for layout, which fixed the same two documents and
    // leaked: a `<p>` filling that cell came out 46 wide where the browser says 45, because the ceiling
    // was in the number the children were SIZED against and not only in the question about breaking.
    // Round where the answer is read — and the answer read here is "does it fit", not "how wide is it".
    // The cursor's currency is `pixels x units-per-em`, not font units. Font units measure GLYPHS and
    // are comparable only at one size — so a run holding a `font-size: 0.2em` span could not be added
    // up at all, and every piece of it was laid out at the paragraph's size. This product is comparable
    // across sizes and stays exact until the one division at the end: the same accumulator
    // `_max_content` uses, for the same reason.
    //
    // Half a pixel of slack, as before: `cw` is a rounded width, the box it names is within half a
    // pixel of it, and the commonest way for a width to exist is by measuring the text that must fit.
    let cap = if cw <= 0 then 0 else ((cw * 2 + 1) * f.upem) / 2 in
    // In units still — a space is a glyph — and multiplied by the size in force wherever it is used.
    let space_u = Font.text_units f " " in
    let lh = _lh_of f bst in
    // A line is not a fixed height. It is as tall as the tallest thing above the baseline plus the
    // deepest below it, and the STRUT — the invisible box the containing element's own font puts on
    // every line whether anything is written there or not — sets the floor for both. Text alone gives
    // exactly `lh`, which is why this was invisible until something else could be on a line.
    //
    // The descender is negative in the font, so it is negated to become a depth. `asc` is taken as the
    // remainder rather than scaled on its own: `asc + desc` has to be `lh` exactly, and two roundings
    // that each land right can still sum to one pixel wrong.
    // With `line-height` the two are not the font's own any more. The difference between the stated
    // height and the font's is the LEADING, and it is split half above the text and half below — so a
    // line-height smaller than the font's puts the baseline higher than the font alone would, and the
    // text hangs out of its own line box. Taking `asc` as the remainder keeps `asc + desc == lh`, which
    // two roundings that each land right can still break.
    // `white-space: nowrap` for the box whose content this is. It inherits, so the walk below carries
    // it DOWN as it descends into elements — which is the same descent that asking for the inherited
    // value would have to make, done once instead of once per element.
    let nw0 = bst.ws == "nowrap" || bst.ws == "pre" in
    // `text-indent` moves the FIRST line only, which is why it belongs here and not in the box model:
    // it is not padding, it does not move the box, and every line after the first starts where it always
    // did. It inherits, so an inline-block inside an indented paragraph is indented too unless it says
    // otherwise — which is exactly what the two documents that use it are checking.
    // A percentage is against the CONTAINING BLOCK and so cannot be resolved in the cascade; a length
    // already was, in the font size of whichever element declared it. Both survive the inheriting as
    // themselves, which is why they are two fields and not one.
    let tiu = (if bst.ti_pct >= 0 then (cw * bst.ti_pct) / 100 else bst.ti_px) * f.upem in
    let natural = Font.line_height f size in
    let dnat = Font.scale f (0 - f.descender) size in
    // Floored, not truncated. Integer division rounds toward ZERO here, and the half-leading is
    // negative whenever the line is shorter than the font — so `(20 - 27) / 2` answered -3 where the
    // real number is -3.62 and the browser's box top is -4. Truncation moves a negative number the
    // wrong way, and it only shows on an odd difference, which is why every even one agreed.
    let half = let d = lh - natural in
               if d >= 0 then d / 2 else 0 - ((0 - d + 1) / 2) in
    let asc = natural - dnat + half in
    let desc = lh - asc in
    // What is on each line, as a sparse list of `(line, above, below)`. Sparse because a line with
    // nothing but text contributes nothing this does not already know, and most documents have no
    // entries at all.
    // Three numbers and not two, because `vertical-align: top` is not a contribution to the baseline at
    // all — it is a floor under the line's TOTAL height. Expressing it as "all of it above the baseline"
    // made a 30px box on a 22px line come out 35: its own height, and then the strut's descent under a
    // baseline it was never aligned to. Two documents said so.
    let hline = fn (hs: (int * int * int * int) list) -> fn (i: int) ->
      let rec go = fn (cs: (int * int * int * int) list) -> fn (a: int) -> fn (b: int) ->
                   fn (m: int) ->
        match cs with
        | Nil -> if a + b > m then a + b else m
        | Cons (c, more) ->
          let (li, ca, cb, cm) = c in
          if li == i then go more (if ca > a then ca else a) (if cb > b then cb else b)
                                  (if cm > m then cm else m)
          else go more a b m in
      go hs asc desc 0 in
    // Where the baseline sits inside line `i`, which is what everything on the line is placed against.
    // Where the baseline sits inside line `i`. Room added by a floor goes BELOW it, which is what
    // keeps a top-aligned box from moving the text beside it.
    let hbase = fn (hs: (int * int * int * int) list) -> fn (i: int) ->
      let rec go = fn (cs: (int * int * int * int) list) -> fn (a: int) ->
        match cs with
        | Nil -> a
        | Cons (c, more) ->
          let (li, ca, _cb, _cm) = c in
          if li == i then go more (if ca > a then ca else a) else go more a in
      go hs asc in
    let ltop = fn (hs: (int * int * int * int) list) -> fn (i: int) ->
      let rec go = fn (j: int) -> fn (a: int) ->
        if j >= i then a else go (j + 1) (a + hline hs j) in
      go 0 0 in
    // `gap` is a space owed from BEFORE this list — the boundary between two text nodes. Inside one
    // list the separator is implied by the split itself, so every word after the first gets a space
    // whatever the flag says, and the flag applies only to the first. Carrying it forward instead put
    // a space between `<span>One</span>` and `<span>Two</span>`, where the source has none.
    // `mx` is the rightmost the cursor has been, and it has to be reported from HERE: a line that wrapped
    // ended somewhere, and only this loop knows where. The caller sees the cursor before the run and the
    // cursor after it, and on a run that wrapped neither of those is the end of any line.
    // One box per CHARACTER of a word, at the position the word starts from. The x of the i-th
    // character is the width of the first i characters of the word and not the sum of their widths
    // measured apart: kerning lives BETWEEN two glyphs, so adding them one at a time puts every
    // character after a kerned pair a fraction too far right. Measuring each prefix is quadratic in
    // the length of a word, which is a price worth paying for a word.
    let chars_of = fn (w: str) -> fn (x0: int) -> fn (ln: int) -> fn (fsz: int) ->
                   fn (fgc: int) -> fn (hs: (int * int * int * int) list) ->
      let nat = Font.line_height f fsz in
      let dn = Font.scale f (0 - f.descender) fsz in
      let top = ltop hs ln + hbase hs ln - (nat - dn) in
      let cs = utf8_chars w in
      let total = Font.text_units f w * fsz in
      // Where the PEN is before each character, which is not the width of the characters before it.
      // A kern belongs BETWEEN two glyphs and moves the second one, so the pen before character `i`
      // has taken the kern into account and the width of the first `i` characters has not — the
      // difference is one kern, and it shows as every character after a kerned pair sitting a pixel
      // to the right of where the browser puts it.
      //
      // `units(first i+1) - advance(i)` is that pen position: the whole run up to and including this
      // character, less the character itself.
      let pen = fn (i: int) ->
        let c = nth_str cs i in
        Font.text_units f (str_join "" (list_take cs (i + 1))) * fsz
        - Font.advance f (Font.glyph f (Font.codepoint c)) * fsz in
      let px = fn (u: int) -> (x0 + u + f.upem / 2) / f.upem in
      let n = list_len cs in
      let rec go = fn (i: int) -> fn (acc: box list) ->
        if i >= n then acc
        else
          // A character's box reaches to where the next one begins, so the kern between them is
          // inside the first one's width — which is what the browser reports and what a painter
          // needs, because the gap is part of the pair and not of either glyph.
          let u1 = pen i in
          let u2 = if i + 1 >= n then total else pen (i + 1) in
          // The WIDTH is the scaled difference and not the difference of two scaled numbers. Rounding
          // each end and subtracting rounds twice: a character whose true width is 7.6 between pen
          // positions of 25.3 and 32.9 comes out 7 that way and 8 this way, and the browser says 8.
          // Round where the answer is read — the sixth time in this file, and the first where the two
          // answers being confused are a position and a size.
          go (i + 1)
             (Cons (box { tag = "", x = px u1, y = top,
                          w = (u2 - u1 + f.upem / 2) / f.upem,
                          h = nat, pinned = false, pinx = false,
                          cp = Font.codepoint (nth_str cs i), fg = fgc, bg = 0 - 1,
                          fs = fsz, layer = 3, bc = 0, bt = 0, br = 0, bb = 0, bl = 0, src = "" }, acc)) in
      go 0 Nil in
    let rec words = fn (ws: str list) -> fn (x: int) -> fn (line: int) -> fn (gap: bool) ->
                    fn (first: bool) -> fn (placed: bool) -> fn (nw: bool) -> fn (mx: int) ->
                    // The size these words are set in, which is the element's and not the box's.
                    fn (fsz: int) -> fn (fgc: int) -> fn (hs: (int * int * int * int) list) ->
                    fn (gacc: box list) ->
      match ws with
      | Nil -> (x, line, gap, placed, (if x > mx then x else mx), gacc)
      | Cons (w, rest) ->
        // An empty piece is where a space was, and a trailing one is how a list says it ended in one.
        if w == "" then words rest x line true first placed nw mx fsz fgc hs gacc
        else
          let wu = Font.text_units f w * fsz in
          let space = space_u * fsz in
          let need = if first then gap else true in
          let put = fn (at: int) -> fn (ln: int) ->
            list_append (chars_of w at ln fsz fgc hs) gacc in
          if not placed then words rest (x + wu) line false false true nw mx fsz fgc hs (put x line)
          else if nw || x + (if need then space else 0) + wu <= cap then
            // `nowrap` means the line does not end where it runs out of room. It ends where the source
            // says — at a `<br>`, or nowhere — and the text overflows its container, which is the
            // point of asking for it.
            let sx2 = x + (if need then space else 0) in
            words rest (sx2 + wu) line false false true nw mx fsz fgc hs (put sx2 line)
          // A word that does not fit starts the next line, and one wider than the whole line gets a
          // line of its own and overflows — which is what a browser does rather than cutting it. The
          // cursor at this moment is where the line it is leaving ENDED, which is the only place that
          // number exists.
          else words rest wu (line + 1) false false true nw (if x > mx then x else mx) fsz fgc hs
                     (put 0 (line + 1)) in
    // Floats come out of the inline content before anything is placed. A float is not on the line — it
    // is beside it — so it takes room at the line's left edge, everything else starts after it, and a run
    // holding nothing but a float makes no line at all. Hoisting them first is what lets the element that
    // contained one report a zero-width box at the line's new start, which is what the browser does.
    let rec floats = fn (ns: node list) -> fn (fx: int) -> fn (wst: sty) -> fn (acc: box list) ->
      match ns with
      | Nil -> (fx, acc)
      | Cons (n, rest) ->
        match n with
        | Element (tag, attrs, ks) ->
          let est = style_of ua author (_elem_of tag attrs) anc (_attr attrs "style") wst in
          if est.float_ == "left" || est.float_ == "right" then
            let w = Font.text_units f (_collapse_ws (_inline_text ks "")) * est.fs
                    + (est.bl + est.pl + est.pr + est.br) * f.upem in
            floats rest (fx + w) wst acc
          else
            // A fresh accumulator, so the shift below touches only what this element contained.
            let (fx2, a2) = floats ks fx est Nil in
            // A float inside a relatively positioned inline moves with it, because relative positioning
            // moves everything the element contains and a float is still contained by it.
            let rdx = if est.position == "relative" && est.left >= 0 then est.left else 0 in
            let rdy = if est.position == "relative" && est.top >= 0 then est.top else 0 in
            floats rest fx2 wst (list_append acc (_shift a2 rdx rdy))
        | _ -> floats rest fx wst acc in
    let (float_w, _fbs) = floats kids 0 bst Nil in
    // Laid out once for the line heights and, only if something on a line was not text, once more with
    // them known. The second pass is what places the boxes: a box's y is the top of its line, and the
    // top of a line is the sum of the heights of the lines above it, so nothing can be placed until
    // every line's height is known. Line BREAKING does not depend on the heights, so the two passes
    // agree on which line everything is on.
    //
    // The cost is two layouts of every atomic box on the line, and two of everything inside it. Nested
    // atomic boxes would be a power of the depth; the corpus goes two deep and the guard below means
    // most documents never make the second pass at all.
    let onepass = fn (hs: (int * int * int * int) list) ->
      let rec walk = fn (ns: node list) -> fn (x: int) -> fn (line: int) -> fn (gap: bool) ->
                     fn (saw: bool) -> fn (placed: bool) ->
                     // `placed` is "a glyph went down", which decides whether a space is owed. `online` is
                     // "there is a line here at all", which an inline's own border makes true without
                     // placing anything and a float never does. Two questions, and one flag answering both
                     // makes either the spaces or the empty boxes wrong.
                     fn (online: bool) ->
                     // The float cursor. The hoist above already worked out how wide the floats are so the
                     // line could start after them; the boxes themselves are emitted HERE, where document
                     // order is, because a box list that is right except for its order is wrong.
                     fn (fcur: int) ->
                     // The widest any line has been. A box that spans lines is as wide as its widest
                     // fragment, not as wide as the container — and with `width: 0` the container is no
                     // width at all while the text still has to go somewhere.
                     fn (maxx: int) ->
                     // `white-space: nowrap`, carried DOWN rather than asked for: it inherits, and the
                     // walk is already descending through exactly the elements whose values would have
                     // to be consulted — which is the same reason `wst`, the style of the element whose
                     // children these are, comes down with it.
                     fn (nw: bool) -> fn (wst: sty) ->
                     // What has been found out about the lines so far, threaded rather than returned
                     // from a second traversal: the walk already visits everything exactly once.
                     fn (hc: (int * int * int * int) list) -> fn (acc: box list) ->
        match ns with
        // `online` comes back out because the caller has to know whether there is a line, and it had
        // been inferring that from whether the cursor moved. Those are two questions: an atomic box of
        // zero width — `<img>` with no `src` is one, and the browser still gives it a line — is on the
        // line without advancing anything, and a run holding one reported no lines at all.
        | Nil -> (acc, x, line, gap, saw, fcur, (if x > maxx then x else maxx), hc, online)
        | Cons (n, rest) ->
          match n with
          | Text t ->
            // Split on the collapsed text so an empty piece marks where a space was.
            let (x2, l2, g2, p2, wmx, gbs) =
              words (str_split (_collapse_runs t) " ") x line gap true placed nw maxx wst.fs
                    wst.color hs Nil in
            walk rest x2 l2 g2 saw p2 (online || p2) fcur wmx nw wst hc (list_append gbs acc)
          | Element (tag, attrs, ks) ->
            // An element's box starts at its first GLYPH, not at the cursor. A space owed from before it
            // belongs to the text outside, so counting the cursor made every inline element four pixels
            // too early and five too wide — which reads as a rounding error and is a space.
            // ...but only when there is something before it on the line. White space at the START of a
            // line box is removed, so a space owed at x = 0 is owed to nothing: adding it there put every
            // ...and only when something has actually been PLACED on the line. A border has taken room
            // without placing anything, so `x > 0` is not the question: white space at the start of a line
            // is removed even where an ancestor's border has already advanced the cursor, and asking about
            // the cursor put every nested inline one space in from where it belongs.
            // ...and only when the element that follows the space actually puts a glyph down. A space
            // before an element that places nothing is a space at the end of the line, and a line's
            // trailing white space is removed — so an empty `<span>` with a border sits against the text
            // before it and not four pixels off it.
            let empty_el = _collapse_ws (_inline_text ks "") == "" in
            let sx0 = if gap && placed && not empty_el then x + space_u * wst.fs else x in
            // The children are walked into a FRESH accumulator so the element's own box can be placed
            // in front of them afterwards. Consing it onto the same accumulator put a nested inline
            // element after its own children in document order, which the box-sequence number sees.
            // An inline element's own padding and borders take room ON the line.
            let est = style_of ua author (_elem_of tag attrs) anc (_attr attrs "style") wst in
            // `<br>` ends the line. It is the one element whose whole effect is on line breaking, so it
            // cannot come out of the cascade — there is no property that says "break here" — and it was
            // missing entirely: `Test<br/>Test` came out one line of two words rather than two lines.
            //
            // Its own box is at the cursor and is zero wide and one line tall, which is what the browser
            // reports for it. At the CURSOR and not past a pending space: a space before a break is at
            // the end of a line, and a line's trailing white space is removed.
            // `display: none` generates nothing — no box, no advance, and nothing inside it either.
            // The block path has always known this; the LINE path did not, and it never showed because
            // no document in the layout corpus puts a hidden inline next to a visible one. A `<style>`
            // in the body beside an image does exactly that, and the stylesheet was laid out as a line
            // of text with the image pushed along behind it.
            if est.display == "none" then
              walk rest x line gap saw placed online fcur maxx nw wst hc acc
            else
            if to_lower tag == "br" then
              walk rest 0 (line + 1) false saw false false fcur (if x > maxx then x else maxx) nw wst hc
                // Its box is a content area like any other inline box's — the font's ascent and descent
                // about the LINE's baseline — and not the height of the line. They are the same number
                // until `line-height` differs from the font, and then a `<br>` on a 16px line reported
                // 16 tall at the line's top where the browser says 22, three pixels above it.
                (Cons (box { tag = "br", x = (x + f.upem / 2) / f.upem,
                             y = ltop hs line + hbase hs line
                                 - (Font.line_height f est.fs
                                    - Font.scale f (0 - f.descender) est.fs),
                             w = 0, h = Font.line_height f est.fs,
                             pinned = false, pinx = false, cp = 0, fg = 0, bg = 0 - 1, fs = 0, layer = 3, bc = 0, bt = 0, br = 0, bb = 0, bl = 0, src = "" }, acc))
            else
            if est.float_ == "left" || est.float_ == "right" then
              // Beside the line, not on it: it does not move the cursor, does not make the line exist, and
              // its own box goes down here so that it lands in document order.
              let fw = Font.text_units f (_collapse_ws (_inline_text ks "")) * est.fs
                       + (est.bl + est.pl + est.pr + est.br) * f.upem in
              walk rest x line gap saw placed online (fcur + fw) maxx nw wst hc
                (list_append acc
                   (Cons (box { tag = to_lower tag, x = (fcur + f.upem / 2) / f.upem, y = 0,
                                w = (fw + f.upem / 2) / f.upem, h = lh,
                                pinned = false, pinx = false, cp = 0, fg = 0, bg = 0 - 1, fs = 0, layer = 3, bc = 0, bt = 0, br = 0, bb = 0, bl = 0, src = "" }, Nil)))
            else
            if est.display == "inline-block" || est.display == "inline-table"
               || to_lower tag == "img" then
              // An ATOMIC inline-level box. It sits on the line like a word: it does not break, nothing
              // inside it is on this line, and the line grows to hold it. It was laid out as
              // block-level, which gave it a line of its own — one document out of 126 and fourteen out
              // of 228, and the comment admitting it read like a note for later until the corpus was
              // wide enough to price it.
              let ae = _elem_of tag attrs in
              // An image is atomic for the same reason an inline-block is — it sits on the line like a
              // word and nothing inside it is on this line — but its size comes from the file rather
              // than from measuring content it does not have.
              let is_img = to_lower tag == "img" in
              let ist = if is_img then _img_style docdir attrs cw est
                        else if est.w >= 0 || est.w_pct >= 0 then est
                        else _with_width est (_max_content f ua author wst (Cons (ae, anc)) ks) in
              let (abs1, ah, _am1, _am2, _afe) = _block f docdir ua author wst anc tag attrs ks cw (0 - 1) ist in
              let abs0 = if is_img then _img_box abs1 ist (Img.resolve docdir (_attr attrs "src")) else abs1 in
              let abw = match abs0 with Nil -> 0 | Cons (m0, _r0) -> m0.w in
              // The MARGIN box is what takes room on the line; `_block` reports the border box.
              let advu = (ist.ml + abw + ist.mr) * f.upem in
              // It breaks like a word and for the same reason: what does not fit goes on the next line,
              // and what is wider than the whole line gets a line of its own and overflows.
              let sxa = if gap && placed then x + space_u * wst.fs else x in
              let (ax, al) = if not placed then (x, line)
                             else if sxa + advu <= cap then (sxa, line)
                             else (0, line + 1) in
              // Where its baseline is, which is the whole of why a line is not a fixed height.
              //
              // An atomic box with in-flow line boxes of its own puts its LAST line's baseline on the
              // line's, so it sits exactly like text. One with none — its content is blocks, or there is
              // no content — puts its bottom MARGIN edge there instead and hangs entirely above the
              // baseline. That is the difference between an inline-block of text being exactly as tall
              // as the line it is on and one holding a block making the line taller than itself by the
              // strut's descent, which is five pixels that look like an off-by-one and are not.
              let rec kid_block = fn (xs: node list) ->
                match xs with
                | Nil -> false
                | Cons (k2, more3) ->
                  match k2 with
                  | Element (kt, ka, _kk) ->
                    if _is_block_level (style_of ua author (_elem_of kt ka) (Cons (ae, anc))
                                          (_attr ka "style") est).display
                    then true else kid_block more3
                  | _ -> kid_block more3 in
              // An image has no line boxes of its own — there is nothing in it to have them — so its
              // bottom margin edge goes on the baseline and it hangs entirely above it. That is why a
              // 32-tall image makes a 37-tall line: the five below are the strut's descent, which is
              // there whether or not anything sits in it.
              let has_lines = not is_img
                              && not (kid_block ks) && _collapse_ws (_inline_text ks "") != "" in
              let mh = ist.mt + ah + ist.mb in
              let a_below = if has_lines then desc else 0 in
              let a_above = mh - a_below in
              // `vertical-align: top` puts the box's top at the LINE's top rather than its baseline
              // anywhere. It still has to make the line tall enough to hold it, which is why it
              // contributes its whole height above and nothing below — the same arithmetic reaching the
              // same place from the other end. Only `top` and the baseline are here; the corpus has not
              // asked for the others.
              let top_aligned = est.valign == "top" in
              let ay = if top_aligned then ltop hs al
                       else ltop hs al + hbase hs al - a_above in
              walk rest (ax + advu) al false saw true true fcur
                   (if ax + advu > maxx then ax + advu else maxx) nw wst
                   (Cons ((al, (if top_aligned then 0 else a_above),
                           (if top_aligned then 0 else a_below),
                           (if top_aligned then mh else 0)), hc))
                   (list_append (list_rev (_shift abs0 ((ax + f.upem / 2) / f.upem)
                                                     (ay + ist.mt))) acc)
            else
            let lead = (est.bl + est.pl) * f.upem in
            let trail = (est.pr + est.br) * f.upem in
            // A break opportunity BEFORE an inline element is where the line ends when the element's
            // opening edge and its first word will not fit together. Adding the edge at the cursor and
            // then wrapping only the word strands the border at the end of the line it left, and reports
            // the element as a fragment across two lines where the browser has it on one.
            let fw1 =
              let t = _collapse_ws (_inline_text ks "") in
              let i = str_index_of t " " in
              Font.text_units f (if i >= 0 then substring t 0 i else t) * est.fs in
            let wrapb = placed && not nw && cap > 0 && fw1 > 0 && sx0 + lead + fw1 > cap in
            let sx = if wrapb then 0 else sx0 in
            let sl = if wrapb then line + 1 else line in
            // The children start where the BOX starts — past the space owed from before it and past this
            // element's own left edge. Starting them at the plain cursor made the box a space narrower
            // than its own border: five pixels of border reported as one.
            //
            // An element that consumes nothing still has to hand the space back, which is why the gap is
            // restored afterwards rather than passed in. Swallowing it cost eleven documents once.
            let (inner, x2u, l2, g2a, saw2, fcur2, mx2, hc2, on2) =
              // Starting the inner walk's rightmost at ZERO and not at the outer one: the union this
              // element reports is of ITS fragments, and inheriting the widest anything before it
              // reached made a span as wide as whatever preceded it on the line.
              walk ks (sx + lead) sl false saw (placed && not wrapb)
                   (online || lead + trail > 0) fcur 0
                   (nw || est.ws == "nowrap" || est.ws == "pre") est hc Nil in
            let g2 = if x2u == sx + lead then gap else g2a in
            // Still not right for `block-in-inline-nested-002-ref`, and the residue is one space: the
            // browser puts an inline element four pixels to the left of where this does, once, at the
            // boundary between a text run and the element after it. The width is right now and the offset
            // is not, which means the space is being counted on both sides of the same boundary somewhere
            // — measured, not yet located.
            let x2 = x2u + trail in
            // The union of the element's fragments, which for one line is where it started to where it
            // ended. A box spanning two lines is reported by the browser as the whole span from the
            // first line's start to the last line's end, and that is what this gives.
            // A right-to-left line is filled from the right, so a fragment's left edge is the width less
            // where it ENDS. Mirroring the whole extent rather than each coordinate keeps the box the same
            // size it was, which is the only part of it the direction does not change.
            // A fragment that spans lines starts at the LINE's left edge and not at its own first
            // fragment's, because the union of its fragments reaches back to wherever the second line
            // began. Reading the first fragment's start put an `<a>` that wraps at x = 694 — where its
            // first line picks up near the right margin — instead of at 8, where its second line starts.
            let bx = if rtl then cw - (x2 + f.upem / 2) / f.upem
                     else if l2 == sl then (sx + f.upem / 2) / f.upem
                     else (float_w + f.upem / 2) / f.upem in
            // The WIDTH is the scaled difference, not the difference of two scaled numbers. Rounding each
            // end and subtracting rounds twice and lands a pixel out — the same "scale once" the glyph
            // advances and the table columns already needed, met a third time.
            // Across lines it reaches from that left edge to the rightmost point any of its fragments
            // got to, which the walk has been tracking. The floor of `cw - bx` that used to be here was
            // the container's width, and a union of fragments is not the container: it made an element
            // that wraps three pixels too wide, and it was right only where the widest fragment happened
            // to fill the line.
            let across = let m = if mx2 > x2 then mx2 else x2 in
                         let byw = (m + f.upem / 2) / f.upem - bx in
                         if byw > 0 then byw else 0 in
            let bw = if l2 == sl then (x2 - sx + f.upem / 2) / f.upem else across in
            // Relative positioning moves an inline fragment and its contents after they are laid out,
            // exactly as it does a block: the cursor, the line and everything after are unmoved.
            let rdx = if est.position == "relative" && est.left >= 0 then est.left else 0 in
            let rdy = if est.position == "relative" && est.top >= 0 then est.top else 0 in
            // An inline box's own area is the FONT's, not the LINE's, and it is not the same box once
            // they can differ. The content area is the font's ascent and descent about the line's
            // baseline — so with `line-height: 1` it is TALLER than the line it sits on and hangs out of
            // it — and the padding and border are outside that. Vertical padding on an inline was being
            // dropped entirely: `padding: 0.5em 0` on a span reported 22 tall where the browser says 38.
            //
            // Across lines it runs from the first line's content top to the last line's content bottom,
            // which is not the sum of the line heights the moment anything on one of them is taller than
            // text.
            // In the ELEMENT's font and not the box's. A `font-size: 0.2em` span on a line set at 5em
            // has a content area of its own size, sitting on the line's baseline — 22 pixels tall on an
            // 80-pixel line, not 109. The baseline is the line's; only the ascent and descent about it
            // belong to the element.
            let enat = Font.line_height f est.fs in
            let ednat = Font.scale f (0 - f.descender) est.fs in
            let fasc = enat - ednat in
            let fy = ltop hs sl + hbase hs sl - fasc - est.pt - est.bt in
            let fbot2 = ltop hs l2 + hbase hs l2 + ednat in
            // NOT the union with its descendants, and this has now been tried TWICE and measured twice.
            // `block-in-inline-nested-002-ref` wants a `<span>` with no border of its own to be ten pixels
            // taller than its line because the child inside it has a 5px border, which reads exactly like
            // a union. It was tried before the content area above was right and cost two documents, and
            // again after — at which point it costs one, `block-in-inline-append-002-nosplit-ref`, and
            // still gains none. So one of those two failures was the content area and the other was not
            // the union either.
            //
            // What the browser reports is the union of the element's own FRAGMENTS. Whatever makes that
            // fragment taller in this one document is something else, and writing down which experiments
            // have been run is worth more here than another guess: the obvious repair is a net loss and
            // will look obvious again next time.
            walk rest x2 l2 g2 (saw2 || _is_block_level est.display) (placed || x2 > sx)
                 (online || on2 || lead + trail > 0 || x2 > sx) fcur2
                 (if mx2 > maxx then mx2 else maxx) nw wst hc2
                 (list_append (_shift inner rdx rdy)
                    (Cons (box { tag = to_lower tag, x = bx + rdx, y = fy + rdy,
                                 w = if bw < 0 then 0 else bw,
                                 // An element that advanced nothing and has no edges has no height — but
                                 // only when there is no LINE for it to sit on. Inside others that have
                                 // taken room it is on their line and is a line tall.
                                 h = if l2 == sl && x2 == sx && est.bt + est.bb == 0
                                        && not online && lead + trail == 0 then 0
                                     else fbot2 + est.pb + est.bb - fy,
                                 // An inline box's background, border and paint layer, which were all
                                 // absent: it was built with no background, no border and the
                                 // block-level layer. So `background: green` on a `<span>` painted
                                 // nothing at all, which is not a paint-ORDER bug and looked like one —
                                 // the pair that exposed it has an inline-block over an inline and only
                                 // the inline-block was ever drawn.
                                 pinned = false, pinx = false, cp = 0, fg = 0, bg = est.bg, fs = 0,
                                 layer = est.layer, bc = est.bc, bt = est.bt, br = est.br, bb = est.bb, bl = est.bl, src = "" }, acc)))
          | Comment _c ->
            walk rest x line gap saw placed online fcur (if x > maxx then x else maxx) nw wst hc acc
          | Doctype (_p, _q, _r) ->
            walk rest x line gap saw placed online fcur (if x > maxx then x else maxx) nw wst hc acc in
      walk kids (float_w + tiu) 0 false false false false 0 0 nw0 bst Nil Nil in
    let (bs0, x0, line0, _g0, saw0, _fc0, _mx0, hc0, on0) = onepass Nil in
    // Nothing but text on any line means the first pass already placed everything against the right
    // tops, and the second is skipped. This is the common case by a long way.
    let (bs, x, line, saw, hc, on) =
      match hc0 with
      | Nil -> (bs0, x0, line0, saw0, hc0, on0)
      | Cons (_c0, _r0) ->
        let (bs1, x1, line1, _g1, saw1, _fc1, _mx1, hc1, on1) = onepass hc0 in
        (bs1, x1, line1, saw1, hc1, on1) in
    let n = if x == float_w + tiu && line == 0 && not on then 0 else line + 1 in
    // The third answer: whether anything block-level turned up inside. Asking that as a QUERY before
    // laying out means walking every descendant of every element and resolving its style each time —
    // which is a square, and here it was worse than one and did not finish. Reporting it
    // from the walk that was happening anyway costs nothing, and the caller retries.
    //
    // The HEIGHT is returned as well as the line count, and they are no longer the same fact. A caller
    // that multiplies a count by the line height gets the wrong answer for any line that had something
    // taller than text on it; a caller that still wants the count — the block-in-inline split does —
    // gets that too.
    (list_rev bs, n, ltop hc n, saw)

  and _table = fn (f: font) -> fn (docdir: str) -> fn (ua: prepared list) -> fn (author: prepared list) ->
               fn (anc: elem list) -> fn (kids: node list) -> fn (st: sty) -> fn (avail: int) ->
               // One pixel on every cell when the table itself carries `border`, and zero otherwise.
               fn (cellb: int) ->
    let sp = st.spacing in
    // The vertical gap is its own number: `border-spacing: 0 5px` puts nothing between the columns and
    // five pixels between the rows, and one field could only be one of those.
    let spv = st.spacing_v in
    let tfs = st.fs in
    let lh = Font.line_height f tfs in
    let groups = _kids_of f docdir ua author st anc kids in
    let rows_of = fn (g: (str * attr list * node list * sty)) ->
      let (_gt, _ga, gk, _gs) = g in _kids_of f docdir ua author st anc gk in
    // A column is measured in FONT UNITS, not pixels. Rounding the width first and then asking whether
    // the text fits in it wraps a line whose text is 71.2 wide into a column of 71 — the column was
    // sized from that very text, so it has to be compared against it at the same precision.
    // A column is as wide as its widest cell's CONTENT, and content is not only text. A cell holding
    // a `<div style="width: 5em">` and no words measured zero, so the table came out eight pixels wide
    // — its own border and nothing else — wrapped around an eighty-pixel box.
    //
    // Text is still measured in font units directly rather than through the pixel figure, because that
    // is the precision the whole column algorithm is built on; the block width arrives already rounded
    // to whole pixels and converting it back is exact.
    // Measured in the same `pixels x units-per-em` accumulator the rest of the engine now uses, and
    // taken from the structure rather than from the cell's text run together. The text fallback that
    // used to sit beside this ignored structure entirely — it concatenated every descendant's words,
    // so a cell holding `a<span display:inline-table>bcd</span>e` and a hidden block asked for all of
    // them side by side and came out thirteen pixels too wide.
    //
    // The accumulator and not the pixel figure, because a column is compared against the very text it
    // was measured from and half a pixel decides whether that text fits.
    let cell_units = fn (c: (str * attr list * node list * sty)) ->
      let (_ct, _ca, ck, _cs) = c in
      let (b, r, t) = _mc_acc f ua author st anc ck 0 0 0 in
      let acc = r - t in
      let bacc = b * f.upem in
      if bacc > acc then bacc else acc in
    let extra = fn (c: (str * attr list * node list * sty)) ->
      let (_ct, _ca, _ck, cs) = c in
      cs.pl + cs.pr + (if cs.bl + cs.br == 0 then 2 * cellb else cs.bl + cs.br) in
    let rec col_widths = fn (gs: (str * attr list * node list * sty) list) -> fn (acc: int list) ->
      match gs with
      | Nil -> acc
      | Cons (g, more) ->
        let rec per_row = fn (rs: (str * attr list * node list * sty) list) -> fn (a: int list) ->
          match rs with
          | Nil -> a
          | Cons (r, rest) ->
            let (_rt, _ra, rk, _rs) = r in
            let rec merge = fn (cs: (str * attr list * node list * sty) list) ->
                            fn (old: int list) -> fn (out: int list) ->
              match cs with
              | Nil -> list_append (list_rev out) old
              | Cons (c, more2) ->
                let w = cell_units c in
                match old with
                | Nil -> merge more2 Nil (Cons (w, out))
                | Cons (o, orest) -> merge more2 orest (Cons ((if w > o then w else o), out)) in
            per_row rest (merge (_kids_of f docdir ua author st anc rk) a Nil) in
        col_widths more (per_row (rows_of g) acc) in
    let cols = col_widths groups Nil in
    let ncols = list_len cols in
    // The box widths, one per column, in pixels: the content scaled once plus what the box model adds.
    // The padding is taken from the first row's cells, which is where a table with a colgroup would
    // need something better.
    let pad0 =
      match groups with
      | Nil -> 0
      | Cons (g, _m) ->
        match rows_of g with
        | Nil -> 0
        | Cons (r, _mm) ->
          let (_rt, _ra, rk, _rs) = r in
          match _kids_of f docdir ua author st anc rk with
          | Nil -> 0
          | Cons (c, _m2) -> extra c in
    let px_cols0 = list_map cols (fn (u: int) -> (u + f.upem / 2) / f.upem + pad0) in
    let _sum = fn (xs: int list) ->
      let rec go = fn (ys: int list) -> fn (a: int) ->
        match ys with Nil -> a | Cons (x, r) -> go r (a + x) in
      go xs 0 in
    let sum0 = _sum px_cols0 in
    // A table with no rows in it still has contents. `<div style="display: table">test</div>` has no
    // `<tr>` and no `<td>`, and the standard generates them: the text is wrapped in an anonymous cell
    // inside an anonymous row. What is here is NOT that — it is the width of the case where there are
    // no rows at all, which is the table shrinking to fit what it holds. The anonymous boxes themselves
    // are still missing, so the contents generate no boxes and only the table's own width is right.
    // The corpus has one document that asks and it asks only for the width.
    let inner = if ncols == 0 then _max_content f ua author st anc kids
                else sum0 + sp * (ncols + 1) in
    let table_w = if st.w >= 0 then st.w else if inner > avail then avail else inner in
    // The COLUMNS are what absorbs the difference between the width the table wanted and the width it
    // got, in EITHER direction. Left at their natural size, a table clamped to 400 reported a row and a
    // cell 1181 wide inside itself — a box wider than the box it is in — and a table TOLD to be 400
    // reported them 236 wide inside a 400 box, which is the same mistake with the sign flipped. Shared
    // out in proportion, last column taking the remainder so the parts add up to the whole exactly.
    let room = table_w - sp * (ncols + 1) in
    let px_cols =
      if ncols == 0 || sum0 == room || sum0 <= 0 || room < 0 then px_cols0
      else
        let rec squeeze = fn (xs: int list) -> fn (rem: int) -> fn (out: int list) ->
          match xs with
          | Nil -> list_rev out
          | Cons (x, rest) ->
            match rest with
            | Nil -> list_rev (Cons ((if rem < 0 then 0 else rem), out))
            | Cons (_y, _r) ->
              let w = (x * room) / sum0 in
              squeeze rest (rem - w) (Cons (w, out)) in
        squeeze px_cols0 room Nil in
    let sum_cols = _sum px_cols in
    // A row reaches from the first cell's left edge to the last one's right, and the gaps BETWEEN the
    // columns are inside that. `sum_cols` is the columns alone; a two-column row was reported four
    // pixels wide when its two cells sit at 10 and 14 and are two wide each. The spacing outside the
    // first and last columns is not part of a row — that belongs to the table.
    let row_w = sum_cols + (if ncols > 1 then (ncols - 1) * sp else 0) in
    // ...and it lays those contents out as a block container would, which is the anonymous cell the
    // standard generates standing in for itself. Only when there are no rows: with rows the cells are
    // real and none of this is reached. It is enough for a table whose content is one paragraph and is
    // not enough for one that mixes bare text with real rows — the standard's rule for that wraps the
    // stray content in its own anonymous row, and this does not.
    let (nobs, nobh) =
      if ncols > 0 then (Nil, 0)
      else
        let rtl0 = match anc with
                   | Nil -> false
                   | Cons (_a0, _up0) -> st.dir == "rtl" in
        let (ibs0, _in0, ih0, _isaw0) = _inline f docdir ua author st anc kids table_w in
        (ibs0, ih0) in
    // Document order, built forwards. A table's boxes are a group, then its rows, and each row's cells
    // straight after it — an accumulator that is reversed at the end puts the cells before their row.
    let rec lay = fn (rowex: int) -> fn (gs: (str * attr list * node list * sty) list) -> fn (y: int) ->
                  fn (rem: int) -> fn (acc: box list) ->
      match gs with
      | Nil -> (acc, y, rem)
      | Cons (g, more) ->
        let (gt, _ga, _gk, _gs) = g in
        let rec lay_rows = fn (rs: (str * attr list * node list * sty) list) -> fn (ry: int) ->
                           fn (rem2: int) -> fn (a: box list) ->
          match rs with
          | Nil -> (a, ry, rem2)
          | Cons (r, rest) ->
            let (rt, _ra, rk, _rs) = r in
            let cells = _kids_of f docdir ua author st anc rk in
            // A cell is a block container and its contents are LAID OUT, not estimated. They used to be
            // estimated — a line count over the cell's text — which gave a plausible height for a cell
            // holding one paragraph and no boxes at all for whatever was inside it. Eight documents in
            // the corpus put something in a cell and all eight had the wrong box SEQUENCE, the more
            // fundamental of the two numbers: the children were not there to be measured, so a plausible
            // height was the best the estimate could ever have been.
            //
            // Laid out once and kept. The height decides the row and the boxes are the output; asking
            // twice would lay every cell out twice for one answer. `_block` sizes a border box against
            // the containing block it is handed, so the column's pixel width goes in and the cell comes
            // back exactly as wide as the table decided.
            //
            // The width it is laid out at is not always the width it is REPORTED at, and the reason is
            // the one this file has met three times before: round where the answer is read, not where it
            // is computed. A column is as wide as the widest content in it, so that content fits in the
            // column BY CONSTRUCTION — and a column whose true width is 73.4px is reported as 73, which
            // the text no longer fits in. Handing the rounded number back to line breaking wrapped
            // `Filler Text` onto two lines inside a column that had just been measured from it.
            //
            // So the box is reported at the rounded width and laid out at the width rounded UP, which is
            // the smallest integer that keeps the property the column was built on. They differ by at
            // most a pixel and only where the rounding went down.
            let rec lay_cells = fn (cs: (str * attr list * node list * sty) list) ->
                                fn (ws: int list) -> fn (out: (box list * int * str) list) ->
              match cs with
              | Nil -> list_rev out
              | Cons (c, more2) ->
                let (ct, ca, ck, cst0) = c in
                let cst = if cellb > 0 && cst0.bt + cst0.bb + cst0.bl + cst0.br == 0
                          then _with_border cst0 cellb else cst0 in
                let cw2 = match ws with Nil -> 0 | Cons (w, _r) -> w in
                let (cbs, ch, _m1, _m2, _fe) = _block f docdir ua author st anc ct ca ck cw2 (0 - 1) cst in
                lay_cells more2 (match ws with Nil -> Nil | Cons (_w, rr) -> rr)
                          (Cons ((cbs, ch, cst.valign), out)) in
            let laid = lay_cells cells px_cols Nil in
            // Every cell in a row is as tall as the tallest, which is what makes a row a row.
            let rh0 = let rec go = fn (ls: (box list * int * str) list) -> fn (best: int) ->
                        match ls with
                        | Nil -> best
                        | Cons (l, more2) ->
                          let (_b2, h2, _v2) = l in go more2 (if h2 > best then h2 else best) in
                      go laid 0 in
            // A table with a stated height is TALLER than its rows want to be, and the difference is
            // theirs: the rows share it out, and the first one takes what does not divide evenly. A row
            // is as tall as its tallest cell OR as tall as the table needs it, whichever is more.
            let rh = rh0 + rowex + rem2 in
            let rec place = fn (ls: (box list * int * str) list) -> fn (ws: int list) ->
                            fn (x: int) -> fn (a2: box list) ->
              match ls with
              | Nil -> a2
              | Cons (l, more2) ->
                let (cbs, ch2, cva) = l in
                let cw2 = match ws with Nil -> 0 | Cons (w, _r) -> w in
                // `vertical-align` on a cell moves its CONTENTS inside a box the row's height decided.
                // It is the same property name as the one that puts an inline-block on a line and it is
                // a different question — one asks where a box sits among others on a line, this asks
                // where the contents sit in a box that is already taller than they are.
                let vgap = if cva == "bottom" then rh - ch2
                           else if cva == "middle" then (rh - ch2) / 2
                           else 0 in
                // The cell's own box takes the ROW's height and not the height it was laid out at —
                // that is the whole of what a row is. Its contents keep theirs and move with it.
                let cell_bs = match cbs with
                              | Nil -> Nil
                              | Cons (me, inside) ->
                                Cons (box { tag = me.tag, x = x, y = ry, w = cw2, h = rh,
                                            pinned = false, pinx = false, cp = 0,
                                            fg = me.fg, bg = me.bg, fs = me.fs, layer = me.layer, bc = me.bc, bt = me.bt, br = me.br, bb = me.bb, bl = me.bl, src = me.src },
                                      _shift inside x (ry + vgap)) in
                place more2 (match ws with Nil -> Nil | Cons (_w, rr) -> rr) (x + cw2 + sp)
                      (list_append a2 cell_bs) in
            let row_box = box { tag = to_lower rt, x = sp, y = ry, w = row_w, h = rh,
                                pinned = false, pinx = false, cp = 0, fg = 0, bg = 0 - 1, fs = 0, layer = 3, bc = 0, bt = 0, br = 0, bb = 0, bl = 0, src = "" } in
            lay_rows rest (ry + rh + spv) 0
                     (place laid px_cols sp (list_append a (Cons (row_box, Nil)))) in
        let gy = y + spv in
        let (a2, gy2, rem3) = lay_rows (rows_of g) gy rem acc in
        // The group's own box is placed before its rows, so it is spliced in rather than appended: its
        // height is not known until the rows are laid out, and document order does not wait for that.
        let gbox = box { tag = to_lower gt, x = sp, y = gy, w = row_w, h = gy2 - spv - gy,
                         pinned = false, pinx = false, cp = 0, fg = 0, bg = 0 - 1, fs = 0, layer = 3, bc = 0, bt = 0, br = 0, bb = 0, bl = 0, src = "" } in
        lay rowex more (gy2 - spv) rem3
            (list_append acc (Cons (gbox, _drop acc a2))) in
    // A `<tfoot>` is laid out after the bodies whatever order it was written in, and a `<thead>` before
    // them — but both are still REPORTED where the document put them. Two different orders over the same
    // groups: one decides the y, the other decides the box list, and using one for both puts the footer's
    // rows in the middle of the table.
    let tag_of = fn (g: (str * attr list * node list * sty)) ->
      let (t, _a, _k, _s) = g in to_lower t in
    let heads = list_filter groups (fn (g: (str * attr list * node list * sty)) ->
                                      tag_of g == "thead") in
    let foots = list_filter groups (fn (g: (str * attr list * node list * sty)) ->
                                      tag_of g == "tfoot") in
    let bodies = list_filter groups (fn (g: (str * attr list * node list * sty)) ->
                                       tag_of g != "thead" && tag_of g != "tfoot") in
    // Laid out twice when the table states a height, and once otherwise. The rows have to be placed
    // before their natural total is known, and the share each of them gets of a stated height cannot be
    // worked out until that total is. A table is small and states a height rarely; the guard is what
    // keeps this from being a second layout of every table in the document.
    let nrows =
      let rec cg = fn (gs: (str * attr list * node list * sty) list) -> fn (n: int) ->
        match gs with
        | Nil -> n
        | Cons (g, more) -> cg more (n + list_len (rows_of g)) in
      cg groups 0 in
    let natural =
      if st.h < 0 then 0
      else
        let (_h0, n1, _r1) = lay 0 heads 0 0 Nil in
        let (_b0, n2, _r2) = lay 0 bodies n1 0 Nil in
        let (_f0, n3, _r3) = lay 0 foots n2 0 Nil in
        n3 + spv in
    // A table's stated height is its BORDER box, not its content box — which is what the browser
    // reports for one and is why `height="200"` on a bordered table comes back as 200 and not 202.
    let want_h = if st.h < 0 then 0 - 1 else st.h - st.bt - st.bb in
    let slack = if want_h >= 0 && want_h > natural && nrows > 0 then want_h - natural else 0 in
    let rowex = if nrows == 0 then 0 else slack / nrows in
    let rem0 = slack - rowex * nrows in
    let (hbs, y1, rr1) = lay rowex heads 0 rem0 Nil in
    let (bbs0, y2, rr2) = lay rowex bodies y1 rr1 Nil in
    let (fbs0, y3, _rr3) = lay rowex foots y2 rr2 Nil in
    let bbs = bbs0 in
    let fbs = fbs0 in
    // Written before the bodies means reported before them, which is the only thing left to decide.
    let foot_first =
      let rec go = fn (gs: (str * attr list * node list * sty) list) ->
        match gs with
        | Nil -> false
        | Cons (g, more) ->
          if tag_of g == "tfoot" then true
          else if tag_of g == "thead" then go more
          else false in
      go groups in
    let bs = list_append hbs (if foot_first then list_append fbs bbs
                              else list_append bbs fbs) in
    let endy = y3 in
    // The last row already left a spacing behind it, so one more closes the table and two would count
    // the gap after the final row twice.
    (if ncols == 0 then nobs else bs, table_w, if ncols == 0 then nobh else endy + spv)

  // One block box and everything under it, at coordinates relative to its own border box.
  and _block = fn (f: font) -> fn (docdir: str) -> fn (ua: prepared list) -> fn (author: prepared list) ->
               fn (pst: sty) ->
               fn (ancestors: elem list) -> fn (tag: str) -> fn (attrs: attr list) ->
               fn (kids: node list) -> fn (cbw: int) -> fn (cbh: int) -> fn (st: sty) ->
    // A block box fills its containing block unless it says otherwise. `width` is the CONTENT
    // width, so the border box is wider by its own borders and padding — that difference is what
    // `getBoundingClientRect` reports and the place a box model is usually wrong.
    let pct = if st.w_pct >= 0 then (cbw * st.w_pct) / 100 else 0 - 1 in
    // `box-sizing: border-box` makes `width` state the BORDER box, so the borders and padding come out
    // of the stated number rather than being added to it. It is one property that changes what two
    // others mean, and a `width: 3em` box with 2em borders on both sides is 64px wide under one reading
    // and 112 under the other — which is the whole of the difference the corpus reports.
    // A TABLE's stated width and height are its border box, whatever `box-sizing` says: that is what
    // the standard means by "the height of the table box" in the separated-borders model, and it is
    // what the browser reports. `height="200"` on a table with a 1px border comes back as 200, not 202.
    let bsz_eff = if st.display == "table" then "border-box" else st.bsz in
    let h_edges = st.bl + st.br + st.pl + st.pr in
    let stated_w = if pct >= 0 then pct else if st.w >= 0 then st.w else 0 - 1 in
    let content_w =
      if stated_w >= 0 then
        (if bsz_eff == "border-box" then
           (let c = stated_w - h_edges in if c < 0 then 0 else c)
         else stated_w)
      else cbw - st.ml - st.mr - h_edges in
    let cw0 = if content_w < 0 then 0 else content_w in
    let e = _elem_of tag attrs in
    let inner_ancestors = Cons (e, ancestors) in
    // A table's width is decided by its own contents rather than handed down from the containing block,
    // so the table is laid out before the box is sized and not after.
    // NOT `inline-table`, and that is measured rather than an oversight. An inline-table IS a table —
    // it differs from `table` in where it sits and not in how its rows are worked out — and letting it
    // in here cost a document and gained none. The reason is the gap named at the rowless-table branch
    // in `_table`: the standard generates anonymous row-group and row boxes around a stray cell, and
    // this does not. The corpus's inline-tables are written `<span display:inline-table><span
    // display:table-cell>`, with no row between them, so admitting them to the table algorithm hands
    // that algorithm a table with no rows and takes away the block layout that was accidentally closer.
    //
    // The anonymous boxes are the fix; this line is the symptom. And they are not the WHOLE fix, which
    // is the part worth having written down: with anonymous row and row-group boxes added — a group or
    // row whose tag is empty, laid out like any other and not reported, which is why the box sequence
    // never asked for them and the geometry always did — the two `inline-table-valign` documents put
    // their table and their cell exactly where the browser does, and are still five pixels out on
    // everything after them, and the package is still a net loss of one.
    //
    // The five pixels are the third piece: **an inline-table's baseline is the baseline of its FIRST
    // ROW**, not its bottom margin edge. Sitting it on its bottom edge puts the strut's descent below a
    // baseline it never had. Three pieces, and any two of them are worth less than none — which is the
    // reason this is a comment and not a commit.
    let is_table = st.display == "table" in
    let (tbs, tw, th) =
      if is_table then
        _table f docdir ua author inner_ancestors kids st cw0
               (if _has_attr attrs "border" && st.bt > 0 then 1 else 0)
      else (Nil, 0, 0) in
    let cw = if is_table then tw else cw0 in
    // A parent's margin collapses with its first or last child's when nothing separates them —
    // no border and no padding on that side, and for the bottom, no stated height either. When
    // something does separate them the child's margin stays inside.
    // The root element is the third reason a margin does not collapse, and it is not a property
    // of the box: the standard says the root's margins simply do not collapse with anything. With
    // it missing, the body's margin escaped out of `<html>` and pushed the document itself down.
    let is_root = match ancestors with Nil -> true | Cons (_x, _y) -> false in
    // A box that establishes a block formatting context has to contain its floats. Being positioned,
    // floated, a table cell or anything but `overflow: visible` does it — and an ordinary block does
    // not, which is why a float can hang out of the bottom of its parent.
    let makes_bfc = st.position == "absolute" || st.position == "fixed" || st.float_ != "none"
                    || st.display == "table-cell" || st.display == "table"
                    || st.overflow != "visible" in
    // A formatting context is the fourth reason a margin does not collapse, and the one that reads as a
    // painting property: `html, body { overflow: scroll }` stops a paragraph's top margin collapsing
    // with the body's, which moves every box in the document down by the difference.
    let sep_top = is_root || makes_bfc || st.bt > 0 || st.pt > 0 in
    let sep_bot = is_root || makes_bfc || st.bb > 0 || st.pb > 0 || st.h >= 0
                  || (st.h_pct >= 0 && cbh >= 0) in
    // Inline content, if there is any, instead of a stack of blocks. A box whose children are text
    // establishes an inline formatting context, and its height is a count of LINES rather than a sum of
    // children. Mixing inline and block children in one parent needs the anonymous block boxes the
    // standard describes; that is not here, and a box with both is laid out as if it were all inline —
    // wrong for the mixture and right for everything this corpus has.
    // Whether any child is block-level. This is the question that decides which of the two formatting
    // contexts this box has, and it has to be asked before the text is looked at: `<html>` has
    // whitespace text nodes between `<head>` and `<body>`, so "does it contain text" answers yes for
    // every element in the document and laid the whole page out as one paragraph.
    let rec has_block = fn (xs: node list) ->
      match xs with
      | Nil -> false
      | Cons (k, more) ->
        match k with
        | Element (ktag, kattrs, _kk) ->
          let ke = _elem_of ktag kattrs in
          let kst = style_of ua author ke inner_ancestors (_attr kattrs "style") st in
          // Block-LEVEL, which is not the same as `display: block`. A `display: table-cell` with no
          // table around it is wrapped by the standard in an anonymous table, row group and row, and
          // the result sits in its parent's flow as a block does: it takes a line of its own.
          if _is_block_level kst.display then true else has_block more
        | Text _t -> has_block more
        | Comment _c -> has_block more
        | Doctype (_x, _y, _z) -> has_block more in
    // A block-level child means the white space around it is discarded, which is what the standard's
    // anonymous block boxes come to for whitespace-only inline content.
    let inline_only = not is_table && not (has_block kids)
                      && _collapse_ws (_inline_text kids "") != "" in
    let (ibs, _ilines, ih3, _sawb) =
      if inline_only then
        _inline f docdir ua author st inner_ancestors kids cw
      else (Nil, 0, 0, false) in
    let (bs, used, open_mb, first_mt, bottom, fbot) =
      if is_table then (tbs, th, 0, 0, th, 0)
      // A block met inside what looked like inline content means it was not inline content. The flag
      // comes back from the walk rather than being asked for beforehand, and here it is the difference
      // between laying a document out as one paragraph and laying it out at all.
      else if inline_only && not _sawb then
        let h = ih3 in (ibs, h, 0, 0, h, 0)
      else _stack f docdir ua author st inner_ancestors kids cw (if st.h >= 0 then st.h else 0 - 1) 0 0 (not sep_top) 0 false 0 (0, 0) Nil in
    // The fragment's origin is (the containing block's content left, this border box's top): x is
    // measured from outside the margin because a horizontal margin is an offset, y from the border
    // box because a vertical one collapsed into the gap above. So a child clears this box's own
    // left margin as well as its border and padding — leaving `st.ml` out put every nested box at
    // the wrong x and only the outermost one right.
    let bw_total = st.bl + st.pl + cw + st.pr + st.br in
    // The CONTAINING BLOCK's direction, not this box's own. `direction` lays out what is inside a box;
    // a `<div direction: rtl>` is still placed from the left of an ordinary body, and only its children
    // are placed from the right. Reading it off the element itself moved the div to x = 690.
    let rtl = match ancestors with
              | Nil -> false
              | Cons (_par, _up) -> pst.dir == "rtl" in
    let bx0 = if rtl then cbw - st.mr - bw_total else st.ml in
    // The children clear the same edge the box was placed from, which in a right-to-left containing
    // block is not the left margin. Using `st.ml` here while the box itself was placed from the right
    // put every child of an RTL box at the wrong x and only the box right.
    let inner = _shift bs (bx0 + st.bl + st.pl) (st.bt + st.pt) in
    // The margin still hanging at the end is inside this box only if something separates it from
    // the bottom edge; otherwise it escapes and is the parent's to place.
    // To the last child's border box, and then the trailing margin only when something separates it
    // from this box's bottom edge. `used` is the cursor and is one margin too far.
    let in_flow_h = if sep_bot then bottom + (if open_mb > 0 then open_mb else 0) else bottom in
    let pct_h = if st.h_pct >= 0 && cbh >= 0 then (cbh * st.h_pct) / 100 else 0 - 1 in
    let v_edges = st.bt + st.bb + st.pt + st.pb in
    let stated_h = if pct_h >= 0 then pct_h else if st.h >= 0 then st.h else 0 - 1 in
    let content_h = if stated_h >= 0 then
                      (if bsz_eff == "border-box" then
                         (let c = stated_h - v_edges in if c < 0 then 0 else c)
                       else stated_h)
                    else if (makes_bfc || is_root) && fbot > in_flow_h then fbot
                    else in_flow_h in
    let h = st.bt + st.pt + content_h + st.pb + st.bb in
    // In a right-to-left containing block a box is placed from the RIGHT edge, so its offset is what is
    // left after its own width and its right margin — the same margin read from the other end. With this
    // missing, a block with `margin: 10px` in a 100px RTL container sat at 10 where the browser puts it
    // at 0.
    let me = box { tag = to_lower tag, x = bx0, y = 0, w = bw_total, h = h, pinned = false,
                   pinx = false, cp = 0, fg = st.color, bg = st.bg, fs = st.fs,
                   // Appendix E's step numbers: 4 for a float, 5 for inline-level in flow, 3 for the
                   // rest. Worked out here because layout already knows the display; a painter that
                   // asked would be a second cascade.
                   // Resolved in the cascade, because it INHERITS: everything inside an inline-level
                   // box paints with it, including a `display: block` child.
                   layer = st.layer,
                   bc = st.bc, bt = st.bt, br = st.br, bb = st.bb, bl = st.bl, src = "" } in
    // A fifth answer: how far a float inside this box reached, when this box does NOT contain floats.
    // The float escapes upward until something does contain it — and the initial containing block always
    // does, which is why a page is as tall as a float that overflowed every box on the way out.
    (Cons (me, inner), h,
     (if sep_top then st.mt else _collapse st.mt first_mt),
     (if sep_bot then st.mb else _collapse st.mb open_mb),
     // ...and NO float reached anywhere is not a float that reached this box's top border. `fbot` is
     // zero when nothing escaped, and adding the border and padding to it turned that zero into a
     // number — a `border: 100px` box with no float in it reported a float reaching 100 pixels down,
     // and the page grew to hold a float that does not exist.
     (if makes_bfc || fbot == 0 then 0 else fbot + st.bt + st.pt));

  // The font is a parameter and not a constant, because it is the one input to layout that is a file.
  // Loaded once per document: reading it per box would read half a megabyte for every element.
  // `docdir` is the directory the document was read from, which is what a relative `src` is relative
  // to. It is threaded rather than held somewhere because it is an input to layout in the same way the
  // font is: a document laid out from a different directory is a different document.
  let boxes_in = fn (docdir: str) -> fn (font_path: str) -> fn (roots: node list) ->
    let f = Font.load font_path in
    let ua = Style.prepare Style.ua_sheet in
    let author = Style.prepare (author_css roots "") in
    // The initial containing block is the viewport. Its own margin does not collapse out of the
    // document, so the root's top margin starts the stack rather than escaping it.
    let (bs, _y, _mb, _fm, _bot, _fb) =
      _stack f docdir ua author Style.root_style Nil roots viewport_w (0 - 1) 0 0 false 0 false 0 (0, 0) Nil in
    bs;

  // A document with no images does not need to know where it is.
  let boxes = fn (font_path: str) -> fn (roots: node list) -> boxes_in "" font_path roots;

  // The canonical form the gate compares, one line per box in document order.
  // ELEMENT boxes only. A glyph's box is in the same list and is not part of the box sequence the
  // gate compares — that number is about which elements generate boxes, and a character is not one.
  let render = fn (bs: box list) ->
    let one = fn (b: box) ->
      b.tag ++ "\t" ++ str_of_int b.x ++ "\t" ++ str_of_int b.y
      ++ "\t" ++ str_of_int b.w ++ "\t" ++ str_of_int b.h in
    str_join "\n" (list_map (list_filter bs (fn (b: box) -> b.cp == 0 && b.tag != "")) one);

  // The other half of the same list: where each CHARACTER was put. This is what a painter needs and
  // what nothing above layout could ask for — the engine computed it on every line and threw it away.
  let render_glyphs = fn (bs: box list) ->
    let one = fn (b: box) ->
      str_of_int b.cp ++ "\t" ++ str_of_int b.x ++ "\t" ++ str_of_int b.y
      ++ "\t" ++ str_of_int b.w ++ "\t" ++ str_of_int b.h in
    str_join "\n" (list_map (list_filter bs (fn (b: box) -> b.cp != 0)) one);
}
