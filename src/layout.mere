// Layout: a DOM in, a box per element out.
//
// **Normal flow for block boxes, with the box model and collapsing margins.** No floats, no
// positioning, no text measurement. Those are the next three slices and the gate says what each
// is worth before it is written, which is why the gate was built first.
//
// The recursion is bottom-up and then shifted. A box cannot be placed until its own top margin
// is known, and its top margin may have collapsed with its first child's, which is not known
// until the child is laid out — so children are laid out at coordinates relative to their
// parent's border box and the whole fragment is moved once its position is settled. Trying to
// place absolutely on the way down means guessing the margin and correcting later, and a
// correction pass is a second place where the answer is decided.

import "dom.mere";
import "style.mere";
import "font.mere";

// A laid-out box. `x` and `y` are document coordinates by the time `boxes` returns — the gate
// compares against `getBoundingClientRect`, which is absolute — and they are the BORDER box,
// which is what that call reports.
type box = { tag: str, x: int, y: int, w: int, h: int };

// A subtree becomes four things: its boxes relative to its own border-box top-left, the border
// box's height, and the two margins that ESCAPE it — a margin that collapsed through this box
// belongs to whoever places it, and that is the whole reason this is not just a box list.
//
// Returned as a tuple rather than a record because `_stack` and `_block` are mutually recursive
// and this language will not infer a record type across that boundary. A tuple destructures
// without needing one.

module Layout {
  // The viewport the gate's expectations were taken in. A constant rather than a parameter
  // because it is part of what the expected values MEAN: change it and every number in
  // `test/data/layout/*.expected` is wrong, so both have to change together and a default hides
  // that.
  let viewport_w = 800;

  // The one font size there is, because `font-size` is not resolved yet. It is the initial value and the
  // size the gate's expectations were taken at; when font-size lands this becomes a computed value and
  // this constant goes.
  let font_size = 16;

  // The displays that make a box block-level in its parent's flow. The table families are here because
  // an anonymous table is generated around them wherever one is missing, and an anonymous table is a
  // block.
  let _is_block_level = fn (d: str) ->
    d == "block" || d == "table" || d == "table-cell" || d == "table-row"
    || d == "table-row-group" || d == "table-caption";

  // The same style with its HORIZONTAL edges removed, and only those. The vertical ones do not belong
  // to the block piece either, and taking them out makes the block land at the right y while making the
  // inline's own box shorter — and the inline is already short of the 49 the split produces. Neither
  // choice moves the gate; this one leaves each box individually closer to the browser, which is the
  // tie-break when the count cannot decide.
  //
  // The same style with its horizontal edges removed. Written out because a record here is replaced
  // whole, and the alternative — a flag threaded into `_block` — would put the special case in the
  // general path instead of at the one call site that needs it.
  let _no_h_edges = fn (st: sty) ->
    sty { display = st.display, position = st.position, float_ = st.float_, spacing = st.spacing,
          overflow = st.overflow, left = st.left, top = st.top,
          w = st.w, h = st.h, w_pct = st.w_pct, h_pct = st.h_pct,
          mt = st.mt, mr = st.mr, mb = st.mb, ml = st.ml,
          pt = st.pt, pr = 0, pb = st.pb, pl = 0,
          bt = st.bt, br = 0, bb = st.bb, bl = 0 };

  let _shift = fn (bs: box list) -> fn (dx: int) -> fn (dy: int) ->
    list_map bs (fn (b: box) ->
      box { tag = b.tag, x = b.x + dx, y = b.y + dy, w = b.w, h = b.h });

  // Two adjoining margins collapse to one. Positive against positive is the larger; a negative
  // is added to the largest positive rather than compared with it, which is the standard's rule
  // and not the obvious one.
  let _collapse = fn (a: int) -> fn (b: int) ->
    let pos = if a > b then a else b in
    let mx = if pos < 0 then 0 else pos in
    let na = if a < 0 then a else 0 in
    let nb = if b < 0 then b else 0 in
    let mn = if na < nb then na else nb in
    mx + mn;

  let _attr = fn (attrs: attr list) -> fn (name: str) ->
    let rec go = fn (xs: attr list) ->
      match xs with
      | Nil -> ""
      | Cons (a, rest) -> if to_lower a.name == name then a.value else go rest in
    go attrs;

  // The document's own stylesheets, which for these documents means the text inside every
  // `<style>` element. Collected in one walk before layout starts rather than looked for during
  // it: a stylesheet is a property of the document, and finding it while placing boxes would
  // mean finding it once per box.
  let rec author_css = fn (ns: node list) -> fn (acc: str) ->
    match ns with
    | Nil -> acc
    | Cons (n, rest) ->
      match n with
      | Element (tag, _a, kids) ->
        if to_lower tag == "style" then
          let rec text_of = fn (xs: node list) -> fn (s: str) ->
            match xs with
            | Nil -> s
            | Cons (k, more) ->
              match k with
              | Text t -> text_of more (s ++ t)
              | _ -> text_of more s in
          author_css rest (acc ++ "\n" ++ text_of kids "")
        else author_css rest (author_css kids acc)
      | _ -> author_css rest acc;

  // One element's resolved style. The three origins in the order the cascade wants them: the UA
  // sheet loses to the author's sheet whatever the selectors say, and an inline `style=` beats
  // both. Encoded in the specificity, so `winner` needs to know nothing about origins.
  let style_of = fn (ua: prepared list) -> fn (author: prepared list) ->
                 fn (e: elem) -> fn (ancestors: elem list) -> fn (inline: str) ->
    let h1 = Style.hits_for ua 0 e ancestors 0 in
    let h2 = Style.hits_for author 1 e ancestors 0 in
    let h3 =
      // An inline `style=` is a declaration list with no selector, so it is given a specificity
      // above every selector rather than a place in the cascade of its own.
      list_map (list_filter (Rules.declaration_list inline)
                            (fn (r: rule) -> match r with Decl (_n, _v, _i) -> true | _ -> false))
               (fn (r: rule) ->
                  match r with
                  | Decl (name, value, _i) ->
                    hit { prop = to_lower name, value = Style.value_text value,
                          spec = 2 * 100000, order = 0 }
                  | _ -> hit { prop = "", value = "", spec = 0, order = 0 }) in
    Style.resolve (list_append h1 (list_append h2 h3)) e.tag;

  let _elem_of = fn (tag: str) -> fn (attrs: attr list) ->
    elem { tag = to_lower tag, id = _attr attrs "id", cls = to_lower (_attr attrs "class"),
           sty_attr = _attr attrs "style" };

  // ---- inline content ------------------------------------------------------------

  // The text of an inline run, with white space collapsed the way CSS collapses it: every run of
  // spaces, tabs and newlines becomes one space. Source indentation is white space, so without this a
  // paragraph written over three lines of a file is three times wider than it looks.
  let rec _inline_text = fn (ns: node list) -> fn (acc: str) ->
    match ns with
    | Nil -> acc
    | Cons (n, rest) ->
      match n with
      | Text t -> _inline_text rest (acc ++ t)
      // An inline element contributes its own text to the same run. It is transparent to line
      // breaking, which is what makes `a <b>bold</b> word` break between `bold` and `word`.
      | Element (_tag, _a, kids) -> _inline_text rest (_inline_text kids acc)
      | Comment _c -> _inline_text rest acc
      | Doctype (_x, _y, _z) -> _inline_text rest acc;

  let _is_space = fn (c: str) ->
    c == " " || c == "\t" || c == "\n" || c == "\r" || c == chr 12;

  // Runs of white space to one space, and the two ends removed. The ends go because a line box drops
  // the white space at its edges, and for a single-line paragraph that is the whole rule.
  let _collapse_ws = fn (s0: str) ->
    let n = str_len s0 in
    let rec go = fn (i: int) -> fn (out: str) -> fn (was_space: bool) ->
      if i >= n then out
      else
        let c = char_at s0 i in
        if _is_space c then
          go (i + 1) (if was_space || out == "" then out else out ++ " ") true
        else go (i + 1) (out ++ c) false in
    let t = go 0 "" false in
    if str_len t > 0 && char_at t (str_len t - 1) == " " then substring t 0 (str_len t - 1)
    else t;

  // White space collapsed to single spaces, with the ends KEPT: a space at the edge of a text node is
  // not at the edge of a line when another node follows it.
  let _collapse_runs = fn (s0: str) ->
    let n = str_len s0 in
    let rec go = fn (i: int) -> fn (out: str) -> fn (was: bool) ->
      if i >= n then out
      else
        let c = char_at s0 i in
        if _is_space c then go (i + 1) (if was then out else out ++ " ") true
        else go (i + 1) (out ++ c) false in
    go 0 "" false;

  // The inline content of a box, laid out into lines, with a box for every inline element in it.
  //
  // The second half of that is why this exists rather than a line count: an inline element has a box
  // and the gate compares it. Returning only a height dropped every `<span>` and `<strong>` in the
  // corpus and the box-sequence number fell from 126 to 57 in one commit — which is what that second
  // number is for.
  //
  // Everything is carried in font units until the end. `x` is how far along the current line the
  // cursor is, `line` counts from zero, and `gap` says a space is owed before the next word — a space
  // between two text nodes belongs to neither of them, so it cannot be part of either string.
  let _inline = fn (f: font) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                fn (anc: elem list) -> fn (kids: node list) -> fn (cw: int) -> fn (size: int) ->
                fn (rtl: bool) ->
    let cap = if cw <= 0 then 0 else (cw * f.upem) / size in
    let space = Font.text_units f " " in
    let lh = Font.line_height f size in
    // `gap` is a space owed from BEFORE this list — the boundary between two text nodes. Inside one
    // list the separator is implied by the split itself, so every word after the first gets a space
    // whatever the flag says, and the flag applies only to the first. Carrying it forward instead put
    // a space between `<span>One</span>` and `<span>Two</span>`, where the source has none.
    let rec words = fn (ws: str list) -> fn (x: int) -> fn (line: int) -> fn (gap: bool) ->
                    fn (first: bool) -> fn (placed: bool) ->
      match ws with
      | Nil -> (x, line, gap, placed)
      | Cons (w, rest) ->
        // An empty piece is where a space was, and a trailing one is how a list says it ended in one.
        if w == "" then words rest x line true first placed
        else
          let wu = Font.text_units f w in
          let need = if first then gap else true in
          if not placed then words rest (x + wu) line false false true
          else if x + (if need then space else 0) + wu <= cap then
            words rest (x + (if need then space else 0) + wu) line false false true
          // A word that does not fit starts the next line, and one wider than the whole line gets a
          // line of its own and overflows — which is what a browser does rather than cutting it.
          else words rest wu (line + 1) false false true in
    let rec walk = fn (ns: node list) -> fn (x: int) -> fn (line: int) -> fn (gap: bool) ->
                   fn (saw: bool) -> fn (placed: bool) ->
                   // `placed` is "a glyph went down", which decides whether a space is owed. `online` is
                   // "there is a line here at all", which an inline's own border makes true without
                   // placing anything and a float never does. Two questions, and one flag answering both
                   // makes either the spaces or the empty boxes wrong.
                   fn (online: bool) ->
                   // The float cursor. The hoist above already worked out how wide the floats are so the
                   // line could start after them; the boxes themselves are emitted HERE, where document
                   // order is, because a box list that is right except for its order is wrong.
                   fn (fcur: int) -> fn (acc: box list) ->
      match ns with
      | Nil -> (acc, x, line, gap, saw, fcur)
      | Cons (n, rest) ->
        match n with
        | Text t ->
          // Split on the collapsed text so an empty piece marks where a space was.
          let (x2, l2, g2, p2) = words (str_split (_collapse_runs t) " ") x line gap true placed in
          walk rest x2 l2 g2 saw p2 (online || p2) fcur acc
        | Element (tag, attrs, ks) ->
          // An element's box starts at its first GLYPH, not at the cursor. A space owed from before it
          // belongs to the text outside, so counting the cursor made every inline element four pixels
          // too early and five too wide — which reads as a rounding error and is a space.
          // ...but only when there is something before it on the line. White space at the START of a
          // line box is removed, so a space owed at x = 0 is owed to nothing: adding it there put every
          // ...and only when something has actually been PLACED on the line. A border has taken room
          // without placing anything, so `x > 0` is not the question: white space at the start of a line
          // is removed even where an ancestor's border has already advanced the cursor, and asking about
          // the cursor put every nested inline one space in from where it belongs.
          let sx = if gap && placed then x + space else x in
          let sl = line in
          // The children are walked into a FRESH accumulator so the element's own box can be placed
          // in front of them afterwards. Consing it onto the same accumulator put a nested inline
          // element after its own children in document order, which the box-sequence number sees.
          // An inline element's own padding and borders take room ON the line.
          let est = style_of ua author (_elem_of tag attrs) anc (_attr attrs "style") in
          if est.float_ == "left" || est.float_ == "right" then
            // Beside the line, not on it: it does not move the cursor, does not make the line exist, and
            // its own box goes down here so that it lands in document order.
            let fw = Font.text_units f (_collapse_ws (_inline_text ks "")) + est.bl + est.pl
                     + est.pr + est.br in
            walk rest x line gap saw placed online (fcur + fw)
              (list_append acc
                 (Cons (box { tag = to_lower tag, x = Font.scale f fcur size, y = 0,
                              w = Font.scale f fw size, h = Font.line_height f size }, Nil)))
          else
          let lead = Font.text_units_of_px f (est.bl + est.pl) size in
          let trail = Font.text_units_of_px f (est.pr + est.br) size in
          let (inner, x2u, l2, g2, saw2, fcur2) = walk ks (x + lead) line gap saw placed
                                                     (online || lead + trail > 0) fcur Nil in
          let x2 = x2u + trail in
          // The union of the element's fragments, which for one line is where it started to where it
          // ended. A box spanning two lines is reported by the browser as the whole span from the
          // first line's start to the last line's end, and that is what this gives.
          // A right-to-left line is filled from the right, so a fragment's left edge is the width less
          // where it ENDS. Mirroring the whole extent rather than each coordinate keeps the box the same
          // size it was, which is the only part of it the direction does not change.
          let bx = if rtl then cw - Font.scale f x2 size else Font.scale f sx size in
          // The WIDTH is the scaled difference, not the difference of two scaled numbers. Rounding each
          // end and subtracting rounds twice and lands a pixel out — the same "scale once" the glyph
          // advances and the table columns already needed, met a third time.
          let bw = if l2 == sl then Font.scale f (x2 - sx) size else cw - bx in
          // Relative positioning moves an inline fragment and its contents after they are laid out,
          // exactly as it does a block: the cursor, the line and everything after are unmoved.
          let rdx = if est.position == "relative" && est.left >= 0 then est.left else 0 in
          let rdy = if est.position == "relative" && est.top >= 0 then est.top else 0 in
          walk rest x2 l2 g2 (saw2 || _is_block_level est.display) (placed || x2 > sx)
               (online || lead + trail > 0 || x2 > sx) fcur2
               (list_append (_shift inner rdx rdy)
                  (Cons (box { tag = to_lower tag, x = bx + rdx, y = sl * lh - est.bt + rdy,
                               w = if bw < 0 then 0 else bw,
                               // An inline element that advanced nothing has no box worth a height:
                               // an empty `<span>` is 0 by 0, not 0 by a line. It occupies no line
                               // because it put nothing on one.
                               // ...and only when there is no LINE for it to sit on. An empty element
                               // inside others that have already taken room is on their line and is a
                               // line tall; one that starts a line nothing else reaches is nothing at
                               // all. `sx` says which: zero means the line is still empty.
                               h = if l2 == sl && x2 == sx && est.bt + est.bb == 0
                                      && not online && lead + trail == 0 then 0
                                   else (l2 - sl + 1) * lh + est.bt + est.bb }, acc)))
        | Comment _c -> walk rest x line gap saw placed online fcur acc
        | Doctype (_p, _q, _r) -> walk rest x line gap saw placed online fcur acc in
    // Floats come out of the inline content before anything is placed. A float is not on the line — it
    // is beside it — so it takes room at the line's left edge, everything else starts after it, and a run
    // holding nothing but a float makes no line at all. Hoisting them first is what lets the element that
    // contained one report a zero-width box at the line's new start, which is what the browser does.
    let rec floats = fn (ns: node list) -> fn (fx: int) -> fn (acc: box list) ->
      match ns with
      | Nil -> (fx, acc)
      | Cons (n, rest) ->
        match n with
        | Element (tag, attrs, ks) ->
          let est = style_of ua author (_elem_of tag attrs) anc (_attr attrs "style") in
          if est.float_ == "left" || est.float_ == "right" then
            let w = Font.text_units f (_collapse_ws (_inline_text ks "")) + est.bl + est.pl
                    + est.pr + est.br in
            floats rest (fx + w) acc
          else
            // A fresh accumulator, so the shift below touches only what this element contained.
            let (fx2, a2) = floats ks fx Nil in
            // A float inside a relatively positioned inline moves with it, because relative positioning
            // moves everything the element contains and a float is still contained by it.
            let rdx = if est.position == "relative" && est.left >= 0 then est.left else 0 in
            let rdy = if est.position == "relative" && est.top >= 0 then est.top else 0 in
            floats rest fx2 (list_append acc (_shift a2 rdx rdy))
        | _ -> floats rest fx acc in
    let (float_w, _fbs) = floats kids 0 Nil in
    let (bs, x, line, _g, saw, _fc) = walk kids float_w 0 false false false false 0 Nil in
    let n = if x == float_w && line == 0 then 0 else line + 1 in
    // The third answer: whether anything block-level turned up inside. Asking that as a QUERY before
    // laying out means walking every descendant of every element and resolving its style each time —
    // which is note 166's square, and here it was worse than a square and did not finish. Reporting it
    // from the walk that was happening anyway costs nothing, and the caller retries.
    (list_rev bs, n, saw);


  // How many lines this text takes at this width. Greedy, breaking at spaces, which is what the
  // standard's line breaking reduces to for text with no hyphens and no CJK — and this corpus has
  // neither. A word wider than the line gets its own line and overflows rather than being cut, which
  // is also what a browser does.
  let _line_count = fn (f: font) -> fn (text: str) -> fn (avail: int) -> fn (size: int) ->
    if text == "" then 0
    else if avail <= 0 then 1
    else
      let words = str_split text " " in
      let space = Font.text_units f " " in
      let cap = (avail * f.upem) / size in
      let rec go = fn (ws: str list) -> fn (cur: int) -> fn (lines: int) ->
        match ws with
        | Nil -> if cur > 0 then lines + 1 else (if lines == 0 then 1 else lines)
        | Cons (w, rest) ->
          let wu = Font.text_units f w in
          if cur == 0 then go rest wu lines
          else if cur + space + wu <= cap then go rest (cur + space + wu) lines
          // Measured in font units against a capacity in font units, so the comparison never rounds.
          // Comparing scaled pixels would break a line one word early or late depending on where the
          // rounding fell.
          else go rest wu (lines + 1) in
      go words 0 0;

  // How many lines a text takes in a capacity given in FONT UNITS. The pixel version rounds the
  // capacity first, which is wrong wherever the capacity was derived from the same text.
  let _lines_in_units = fn (f: font) -> fn (text: str) -> fn (cap: int) ->
    if text == "" then 0
    else if cap <= 0 then 1
    else
      let space = Font.text_units f " " in
      let rec go = fn (ws: str list) -> fn (cur: int) -> fn (lines: int) ->
        match ws with
        | Nil -> if cur > 0 then lines + 1 else (if lines == 0 then 1 else lines)
        | Cons (w, rest) ->
          let wu = Font.text_units f w in
          if cur == 0 then go rest wu lines
          else if cur + space + wu <= cap then go rest (cur + space + wu) lines
          else go rest wu (lines + 1) in
      go (str_split text " ") 0 0;

  // What `b` has that `a` does not, when `b` was built by appending to `a`.
  let rec _drop = fn (a: box list) -> fn (b: box list) ->
    match a with
    | Nil -> b
    | Cons (_x, ra) -> match b with Nil -> Nil | Cons (_y, rb) -> _drop ra rb;

  // The longest run of inline children at the head of a list, and what is left after it. One anonymous
  // block is made per run, which is what the standard says and also why the runs have to be maximal:
  // two anonymous blocks where there should be one puts a line break in the middle of a sentence.
  let rec _inline_run = fn (f: font) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                        fn (anc: elem list) -> fn (ns: node list) ->
    let rec go = fn (xs: node list) -> fn (acc: node list) ->
      match xs with
      | Nil -> (list_rev acc, Nil)
      | Cons (n, rest) ->
        match n with
        | Element (tag, attrs, _k) ->
          let st = style_of ua author (_elem_of tag attrs) anc (_attr attrs "style") in
          if st.display == "none" then go rest acc
          else if _is_block_level st.display || st.position == "absolute"
                  || st.position == "fixed" then (list_rev acc, xs)
          else go rest (Cons (n, acc))
        | Text _t -> go rest (Cons (n, acc))
        | Comment _c -> go rest acc
        | Doctype (_x, _y, _z) -> go rest acc in
    go ns Nil;

  // The children of an element split at its first block-level box: what came before, that box, and what
  // came after. The block is returned as a one-element list because this language's option needs an
  // annotation the surrounding inference will not supply here, and a list of one says the same thing.
  let _split_at_block = fn (ua: prepared list) -> fn (author: prepared list) ->
                        fn (anc: elem list) -> fn (ns: node list) ->
    let rec go = fn (xs: node list) -> fn (before: node list) ->
      match xs with
      | Nil -> (list_rev before, Nil, Nil)
      | Cons (n, rest) ->
        match n with
        | Element (tag, attrs, _k) ->
          let st = style_of ua author (_elem_of tag attrs) anc (_attr attrs "style") in
          if _is_block_level st.display then (list_rev before, Cons (n, Nil), rest)
          else go rest (Cons (n, before))
        | _ -> go rest (Cons (n, before)) in
    go ns Nil;

  // A list of siblings, stacked. `cbw` is the containing block's content width; `open_mb` is the
  // bottom margin left hanging by whatever came before. `swallow_first` says that the first
  // child's top margin belongs to the PARENT and must not become a gap here — the parent asks
  // for that when nothing separates its content edge from its border edge.
  //
  // Four things come back, and the fourth is the reason this is not a fold: the first child's
  // escaped top margin, which the parent needs to know its own.
  let rec _stack = fn (f: font) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                   fn (ancestors: elem list) -> fn (ns: node list) -> fn (cbw: int) ->
                   // The containing block's CONTENT height, or -1 when it has none that is definite. A
                   // percentage height resolves against it, and against nothing when it is indefinite —
                   // which is why this is a number that can be absent rather than a zero.
                   fn (cbh: int) ->
                   fn (y: int) -> fn (open_mb: int) -> fn (swallow_first: bool) ->
                   fn (first_mt: int) -> fn (seen: bool) -> fn (bottom: int) ->
                   // The lowest edge any float in this list reached. A float is out of flow, so it does
                   // not move the cursor — but a box that establishes a formatting context has to be
                   // tall enough to hold it, and only this number knows how tall that is.
                   // The float that is still in the way: its right edge and its bottom. A float is out
                   // of flow, so neither can be derived from the cursor — the point of a float is that
                   // the cursor did not follow it.
                   fn (fs: (int * int)) -> fn (acc: box list) ->
    match ns with
    // Five things, and `bottom` is the one that is not `y`. The cursor `y` includes the margin still
    // hanging after the last child, because that is where the next child goes. The content height is
    // measured to the last child's BORDER box, which is a different number — using one for both made a
    // parent as tall as the margin below its last child, in eighty-three documents at once.
    | Nil -> let (_fr, fbot) = fs in (list_rev acc, y, open_mb, first_mt, bottom, fbot)
    | Cons (n, rest) ->
      match n with
      | Element (tag, attrs, kids) ->
        let e = _elem_of tag attrs in
        let st = style_of ua author e ancestors (_attr attrs "style") in
        if not (_is_block_level st.display) && st.position != "absolute"
           && st.position != "fixed" then
          // An inline child of a block container: it and everything inline after it are one ANONYMOUS
          // block, laid out as a single inline formatting context. Without it the inline content
          // between two block-level children is dropped, and with it the two spans in
          // `<div><span style="display:table-cell">…</span><span>…</span></div>` land on two lines,
          // which is what the browser does.
          let (run, after) = _inline_run f ua author ancestors ns in
          let ctx_rtl = match ancestors with
                        | Nil -> false
                        | Cons (c, up) -> Style.inherited ua author "direction" "ltr" c up == "rtl" in
          let (ibs, ilines, saw) = _inline f ua author ancestors run cbw font_size ctx_rtl in
          // An inline element with a block inside it is SPLIT by the standard. This does not split it;
          // it lays that element out as a block instead, which puts the boxes in the right order at the
          // right width and is the closer of the two wrong answers.
          //
          // The RETRY is what makes it affordable. Asking "does this contain a block" before laying
          // anything out means walking every descendant of every element and resolving its style each
          // time — note 166's square, and here worse than one: it did not finish in ten minutes. The
          // walk that was happening anyway reports what it met, and only the head is redone.
          // The split itself, for the shape the corpus has: the pieces on either side of the block are
          // white space, so neither generates a box of its own and only their EDGES survive. The union
          // is then `before + block + a line + the bottom border` — the after piece's top border
          // overlaps the block, which is why it is not a plain sum. Anything with real content on
          // either side falls through to laying the element out as a block, below.
          let (spl_before, spl_blk, spl_after) = _split_at_block ua author ancestors kids in
          // The pieces no longer have to be empty. A piece with content is a line box like any other;
          // a piece with none is still a fragment when the element has an edge on that side, and is
          // nothing at all when it does not. `max(its lines, one if there is an edge)` says both.
          //
          // What they still may not contain is ANOTHER block. This splits at the first one, and an
          // element with several — `<span>…<div>Four</div><div>Five</div>…</span>` — would have its
          // remaining blocks laid out as inline content by the piece that holds them. The pieces are
          // laid out here rather than inside the branch precisely so that they can be asked: `_inline`
          // already reports whether it met a block, which is the same question in the same words.
          let piece_rtl = Style.inherited ua author "direction" "ltr" e ancestors == "rtl" in
          let (pbs, plines, ps_blk) = _inline f ua author (Cons (e, ancestors)) spl_before cbw
                                              font_size piece_rtl in
          let (abs_, alines, as_blk) = _inline f ua author (Cons (e, ancestors)) spl_after cbw
                                               font_size piece_rtl in
          let simple_split =
            saw && not ps_blk && not as_blk
            && (match spl_blk with Cons (_b, _r) -> true | Nil -> false) in
          if simple_split then
            match spl_blk with
            | Nil -> _stack f ua author ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom
                            fs acc
            | Cons (bn, _r) ->
              match bn with
              | Element (btag, battrs, bkids) ->
                let bst = style_of ua author (_elem_of btag battrs) (Cons (e, ancestors))
                            (_attr battrs "style") in
                // The block is a sibling of the inline's pieces, so it is laid out at the containing
                // block's full width with its OWN style — not the inline's.
                // The block piece's ancestors do NOT include the inline it came out of. An inline box
                // is not a containing block for a block-level box, so the direction that places this one
                // is the enclosing BLOCK's — `<div ltr><span rtl><div block>` puts the block left to
                // right, and reading the span's direction puts it ten pixels the other way.
                let (bbs, bh, bmt, bmb, _besc) =
                  _block f ua author ancestors btag battrs bkids cbw cbh bst in
                let top = y + _collapse open_mb 0 in
                let lh = Font.line_height f font_size in
                // Two heights, and they are not the same one. The element's BOX is the union of its
                // fragments and includes the bottom border of the piece after the block. The FLOW
                // advances only past the content — an inline's border hangs out below its line box and
                // does not make its parent taller, which is the same thing a float does and the reason
                // the two numbers had to be separated here as well.
                // The block piece keeps its own margins. They are not the inline's to collapse with —
                // the pieces on either side are inline boxes and a margin does not collapse through
                // one — so they simply take room, above and below.
                let bt2 = if bmt > 0 then bmt else 0 in
                let bb2 = if bmb > 0 then bmb else 0 in
                // The piece after the block is a fragment only if the element has edges of its own. With
                // none, whitespace after a block collapses to nothing and there is no box; with some,
                // the fragment is a line tall plus both borders and its TOP border overlaps the block,
                // which is why the union gains only `a line + the bottom border`.
                // Which side the element's edges are on decides where its fragments go, and the
                // direction decides which side is the START. An edge at the start makes a fragment
                // BEFORE the block; one at the end makes a fragment after. So `padding-right` is a
                // trailing fragment in a left-to-right inline and a leading one in a right-to-left one,
                // and `padding-left` is the other way about — which is three of the corpus's four
                // `block-in-inline-empty` documents disagreeing with each other until the rule is put
                // this way round rather than as "rtl swaps the order".
                let rtl2 = match ancestors with
                           | Nil -> false
                           | Cons (par, up) ->
                             Style.inherited ua author "direction" "ltr" par up == "rtl" in
                let start_edge = if rtl2 then st.br + st.pr else st.bl + st.pl in
                let end_edge = if rtl2 then st.bl + st.pl else st.br + st.pr in
                let pre_n = if plines > 0 then plines else (if start_edge > 0 then 1 else 0) in
                let post_n = if alines > 0 then alines else (if end_edge > 0 then 1 else 0) in
                let pre_h = pre_n * lh in
                let post_h = post_n * lh in
                // A fragment's border overlaps the block on the side it touches, so the union gains a
                // border only where there is a fragment to carry one.
                let uh = (if pre_h > 0 then st.bt else 0) + pre_h + bh + post_h
                         + (if post_h > 0 then st.bb else 0) in
                let adv = pre_h + bt2 + bh + bb2 + post_h in
                // The union starts at the first fragment's border box when there is one, and at the
                // BLOCK's border box when there is not — which is past the block's top margin, because
                // a margin is space around a fragment and not part of one. Generalising the pieces lost
                // that second case and put four documents ten pixels high.
                let uy = if pre_h > 0 then top - st.bt else top + bt2 in
                let by = top + pre_h + bt2 in
                // Relative positioning moves the whole split — the union box, the fragments and the
                // block piece — and leaves the flow where it was, which is what it does everywhere else.
                let sdx = if st.position == "relative" && st.left >= 0 then st.left else 0 in
                let sdy = if st.position == "relative" && st.top >= 0 then st.top else 0 in
                let me = box { tag = to_lower tag, x = sdx, y = uy + sdy, w = cbw, h = uh } in
                _stack f ua author ancestors rest cbw cbh (top + adv) 0 swallow_first
                       (if not seen then 0 else first_mt) true (top + adv) fs
                       (list_append (list_rev (list_append (_shift pbs sdx (top + sdy))
                                       (list_append (_shift bbs sdx (by + sdy))
                                          (_shift abs_ sdx (by + bh + bb2 + sdy)))))
                          (Cons (me, acc)))
              | _ -> _stack f ua author ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom
                            fs acc
          else if saw then
            // The split this replaces, measured rather than guessed. `getClientRects` shows the
            // FRAGMENTS where `getBoundingClientRect` only shows their union, and for
            // `<span border 5px, padding-right 10px><span display:block>x</span></span>` the browser
            // answers three of them:
            //
            //   8,8   0x0      the piece before — whitespace only, so it collapses to nothing
            //   8,8   784x22   THE BLOCK ITSELF, reported as a fragment of the inline
            //   8,25  10x32    the piece after — the padding-right wide, a line plus both borders tall
            //
            // The union is 8..57, which is the 784x49 the expectation records. So the shape to build is:
            // split the children into runs, lay each inline run as a line box carrying the element's
            // edges and each block at the containing block's full width, stack them, and report the
            // union as the element's box. The third fragment is exactly the box the inline path already
            // produces for an empty element with edges — that part is written and in the right place.
            //
            // The block piece of a split is a SIBLING of the inline pieces, not a child of the inline —
            // so the inline's horizontal padding and borders do not narrow it. Laying the whole element
            // out as a block keeps those edges and takes ten pixels off the block inside it, which is
            // the one part of the substitution that can be corrected without doing the split.
            let (fbs, fh, fmt2, fmb2, _fesc) =
              _block f ua author ancestors tag attrs kids cbw cbh (_no_h_edges st) in
            let top = y + _collapse open_mb fmt2 in
            // Relative positioning applies here as it does everywhere else. This branch is the one an
            // inline with SEVERAL blocks in it takes, and it had been missed while the split beside it
            // was given the offset — the same property, two branches, one of them updated.
            let sdx2 = if st.position == "relative" && st.left >= 0 then st.left else 0 in
            let sdy2 = if st.position == "relative" && st.top >= 0 then st.top else 0 in
            _stack f ua author ancestors rest cbw cbh (top + fh) fmb2 swallow_first
                   (if not seen then fmt2 else first_mt) true (top + fh) fs
                   (list_append (list_rev (_shift fbs sdx2 (top + sdy2))) acc)
          else
            let top = y + _collapse open_mb 0 in
            let h = ilines * Font.line_height f font_size in
            _stack f ua author ancestors after cbw cbh (top + h) 0 swallow_first first_mt true (top + h)
                   fs (list_append (list_rev (_shift ibs 0 top)) acc)
        else if st.display == "none" then
          _stack f ua author ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom fs acc
        // Out of flow: the box is laid out where it would have been — its static position, which is
        // what `top` and `left` of `auto` mean — and then the cursor does not move and the height does
        // not grow. `<div style="position:absolute">` inside a page made the page as tall as if it were
        // in flow, and 94 of the 116 layout failures were that one thing.
        else if st.position == "absolute" || st.position == "fixed" then
          let (fbs, _fh, _fmt, _fmb, _fesc2) = _block f ua author ancestors tag attrs kids cbw cbh st in
          // `left` and `top` are measured from the containing block, which for an absolutely positioned
          // box is the nearest POSITIONED ancestor. Here that is taken to be the parent, whose content
          // origin is where these coordinates already start from — true whenever the parent is the
          // positioned one, which is what `position: relative` on a wrapper is written for. Where they
          // say nothing the box keeps its static position, which is what `auto` means.
          let bs = _shift fbs (if st.left >= 0 then st.left else 0)
                     (if st.top >= 0 then st.top else y + _collapse open_mb 0) in
          _stack f ua author ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom fs
                 (list_append (list_rev bs) acc)
        // A float is out of flow too, but not in the same way: it is placed at the containing block's
        // left edge below whatever floats came before it, the cursor does not move past it, and the
        // parent's height ignores it unless the parent establishes a formatting context.
        //
        // Placing floats beside EACH OTHER was written once and never fired: the document it was
        // written for has one float in it. What that case wanted was the rule below — a formatting
        // context is placed beside a float rather than under it — and the guess cost a commit.
        else if st.float_ == "left" || st.float_ == "right" then
          let (fbs, fh, fmt2, fmb2, _fesc) = _block f ua author ancestors tag attrs kids cbw cbh st in
          let (_fr0, fbot) = fs in
          let top = if fbot > y then fbot else y + _collapse 0 fmt2 in
          let fw = match fbs with Nil -> 0 | Cons (b0, _r) -> b0.w + st.ml + st.mr in
          _stack f ua author ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom
                 // A formatting context contains a float's MARGIN box, not its border box: the 48px
                 // below a float is inside the box that holds it.
                 (fw, top + fh + (if fmb2 > 0 then fmb2 else 0))
                 (list_append (list_rev (_shift fbs 0 top)) acc)
        else
          // A box that establishes a formatting context does not OVERLAP a float — it is placed
          // beside it, and the width it has to work in is what is left. An ordinary block ignores the
          // float entirely and only its line boxes are shortened, which is the difference between the
          // two and the reason this asks about the child rather than about the float.
          let (fright, fbot) = fs in
          let bfc = st.position == "absolute" || st.position == "fixed"
                    || st.display == "table-cell" || st.display == "table"
                    || st.overflow != "visible" in
          let dodge = if bfc && fright > 0 && y < fbot then fright else 0 in
          let (fbs, fh, fmt, fmb, fesc) =
            _block f ua author ancestors tag attrs kids (cbw - dodge) cbh st in
          let is_first = not seen in
          // The gap above this box is the two margins collapsed into one, not their sum. When the
          // parent has claimed the first child's margin there is no gap at all here.
          let gap = if is_first && swallow_first then 0 else _collapse open_mb fmt in
          let top = y + gap in
          // `position: relative` moves the box and everything in it AFTER it has been placed, and
          // changes nothing about the flow: the cursor, the height and the next sibling are all as if
          // the offset were not there. That is the whole of what relative positioning is, and it is why
          // it can be applied here rather than anywhere in the sizing.
          let rel = st.position == "relative" in
          let bs = _shift fbs (dodge + (if rel && st.left >= 0 then st.left else 0))
                     (top + (if rel && st.top >= 0 then st.top else 0)) in
          // A box with nothing in it and no border or padding lets margins COLLAPSE THROUGH: its own
          // two margins join the run rather than ending it, so the cursor does not move past it and it
          // adds nothing to the parent's height. The box is still placed, and after the gap — which is
          // why an empty `<div>` after a paragraph sits below its parent's own bottom edge.
          let through = fh == 0 in
          // A float that escaped this child is still in this box's flow, so its reach is remembered here
          // and keeps escaping until a box contains it.
          let (fr0, fb0) = fs in
          let fs2 = if fesc > 0 && top + fesc > fb0 then (fr0, top + fesc) else fs in
          _stack f ua author ancestors rest cbw cbh
                 (if through then y else top + fh)
                 (if through then _collapse open_mb (_collapse fmt fmb) else fmb)
                 swallow_first (if is_first then fmt else first_mt) true
                 (if through then bottom else top + fh) fs2
                 (list_append (list_rev bs) acc)
      | Text t ->
        // Whitespace between two block-level children is discarded; anything else starts an anonymous
        // block, exactly as an inline element does.
        if _collapse_ws t == "" then
          _stack f ua author ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom fs acc
        else
          let (run, after) = _inline_run f ua author ancestors ns in
          let ctx_rtl = match ancestors with
                        | Nil -> false
                        | Cons (c, up) -> Style.inherited ua author "direction" "ltr" c up == "rtl" in
          let (ibs, ilines, _saw2) = _inline f ua author ancestors run cbw font_size ctx_rtl in
          let top = y + _collapse open_mb 0 in
          let h = ilines * Font.line_height f font_size in
          _stack f ua author ancestors after cbw cbh (top + h) 0 swallow_first first_mt true (top + h)
                 fs (list_append (list_rev (_shift ibs 0 top)) acc)
      | _ -> _stack f ua author ancestors rest cbw cbh y open_mb swallow_first first_mt seen bottom fs acc

  // The element children of a node, with their resolved styles. Tables ask this three times — for row
  // groups, rows and cells — and the white space between them is not a row.
  and _kids_of = fn (f: font) -> fn (ua: prepared list) -> fn (author: prepared list) ->
                 fn (anc: elem list) -> fn (ns: node list) ->
    let rec go = fn (xs: node list) -> fn (acc: (str * attr list * node list * sty) list) ->
      match xs with
      | Nil -> list_rev acc
      | Cons (n, rest) ->
        match n with
        | Element (tag, attrs, kids) ->
          let e = _elem_of tag attrs in
          let st = style_of ua author e anc (_attr attrs "style") in
          if st.display == "none" then go rest acc
          else go rest (Cons ((tag, attrs, kids, st), acc))
        | Text _t -> go rest acc
        | Comment _c -> go rest acc
        | Doctype (_x, _y, _z) -> go rest acc in
    go ns Nil

  // A table, which is its own algorithm and not a stack of blocks. Rows share their columns' widths, a
  // table shrinks to fit its content rather than filling its container, and `border-spacing` insets
  // every cell — including at the edges, which is why a table is wider than the sum of its columns.
  //
  // What is NOT here: colspan and rowspan, column groups, captions, and collapsed borders. Each would
  // change which cell owns which width, and the corpus will say when one is needed.
  and _table = fn (f: font) -> fn (ua: prepared list) -> fn (author: prepared list) ->
               fn (anc: elem list) -> fn (kids: node list) -> fn (st: sty) -> fn (avail: int) ->
    let sp = st.spacing in
    let lh = Font.line_height f font_size in
    let groups = _kids_of f ua author anc kids in
    let rows_of = fn (g: (str * attr list * node list * sty)) ->
      let (_gt, _ga, gk, _gs) = g in _kids_of f ua author anc gk in
    // A column is measured in FONT UNITS, not pixels. Rounding the width first and then asking whether
    // the text fits in it wraps a line whose text is 71.2 wide into a column of 71 — the column was
    // sized from that very text, so it has to be compared against it at the same precision.
    let cell_units = fn (c: (str * attr list * node list * sty)) ->
      let (_ct, _ca, ck, _cs) = c in
      Font.text_units f (_collapse_ws (_inline_text ck "")) in
    let extra = fn (c: (str * attr list * node list * sty)) ->
      let (_ct, _ca, _ck, cs) = c in cs.pl + cs.pr + cs.bl + cs.br in
    let rec col_widths = fn (gs: (str * attr list * node list * sty) list) -> fn (acc: int list) ->
      match gs with
      | Nil -> acc
      | Cons (g, more) ->
        let rec per_row = fn (rs: (str * attr list * node list * sty) list) -> fn (a: int list) ->
          match rs with
          | Nil -> a
          | Cons (r, rest) ->
            let (_rt, _ra, rk, _rs) = r in
            let rec merge = fn (cs: (str * attr list * node list * sty) list) ->
                            fn (old: int list) -> fn (out: int list) ->
              match cs with
              | Nil -> list_append (list_rev out) old
              | Cons (c, more2) ->
                let w = cell_units c in
                match old with
                | Nil -> merge more2 Nil (Cons (w, out))
                | Cons (o, orest) -> merge more2 orest (Cons ((if w > o then w else o), out)) in
            per_row rest (merge (_kids_of f ua author anc rk) a Nil) in
        col_widths more (per_row (rows_of g) acc) in
    let cols = col_widths groups Nil in
    let ncols = list_len cols in
    // The box widths, one per column, in pixels: the content scaled once plus what the box model adds.
    // The padding is taken from the first row's cells, which is where a table with a colgroup would
    // need something better.
    let pad0 =
      match groups with
      | Nil -> 0
      | Cons (g, _m) ->
        match rows_of g with
        | Nil -> 0
        | Cons (r, _mm) ->
          let (_rt, _ra, rk, _rs) = r in
          match _kids_of f ua author anc rk with
          | Nil -> 0
          | Cons (c, _m2) -> extra c in
    let px_cols = list_map cols (fn (u: int) -> Font.scale f u font_size + pad0) in
    let sum_cols = let rec go = fn (xs: int list) -> fn (a: int) ->
                     match xs with Nil -> a | Cons (x, r) -> go r (a + x) in
                   go px_cols 0 in
    let inner = if ncols == 0 then 0 else sum_cols + sp * (ncols + 1) in
    let table_w = if st.w >= 0 then st.w else if inner > avail then avail else inner in
    // Document order, built forwards. A table's boxes are a group, then its rows, and each row's cells
    // straight after it — an accumulator that is reversed at the end puts the cells before their row.
    let rec lay = fn (gs: (str * attr list * node list * sty) list) -> fn (y: int) ->
                  fn (acc: box list) ->
      match gs with
      | Nil -> (acc, y)
      | Cons (g, more) ->
        let (gt, _ga, _gk, _gs) = g in
        let rec lay_rows = fn (rs: (str * attr list * node list * sty) list) -> fn (ry: int) ->
                           fn (a: box list) ->
          match rs with
          | Nil -> (a, ry)
          | Cons (r, rest) ->
            let (rt, _ra, rk, _rs) = r in
            let cells = _kids_of f ua author anc rk in
            // Every cell in a row is as tall as the tallest, which is what makes a row a row.
            let rec cell_h = fn (cs: (str * attr list * node list * sty) list) -> fn (us: int list) ->
                             fn (best: int) ->
              match cs with
              | Nil -> best
              | Cons (c, more2) ->
                let (_ct, _ca, ck, cst) = c in
                let cap = match us with Nil -> 0 | Cons (u, _r) -> u in
                let txt = _collapse_ws (_inline_text ck "") in
                let n = if txt == "" then 0 else _lines_in_units f txt cap in
                let h = (if cst.h >= 0 then cst.h else n * lh) + cst.pt + cst.pb + cst.bt + cst.bb in
                cell_h more2 (match us with Nil -> Nil | Cons (_u, rr) -> rr)
                       (if h > best then h else best) in
            let rh = cell_h cells cols 0 in
            let rec place = fn (cs: (str * attr list * node list * sty) list) -> fn (ws: int list) ->
                            fn (x: int) -> fn (a2: box list) ->
              match cs with
              | Nil -> a2
              | Cons (c, more2) ->
                let (ct, _ca, _ck, _cs) = c in
                let cw2 = match ws with Nil -> 0 | Cons (w, _r) -> w in
                place more2 (match ws with Nil -> Nil | Cons (_w, rr) -> rr) (x + cw2 + sp)
                      (list_append a2
                         (Cons (box { tag = to_lower ct, x = x, y = ry, w = cw2, h = rh }, Nil))) in
            let row_box = box { tag = to_lower rt, x = sp, y = ry, w = sum_cols, h = rh } in
            lay_rows rest (ry + rh + sp)
                     (place cells px_cols sp (list_append a (Cons (row_box, Nil)))) in
        let gy = y + sp in
        let (a2, gy2) = lay_rows (rows_of g) gy acc in
        // The group's own box is placed before its rows, so it is spliced in rather than appended: its
        // height is not known until the rows are laid out, and document order does not wait for that.
        let gbox = box { tag = to_lower gt, x = sp, y = gy, w = sum_cols, h = gy2 - sp - gy } in
        lay more (gy2 - sp)
            (list_append acc (Cons (gbox, _drop acc a2))) in
    let (bs, endy) = lay groups 0 Nil in
    // The last row already left a spacing behind it, so one more closes the table and two would count
    // the gap after the final row twice.
    (bs, table_w, endy + sp)

  // One block box and everything under it, at coordinates relative to its own border box.
  and _block = fn (f: font) -> fn (ua: prepared list) -> fn (author: prepared list) ->
               fn (ancestors: elem list) -> fn (tag: str) -> fn (attrs: attr list) ->
               fn (kids: node list) -> fn (cbw: int) -> fn (cbh: int) -> fn (st: sty) ->
    // A block box fills its containing block unless it says otherwise. `width` is the CONTENT
    // width, so the border box is wider by its own borders and padding — that difference is what
    // `getBoundingClientRect` reports and the place a box model is usually wrong.
    let pct = if st.w_pct >= 0 then (cbw * st.w_pct) / 100 else 0 - 1 in
    let content_w =
      if pct >= 0 then pct
      else if st.w >= 0 then st.w
      else cbw - st.ml - st.mr - st.bl - st.br - st.pl - st.pr in
    let cw0 = if content_w < 0 then 0 else content_w in
    let e = _elem_of tag attrs in
    let inner_ancestors = Cons (e, ancestors) in
    // A table's width is decided by its own contents rather than handed down from the containing block,
    // so the table is laid out before the box is sized and not after.
    let is_table = st.display == "table" in
    let (tbs, tw, th) = if is_table then _table f ua author inner_ancestors kids st cw0
                        else (Nil, 0, 0) in
    let cw = if is_table then tw else cw0 in
    // A parent's margin collapses with its first or last child's when nothing separates them —
    // no border and no padding on that side, and for the bottom, no stated height either. When
    // something does separate them the child's margin stays inside.
    // The root element is the third reason a margin does not collapse, and it is not a property
    // of the box: the standard says the root's margins simply do not collapse with anything. With
    // it missing, the body's margin escaped out of `<html>` and pushed the document itself down.
    let is_root = match ancestors with Nil -> true | Cons (_x, _y) -> false in
    // A box that establishes a block formatting context has to contain its floats. Being positioned,
    // floated, a table cell or anything but `overflow: visible` does it — and an ordinary block does
    // not, which is why a float can hang out of the bottom of its parent.
    let makes_bfc = st.position == "absolute" || st.position == "fixed" || st.float_ != "none"
                    || st.display == "table-cell" || st.display == "table"
                    || st.overflow != "visible" in
    // A formatting context is the fourth reason a margin does not collapse, and the one that reads as a
    // painting property: `html, body { overflow: scroll }` stops a paragraph's top margin collapsing
    // with the body's, which moves every box in the document down by the difference.
    let sep_top = is_root || makes_bfc || st.bt > 0 || st.pt > 0 in
    let sep_bot = is_root || makes_bfc || st.bb > 0 || st.pb > 0 || st.h >= 0
                  || (st.h_pct >= 0 && cbh >= 0) in
    // Inline content, if there is any, instead of a stack of blocks. A box whose children are text
    // establishes an inline formatting context, and its height is a count of LINES rather than a sum of
    // children. Mixing inline and block children in one parent needs the anonymous block boxes the
    // standard describes; that is not here, and a box with both is laid out as if it were all inline —
    // wrong for the mixture and right for everything this corpus has.
    // Whether any child is block-level. This is the question that decides which of the two formatting
    // contexts this box has, and it has to be asked before the text is looked at: `<html>` has
    // whitespace text nodes between `<head>` and `<body>`, so "does it contain text" answers yes for
    // every element in the document and laid the whole page out as one paragraph.
    let rec has_block = fn (xs: node list) ->
      match xs with
      | Nil -> false
      | Cons (k, more) ->
        match k with
        | Element (ktag, kattrs, _kk) ->
          let ke = _elem_of ktag kattrs in
          let kst = style_of ua author ke inner_ancestors (_attr kattrs "style") in
          // Block-LEVEL, which is not the same as `display: block`. A `display: table-cell` with no
          // table around it is wrapped by the standard in an anonymous table, row group and row, and
          // the result sits in its parent's flow as a block does: it takes a line of its own.
          if _is_block_level kst.display then true else has_block more
        | Text _t -> has_block more
        | Comment _c -> has_block more
        | Doctype (_x, _y, _z) -> has_block more in
    // A block-level child means the white space around it is discarded, which is what the standard's
    // anonymous block boxes come to for whitespace-only inline content.
    let inline_only = not is_table && not (has_block kids)
                      && _collapse_ws (_inline_text kids "") != "" in
    let (ibs, ilines, _sawb) =
      if inline_only then
        _inline f ua author inner_ancestors kids cw font_size
          (Style.inherited ua author "direction" "ltr" e ancestors == "rtl")
      else (Nil, 0, false) in
    let (bs, used, open_mb, first_mt, bottom, fbot) =
      if is_table then (tbs, th, 0, 0, th, 0)
      // A block met inside what looked like inline content means it was not inline content. The flag
      // comes back from the walk rather than being asked for beforehand, and here it is the difference
      // between laying a document out as one paragraph and laying it out at all.
      else if inline_only && not _sawb then
        let h = ilines * Font.line_height f font_size in (ibs, h, 0, 0, h, 0)
      else _stack f ua author inner_ancestors kids cw (if st.h >= 0 then st.h else 0 - 1) 0 0 (not sep_top) 0 false 0 (0, 0) Nil in
    // The fragment's origin is (the containing block's content left, this border box's top): x is
    // measured from outside the margin because a horizontal margin is an offset, y from the border
    // box because a vertical one collapsed into the gap above. So a child clears this box's own
    // left margin as well as its border and padding — leaving `st.ml` out put every nested box at
    // the wrong x and only the outermost one right.
    let bw_total = st.bl + st.pl + cw + st.pr + st.br in
    // The CONTAINING BLOCK's direction, not this box's own. `direction` lays out what is inside a box;
    // a `<div direction: rtl>` is still placed from the left of an ordinary body, and only its children
    // are placed from the right. Reading it off the element itself moved the div to x = 690.
    let rtl = match ancestors with
              | Nil -> false
              | Cons (par, up) -> Style.inherited ua author "direction" "ltr" par up == "rtl" in
    let bx0 = if rtl then cbw - st.mr - bw_total else st.ml in
    // The children clear the same edge the box was placed from, which in a right-to-left containing
    // block is not the left margin. Using `st.ml` here while the box itself was placed from the right
    // put every child of an RTL box at the wrong x and only the box right.
    let inner = _shift bs (bx0 + st.bl + st.pl) (st.bt + st.pt) in
    // The margin still hanging at the end is inside this box only if something separates it from
    // the bottom edge; otherwise it escapes and is the parent's to place.
    // To the last child's border box, and then the trailing margin only when something separates it
    // from this box's bottom edge. `used` is the cursor and is one margin too far.
    let in_flow_h = if sep_bot then bottom + (if open_mb > 0 then open_mb else 0) else bottom in
    let pct_h = if st.h_pct >= 0 && cbh >= 0 then (cbh * st.h_pct) / 100 else 0 - 1 in
    let content_h = if pct_h >= 0 then pct_h
                    else if st.h >= 0 then st.h
                    else if (makes_bfc || is_root) && fbot > in_flow_h then fbot
                    else in_flow_h in
    let h = st.bt + st.pt + content_h + st.pb + st.bb in
    // In a right-to-left containing block a box is placed from the RIGHT edge, so its offset is what is
    // left after its own width and its right margin — the same margin read from the other end. With this
    // missing, a block with `margin: 10px` in a 100px RTL container sat at 10 where the browser puts it
    // at 0.
    let me = box { tag = to_lower tag, x = bx0, y = 0, w = bw_total, h = h } in
    // A fifth answer: how far a float inside this box reached, when this box does NOT contain floats.
    // The float escapes upward until something does contain it — and the initial containing block always
    // does, which is why a page is as tall as a float that overflowed every box on the way out.
    (Cons (me, inner), h,
     (if sep_top then st.mt else _collapse st.mt first_mt),
     (if sep_bot then st.mb else _collapse st.mb open_mb),
     (if makes_bfc then 0 else fbot + st.bt + st.pt));

  // The font is a parameter and not a constant, because it is the one input to layout that is a file.
  // Loaded once per document: reading it per box would read half a megabyte for every element.
  let boxes = fn (font_path: str) -> fn (roots: node list) ->
    let f = Font.load font_path in
    let ua = Style.prepare Style.ua_sheet in
    let author = Style.prepare (author_css roots "") in
    // The initial containing block is the viewport. Its own margin does not collapse out of the
    // document, so the root's top margin starts the stack rather than escaping it.
    let (bs, _y, _mb, _fm, _bot, _fb) =
      _stack f ua author Nil roots viewport_w (0 - 1) 0 0 false 0 false 0 (0, 0) Nil in
    bs;

  // The canonical form the gate compares, one line per box in document order.
  let render = fn (bs: box list) ->
    let one = fn (b: box) ->
      b.tag ++ "\t" ++ str_of_int b.x ++ "\t" ++ str_of_int b.y
      ++ "\t" ++ str_of_int b.w ++ "\t" ++ str_of_int b.h in
    str_join "\n" (list_map bs one);
}
