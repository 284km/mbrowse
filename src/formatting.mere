// The list of active formatting elements.
//
// The other half of what the adoption agency needs, and the half that is a data
// structure rather than an algorithm. It exists because of one fact about how people
// write HTML: `<b>` can be left open across a block boundary, and the standard's
// answer is not to guess but to remember which formatting elements were open and
// reopen them on the other side.
//
// Newest first, because every operation the standard defines on it either looks at
// the newest end or walks back from it.
//
// A marker is pushed when an element is entered that formatting must not escape — a
// table cell, a caption, an object — and "clear up to the last marker" is how leaving
// one forgets what was inside it. Without markers, a `<b>` inside a cell would be
// reopened outside the table.

import "nodes.mere";

type afe =
  | AMarker
  | AElem of (int * str * attr list);

module Formatting {
  let _same = fn (a: attr list) -> fn (b: attr list) ->
    // Order matters here, which is what the standard says: two elements count as
    // identical when their attributes match, and it does not sort them.
    let rec go = fn (xs: attr list) -> fn (ys: attr list) ->
      match (xs, ys) with
      | (Nil, Nil) -> true
      | (Cons (x, xr), Cons (y, yr)) ->
        if x.name == y.name && x.value == y.value then go xr yr else false
      | _ -> false in
    go a b;

  // Noah's Ark: at most three entries for the same element may be in the list at
  // once, counting only back to the last marker. The fourth pushes the earliest out.
  // Three rather than one because `<b><b><b>` is a real thing people write and the
  // tree is supposed to reflect it — and rather than unbounded because a page that
  // opens ten thousand of them should not cost ten thousand reopenings.
  let _ark = fn (list: afe list) -> fn (name: str) -> fn (attrs: attr list) ->
    let rec scan = fn (xs: afe list) -> fn (seen: int) -> fn (out: afe list) ->
      match xs with
      | Nil -> list_rev out
      | Cons (AMarker, rest) -> list_append (list_rev out) (Cons (AMarker, rest))
      | Cons (AElem (id, n, a), rest) ->
        if n == name && _same a attrs then
          if seen >= 2 then
            // This is the fourth: drop it and keep the rest as they are.
            list_append (list_rev out) rest
          else scan rest (seen + 1) (Cons (AElem (id, n, a), out))
        else scan rest seen (Cons (AElem (id, n, a), out)) in
    scan list 0 Nil;

  let push = fn (list: afe list) -> fn (id: int) -> fn (name: str) ->
             fn (attrs: attr list) ->
    Cons (AElem (id, name, attrs), _ark list name attrs);

  let push_marker = fn (list: afe list) -> Cons (AMarker, list);

  let rec clear_to_marker = fn (list: afe list) ->
    match list with
    | Nil -> Nil
    | Cons (AMarker, rest) -> rest
    | Cons (_, rest) -> clear_to_marker rest;

  // "The last element with this tag name between the end of the list and the last
  // marker" — the entry the adoption agency starts from. Newest first, so the first
  // match walking forward is the last one in the standard's ordering.
  let rec find = fn (list: afe list) -> fn (name: str) ->
    match list with
    | Nil -> 0 - 1
    | Cons (AMarker, _) -> 0 - 1
    | Cons (AElem (id, n, _), rest) -> if n == name then id else find rest name;

  let rec remove = fn (list: afe list) -> fn (id: int) ->
    match list with
    | Nil -> Nil
    | Cons (AElem (i, n, a), rest) ->
      if i == id then rest else Cons (AElem (i, n, a), remove rest id)
    | Cons (AMarker, rest) -> Cons (AMarker, remove rest id);

  // Replace an entry where it is. `push` puts the new one at the newest end, and the order
  // of this list IS the nesting order of the document — moving an entry changes what
  // reconstruction rebuilds and the order it rebuilds it in.
  let rec replace = fn (list: afe list) -> fn (old_id: int) -> fn (id: int) ->
                    fn (name: str) -> fn (attrs: attr list) ->
    match list with
    | Nil -> Nil
    | Cons (AElem (i, n, a), rest) ->
      if i == old_id then Cons (AElem (id, name, attrs), rest)
      else Cons (AElem (i, n, a), replace rest old_id id name attrs)
    | Cons (AMarker, rest) -> Cons (AMarker, replace rest old_id id name attrs);

  // Where an entry is, counting markers. The adoption agency needs a position rather than
  // an id: its bookmark outlives the entry it was taken from.
  let index_of = fn (list: afe list) -> fn (id: int) ->
    let rec go = fn (l: afe list) -> fn (i: int) ->
      match l with
      | Nil -> 0 - 1
      | Cons (AElem (x, _n, _a), rest) -> if x == id then i else go rest (i + 1)
      | Cons (AMarker, rest) -> go rest (i + 1) in
    go list 0;

  // Insert at a position. This list is newest-first, so the standard's "immediately after
  // node" — its list runs oldest to newest — is immediately BEFORE node here, which is what
  // inserting at node's own index does.
  let insert_at = fn (list: afe list) -> fn (idx: int) -> fn (id: int) ->
                  fn (name: str) -> fn (attrs: attr list) ->
    let rec go = fn (l: afe list) -> fn (i: int) ->
      if i >= idx then Cons (AElem (id, name, attrs), l)
      else
        match l with
        | Nil -> Cons (AElem (id, name, attrs), Nil)
        | Cons (x, rest) -> Cons (x, go rest (i + 1)) in
    go list 0;

  let rec has = fn (list: afe list) -> fn (id: int) ->
    match list with
    | Nil -> false
    | Cons (AElem (i, _, _), rest) -> if i == id then true else has rest id
    | Cons (AMarker, rest) -> has rest id;

  // Oldest first, for the reopening pass: the standard reconstructs from the entry
  // after the last marker forward, so that nesting comes out in the original order.
  let entries_after_marker = fn (list: afe list) ->
    let rec go = fn (xs: afe list) -> fn (out: (int * str * attr list) list) ->
      match xs with
      | Nil -> out
      | Cons (AMarker, _) -> out
      | Cons (AElem (id, n, a), rest) -> go rest (Cons ((id, n, a), out)) in
    go list Nil;
}

// Reconstructing the active formatting elements.
//
// The operation that makes the list worth keeping: before inserting anything into a
// new block, any formatting element that is still in the list but no longer open gets
// reopened, innermost last, so `<b><p>X` puts a `<b>` inside the paragraph. The
// standard calls this from "insert an HTML element", which is why it is here as a
// function over the three structures rather than inside the builder.
//
// `open_ids` is the stack of open elements, newest first. The reopened element takes
// the place of its entry in the list — the entry is the *element*, and after this it
// is a different one.
module Reconstruct {
  let rec _in_open = fn (open_ids: int list) -> fn (id: int) ->
    match open_ids with
    | Nil -> false
    | Cons (x, rest) -> if x == id then true else _in_open rest id;

  // Nothing to do when the list is empty, or when its newest entry is a marker or is
  // already open: those are the standard's three early exits, and together they are
  // why this costs nothing on an ordinary document.
  let needed = fn (list: afe list) -> fn (open_ids: int list) ->
    match list with
    | Nil -> false
    | Cons (AMarker, _) -> false
    | Cons (AElem (id, _, _), _) -> not (_in_open open_ids id);

  // Reopen, oldest first, under `parent`. Each reopened element becomes the parent of
  // the next, which is what "innermost last" means and what a flat loop would get
  // backwards.
  // `foster` is the table to reopen IN FRONT OF, or -1. Reconstruction inside a table is fostered
  // like everything else there: the reopened elements belong before the table, not inside it. Only
  // the OUTERMOST one is placed that way — the rest nest inside it, which is what reconstruction is.
  let run = fn (arena: anode list) -> fn (open_ids: int list) ->
            fn (list: afe list) -> fn (parent: int) -> fn (foster: int) ->
    if not (needed list open_ids) then (arena, open_ids, list, parent)
    else
      let rec go = fn (todo: (int * str * attr list) list) ->
                   fn (a: anode list) -> fn (o: int list) ->
                   fn (l: afe list) -> fn (p: int) -> fn (first: bool) ->
        match todo with
        | Nil -> (a, o, l, p)
        | Cons ((old_id, name, attrs), rest) ->
          if _in_open o old_id then go rest a o l p first
          else
            let (a2, new_id) =
              if first && foster >= 0 then Nodes.insert_before a foster 0 name attrs ""
              else Nodes.element a p name attrs in
            // The entry now names the new element: the old one is finished and
            // nothing may reopen it a second time.
            let l2 = Formatting.push (Formatting.remove l old_id) new_id name attrs in
            go rest a2 (Cons (new_id, o)) l2 new_id false in
      go (Formatting.entries_after_marker list) arena open_ids list parent true;
}
