// One line per glyph, in the canonical form the two generators write.
//
// The input is a list of CODE POINTS and not glyph ids: the id is what `cmap` answers, so asking by
// character checks the two readers agree about which glyph they are talking about before they compare
// what is in it. A pair of readers that disagree about the id would otherwise both be "right" about
// two different glyphs.
//
// The second argument chooses which form to print — the raw stored points, the segments they become,
// or which pixel centres those segments enclose. One runner, because the corpus of glyphs is the same
// and only the question asked of each differs. The raster grid's four numbers are here and in
// `gen_raster_expected.py`, and they have to agree: they are what makes the two sides raster the same
// window rather than two different pictures of the same glyph.
import "../src/font.mere";

let path = match args () with Cons (p, _) -> p | Nil -> "";
let mode = match args () with Cons (_p, Cons (m, _)) -> m | _ -> "points";
let f = Font.load "test/data/font/NotoSans-Regular.ttf";

let rec go = fn (ls: str list) ->
  match ls with
  | Nil -> 0
  | Cons (l, rest) ->
    if l == "" then go rest
    else
      let g = Font.glyph f (int_of_str l) in
      let _ = print (if mode == "segments" then Font.segments_str f g
                     else if mode == "raster" then Font.raster_str f g 24 30 32 6
                     else Font.outline_str f g) in
      go rest;

go (read_lines path)
