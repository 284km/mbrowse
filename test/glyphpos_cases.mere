// Where each CHARACTER was put: one line per glyph, in document order.
//
// The same list the box gate reads, asked the other question. Layout computed these positions on
// every line it laid out and had no way to say them; a painter cannot start without them.
import "../src/sniff.mere";
import "../src/layout.mere";
import "../src/tree.mere";

let path = match args () with Cons (p, _) -> p | Nil -> "";
// The document's bytes, sniffed and decoded — not `read_lines`, which drops the trailing
// newlines a browser sees and never runs the encoding half at all. Measured before changing:
// 154 of the 228 documents here differ between the two readings, all of them by one to three
// trailing newlines, and no file in the corpus contains a CR so nothing else can differ.
let src = Sniff.text_of_file path;
let _ = print (Layout.render_glyphs
                 (Layout.boxes "test/data/font/NotoSans-Regular.ttf" (Tree.build (Html.tokenize src))));
0
