// Tree construction, on the behaviours that are the reason it has insertion modes
// at all. Every case here is a document that leaves something out or gets
// something wrong, because a document that does neither would be checking the
// tokenizer.
//
// html5lib-tests **has no tree-construction suite** — its directories are `encoding`,
// `lint_lib`, `serializer` and `tokenizer`. The data every parser used to be measured
// against is not in that repository, which is worth writing down because looking for
// it there is the obvious first move and it fails quietly with a 404 that reads like
// a wrong path. These are hand-written until a normative suite is found, and that is
// the weaker kind of evidence: they are the cases we thought of.

import "../src/tree.mere";

let pass = fn (b: bool) -> if b then "ok" else "MISMATCH";

let check = fn (label: str) -> fn (src: str) -> fn (want: str) ->
  let got = Dom.serialize (Tree.build (Html.tokenize src)) in
  print (label ++ ": " ++ pass (got == want)
         ++ (if got == want then "" else "\n--- got ---\n" ++ got
                                        ++ "\n--- want ---\n" ++ want));

// Nobody wrote html, head or body. All three are in the tree.
let _ = check "implied elements" "<p>hi"
  "<html>\n  <head>\n  <body>\n    <p>\n      \"hi\"";

// A paragraph is closed by the next one, so these are siblings and not nested.
let _ = check "p closes p" "<p>a<p>b"
  "<html>\n  <head>\n  <body>\n    <p>\n      \"a\"\n    <p>\n      \"b\"";

// An end tag with nothing open to match is ignored rather than fatal.
// ...and the text on either side of it is one node, not two: the end tag produced
// nothing, so nothing separates them. This expectation was wrong until the corpus
// disagreed with it.
let _ = check "stray end tag" "<p>a</div>b"
  "<html>\n  <head>\n  <body>\n    <p>\n      \"ab\"";

// A void element takes no children even when the source implies some.
let _ = check "void element" "<p>a<br>b"
  "<html>\n  <head>\n  <body>\n    <p>\n      \"a\"\n      <br>\n      \"b\"";

// Attributes survive, and so does the doctype's name.
let _ = check "doctype and attributes" "<!DOCTYPE html><div id=x>y</div>"
  "<!DOCTYPE html>\n<html>\n  <head>\n  <body>\n    <div>\n      id=\"x\"\n      \"y\"";

// Whitespace before the body is dropped; whitespace inside it is not.
let _ = check "leading whitespace" "  <p>a b"
  "<html>\n  <head>\n  <body>\n    <p>\n      \"a b\"";

// head content goes in the head, and the first thing that cannot opens the body.
let _ = check "head then body" "<head><meta charset=utf-8></head><p>x"
  "<html>\n  <head>\n    <meta>\n      charset=\"utf-8\"\n  <body>\n    <p>\n      \"x\"";

// NOT here, and it is the finding of this slice: `<title>t</title>`.
//
// A title's content is RCDATA, and **which state the tokenizer is in is decided by
// the tree builder** — it is the element being opened that says so. So the two are
// not two passes over the document: `Tree.build : token list -> node list` cannot
// express it, because by the time it sees the tokens the choice has been made.
//
// The standard has them as one loop for exactly this reason. Changing the shape to
// match is the next piece of work, and it is a change to the signature rather than
// to any of the rules above.
// The half of the tokenizer/tree loop the builder owns. `Tree.build` cannot use it
// yet — it takes a token list, and by then the choice has been made — but the
// answer is a fact about elements and belongs here either way, so it is written and
// checked before the restructure that consumes it.
let st = fn (name: str) -> fn (want: str) ->
  print ("content_state " ++ name ++ ": " ++ pass (Tree.content_state name == want));
let _ = st "title" "RCDATA state";
let _ = st "textarea" "RCDATA state";
let _ = st "style" "RAWTEXT state";
let _ = st "script" "Script data state";
let _ = st "plaintext" "PLAINTEXT state";
let _ = st "p" "Data state";
let _ = st "div" "Data state";
// Elements that close a same-kind open element rather than nesting inside it.
let _ = check "heading closes heading" "<h1>a<h2>b"
  "<html>\n  <head>\n  <body>\n    <h1>\n      \"a\"\n    <h2>\n      \"b\"";
let _ = check "li closes li" "<li>a<li>b"
  "<html>\n  <head>\n  <body>\n    <li>\n      \"a\"\n    <li>\n      \"b\"";
// ...and across a div too, which is the opposite of what this check said until the
// corpus was asked. The walk that looks for the li to close skips address, div and p —
// they are the three tags it passes through, not three of the tags that stop it. This
// check agreeing with the code was worth nothing: they were wrong together.
let _ = check "li closes li across a div" "<li><div><li>"
  "<html>\n  <head>\n  <body>\n    <li>\n      <div>\n    <li>";
// An option closes an option; an optgroup closes an option and then an optgroup.
let _ = check "an option closes an option" "<select><option>a<option>b"
  "<html>\n  <head>\n  <body>\n    <select>\n      <option>\n        \"a\"\n      <option>\n        \"b\"";
let _ = check "an optgroup closes an option and an optgroup" "<select><optgroup><option><optgroup>"
  "<html>\n  <head>\n  <body>\n    <select>\n      <optgroup>\n        <option>\n      <optgroup>";
// A second select closes the first instead of nesting, and consumes itself doing it.
let _ = check "a select closes a select" "<select><option><select><option>"
  "<html>\n  <head>\n  <body>\n    <select>\n      <option>\n    <option>";
// The newline after `<pre>` is not content, so these two are the same tree.
let _ = check "a newline right after pre is dropped" "<pre>\nfoo</pre>"
  "<html>\n  <head>\n  <body>\n    <pre>\n      \"foo\"";
let _ = check "and only the first one" "<pre>\n\nfoo</pre>"
  "<html>\n  <head>\n  <body>\n    <pre>\n      \"\nfoo\"";
// A repeated html or body tag is not a second element.
let _ = check "a second body merges its attributes" "<body a=1><body b=2>"
  "<html>\n  <head>\n  <body>\n    a=\"1\"\n    b=\"2\"";
let _ = check "and does not overwrite one it has" "<body a=1><body a=2>"
  "<html>\n  <head>\n  <body>\n    a=\"1\"";
let _ = check "image is img" "<image>"
  "<html>\n  <head>\n  <body>\n    <img>";
// A heading is the other rule and closes only the current node, so the div does stop it.
let _ = check "a heading does not close across a div" "<h1><div><h2>"
  "<html>\n  <head>\n  <body>\n    <h1>\n      <div>\n        <h2>";
// A table's structure is mostly elements nobody writes.
let _ = check "a table gets its tbody and row" "<table><td>x"
  "<html>\n  <head>\n  <body>\n    <table>\n      <tbody>\n        <tr>\n          <td>\n            \"x\"";
let _ = check "a written tbody is not doubled" "<table><tbody><tr><td>x"
  "<html>\n  <head>\n  <body>\n    <table>\n      <tbody>\n        <tr>\n          <td>\n            \"x\"";
// A cell is a boundary: the inner table is its own, and needs its own row.
let _ = check "a table inside a cell is a different table" "<table><td><table><td>y"
  "<html>\n  <head>\n  <body>\n    <table>\n      <tbody>\n        <tr>\n          <td>\n            <table>\n              <tbody>\n                <tr>\n                  <td>\n                    \"y\"";
// </table> has to close through whatever is still open inside it. Without that the
// table stays open and everything after it lands in the last cell.
let _ = check "the table closes through its cell" "<table><td>x</table>y"
  "<html>\n  <head>\n  <body>\n    <table>\n      <tbody>\n        <tr>\n          <td>\n            \"x\"\n    \"y\"";
let _ = check "and a row closes through its cell" "<table><tr><td>x</tr><tr><td>y"
  "<html>\n  <head>\n  <body>\n    <table>\n      <tbody>\n        <tr>\n          <td>\n            \"x\"\n        <tr>\n          <td>\n            \"y\"";
// Content a table cannot hold goes before the table, not inside it — and neither the
// content nor the table is lost, which is the whole point.
let _ = check "text is fostered out of a table" "<table>x<td>y"
  "<html>\n  <head>\n  <body>\n    \"x\"\n    <table>\n      <tbody>\n        <tr>\n          <td>\n            \"y\"";
let _ = check "and so is an element" "<table><b>x</b><td>y"
  "<html>\n  <head>\n  <body>\n    <b>\n      \"x\"\n    <table>\n      <tbody>\n        <tr>\n          <td>\n            \"y\"";
// --- foreign content --------------------------------------------------------
// Inside SVG the rules are the foreign ones, and the suite writes the namespace into
// the name.
let _ = check "svg children are in the svg namespace" "<svg><path>"
  "<html>\n  <head>\n  <body>\n    <svg svg>\n      <svg path>";
// SVG's names are case-sensitive; the tokenizer lower-cased them.
let _ = check "camelCase names are put back" "<svg><foreignObject>"
  "<html>\n  <head>\n  <body>\n    <svg svg>\n      <svg foreignObject>";
// A tag on the breakout list means the author is back in HTML, so the svg closes.
let _ = check "a breakout tag leaves the namespace" "<svg><path><p>x"
  "<html>\n  <head>\n  <body>\n    <svg svg>\n      <svg path>\n    <p>\n      \"x\"";
// An end tag inside SVG matches on the local name.
let _ = check "an end tag matches the local name" "<svg><path></path><circle>"
  "<html>\n  <head>\n  <body>\n    <svg svg>\n      <svg path>\n      <svg circle>";
let _ = check "and math works the same way" "<math><mi>x"
  "<html>\n  <head>\n  <body>\n    <math math>\n      <math mi>\n        \"x\"";
// --- fragment parsing -------------------------------------------------------
let frag = fn (label: str) -> fn (ctx: str) -> fn (src: str) -> fn (want: str) ->
  let got = Dom.serialize (Tree.build_fragment ctx (Html.tokenize src)) in
  print (label ++ ": " ++ (if got == want then "ok"
    else "MISMATCH\n--- got ---\n" ++ got ++ "\n--- want ---\n" ++ want));

// The result is the context's children, with no html, head or body around them.
let _ = frag "a fragment has no document around it" "div" "<p>x"
  "<p>\n  \"x\"";
let _ = frag "text alone" "div" "hi" "\"hi\"";
let _ = frag "several children" "div" "<p>a<p>b"
  "<p>\n  \"a\"\n<p>\n  \"b\"";
// KNOWN LIMITATION, pinned rather than hidden. The context element is really in the
// tree here, so content that would *close* it loses it: `<div>` closes an open `<p>`,
// the synthetic context goes with it, and its children are nowhere. The standard's
// algorithm does not put the context in the tree at all — it only reads the mode off
// it — so fixing this means letting the builder start with a stack rather than with a
// token, which is the next change and not a rule.
let _ = frag "a context the content closes loses it (limitation)" "p" "<div>x" "";
0
