// Runs the CSS tokenizer over a file of escaped inputs, one per line.
import "../src/css_rules.mere";

let unescape = fn (s: str) ->
  let hex = fn (c: str) ->
    if c >= "0" && c <= "9" then ord c - 48
    else if c >= "a" && c <= "f" then ord c - 87
    else if c >= "A" && c <= "F" then ord c - 55 else 0 in
  let rec go = fn (i: int) -> fn (out: str) ->
    if i >= str_len s then out
    else
      let c = char_at s i in
      if c != "\\" || i + 1 >= str_len s then go (i + 1) (out ++ c)
      else
        let d = char_at s (i + 1) in
        if d == "\\" then go (i + 2) (out ++ "\\")
        else if d == "t" then go (i + 2) (out ++ "\t")
        else if d == "n" then go (i + 2) (out ++ "\n")
        else if d == "r" then go (i + 2) (out ++ "\r")
        else if d == "x" && i + 3 < str_len s then
          go (i + 4) (out ++ chr (hex (char_at s (i + 2)) * 16 + hex (char_at s (i + 3))))
        else go (i + 2) (out ++ d) in
  go 0 "";

// Which level to run is an argument, because the suite has five of them over the same
// tokenizer and five near-identical runners would be five places to fix a rendering.
let render_one = fn (level: str) -> fn (src: str) ->
  if level == "component" then Css.render (Css.values src)
  else if level == "one-declaration" then Rules.render (Rules.one_declaration src)
  else if level == "declaration-list" then Rules.render (Rules.declaration_list src)
  else if level == "one-rule" then Rules.render (Rules.one_rule src)
  else if level == "rule-list" then Rules.render (Rules.rule_list src)
  else Rules.render (Rules.stylesheet src);

let rec run = fn (level: str) -> fn (xs: str list) -> fn (i: int) ->
  match xs with
  | Nil -> ()
  | Cons (line, rest) ->
    let _ = print ("##" ++ show i) in
    let _ = print (render_one level (unescape line)) in
    run level rest (i + 1);

let (path, level) =
  match args () with
  | Cons (p, Cons (l, _)) -> (p, l)
  | Cons (p, Nil) -> (p, "component")
  | Nil -> ("cases.txt", "component");
let _ = run level (read_lines path) 0;
0
