// One page, painted, as run-length rows.
import "../src/sniff.mere";
import "../src/paint.mere";
import "../src/tree.mere";

let path = match args () with Cons (p, _) -> p | Nil -> "";
// The document's bytes, sniffed and decoded — not `read_lines`, which drops the trailing
// newlines a browser sees and never runs the encoding half at all. Measured before changing:
// 154 of the 228 documents here differ between the two readings, all of them by one to three
// trailing newlines, and no file in the corpus contains a CR so nothing else can differ.
let src = Sniff.text_of_file path;
let f = Font.load "test/data/font/NotoSans-Regular.ttf";
// The document's own directory, because a relative `src` is relative to the document.
let dir =
  let ps = str_split path "/" in
  if list_len ps <= 1 then "" else str_join "/" (list_take ps (list_len ps - 1));
let bs = Layout.boxes_in dir "test/data/font/NotoSans-Regular.ttf" (Tree.build (Html.tokenize src));
// The page is as tall as the root box and as wide as the viewport.
//
// A fixed viewport height was tried instead, for the reftests, and reverted: painting 600 rows where
// the page is 97 is six times the work and put a single document over a five-minute CPU limit. The
// reftest harness pads the shorter of two row lists with white instead, which is the same comparison
// and costs nothing.
// A second argument overrides it, and the reftests use that. Padding the shorter row list with white
// instead is NOT equivalent: an inline box taller than its line hangs BELOW the root box, so a page
// painted at its own root height has already thrown that ink away. One pair differs by exactly that —
// root heights 32 and 38 with the ink reaching 34.
let h =
  match args () with
  | Cons (_p, Cons (hs, _)) -> (let n = int_of_str hs in if n < 1 then 1 else n)
  | _ -> match bs with Cons (b, _) -> (if b.h < 1 then 1 else b.h) | Nil -> 1;
let _ = print (Paint.render (Paint.paint f bs 800 h) 800 h);
0
